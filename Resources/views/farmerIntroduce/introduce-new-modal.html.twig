<div class="portlet box ">
    <div class="portlet-title">
        <div class="caption">{{report.name}} </div>
    </div>
    {#{{ dump(report) }}#}

    <div class="portlet-body form">
        {#{{ form_start(form, {'attr': {'action': path('chick_new_modal',{'id':crmCustomer.id,'report':report.id }),'class': 'form-horizontal right','id':'chick_life_cycle_form'}}) }}#}
        <div class="">
            <div class="form-inner-no-space">

                <div class="row">
                    <div class="col-md-12">
                        <h4>NOURISH POULTRY & HATCHERY LTD</h4>
                        <h5>Uttara, Dhaka.</h5>
                        <h4>New Farm Introduce to Nourish Family {{report.parent.parent.name}}</h4>
                        <input type="hidden" class="farmer_touch_report_id" value="{{ report.id }}">
                    </div>

                    <div class="col-md-3">
                        <p style="color: #000000">{{ 'Name of CSO'|trans }}: {{ employee.name }}</p>
                    </div>
                    <div class="col-md-3">
                        <p style="color: #000000">{{ 'Designation'|trans }}: {{ employee.designation.name|default('') }}</p>
                    </div>
                    <div class="col-md-3">
                        <p style="color: #000000">{{ 'ID'|trans }}: </p>
                    </div>
                    <div class="col-md-3">
                        <p style="color: #000000">{{ 'Region'|trans }}: {{ employee.regional.name|default('') }}</p>
                    </div>
                </div>
                <div class="card-body card-body-inner" style="padding: 0 5px; overflow-x: scroll">
                    <div class="fishFarmerTouchSection">
                        {{ form_start(form, {'attr': {'method':'post','action': path('farmer_introduce_new_modal',{'id':crmCustomer.id, 'report':report.id }),'class': 'form-horizontal right','id':'fish_farmer_touch_report_form'}}) }}
                        {#<form id="chick_life_cycle_form" method="post" action="{{ path('cattle_life_cycle_details_modal',{id:cattleLifeCycle.id}) }}">#}
                        <table class="table table-striped table-bordered table-hover fish_farmer_touch" id="datatable">
                            <thead class="thead-dark">
                            <tr>
                                <th scope="col" rowspan="2">S/N</th>
                                {#<th scope="col" rowspan="2">Bird Type</th>#}
                                <th style="width: 120px" scope="col" rowspan="2">Name of Farmers</th>

                                <th scope="col" colspan="{{ fishSpecies|length }}">Capacity</th>
                                <th scope="col" colspan="3">{{ 'Present Agent Information'|trans }}</th>
                                <th scope="col" colspan="3">{{ 'Previous Agent Information'|trans }}</th>

                                <th scope="col" rowspan="2">Remarks</th>
                                <th scope="col" rowspan="2"></th>

                            </tr>
                            <tr>
                                {% if fishSpecies is not empty %}
                                    {% for fishSpecie in fishSpecies %}
                                    <th scope="col">
                                        {{ fishSpecie.name }}
                                    </th>
                                    {% endfor %}
                                {% endif %}

                                <th>Name Of Agent</th>
                                <th>Address</th>
                                <th>Name Of Feed</th>
                                <th>Name Of Agent</th>
                                <th>Address</th>
                                <th>Name Of Feed</th>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    {{ crmCustomer.name }}
                                </td>
                                {% if fishSpecies is not empty %}
                                    {% for fishSpecie in fishSpecies %}
                                        <td>
                                            <input type="number" min="0" name="fish_specie[{{ fishSpecie.id }}]" class="form-control fish_specie_{{ fishSpecie.id }}" value="{{ entity.cultureSpeciesQtyByItem[fishSpecie.id] is defined?entity.cultureSpeciesQtyByItem[fishSpecie.id]:0 }}">
                                        </td>
                                    {% endfor %}

                                {% endif %}

                                <td>
                                    {{ form_widget(form.agent) }}
                                </td>
                                <td>
                                    {{ entity.agent and entity.agent.agentGroup.slug!='other-agent'?entity.agent.name:'' }}
                                </td>
                                <td>
                                    {{ form_widget(form.feed) }}
                                </td>
                                <td>
                                    {{ entity.otherAgent.name|default('') }}
{#                                    {{ form_widget(form.yearlyFeedUseTon,{'type':'number'}) }}#}
                                </td>
                                <td>
                                    {{ entity.otherAgent.address|default('') }}
{#                                    {{ form_widget(form.yearlyFeedUseTon,{'type':'number'}) }}#}
                                </td>
                                <td>
                                    {{ entity.otherFeed.name|default('') }}
                                </td>
                                <td>
                                    {{ form_widget(form.remarks) }}
                                </td>
                                <td>
                                    <button title="Save" type="button" class="btn btn-primary btn-sm fish_farmer_touch_report_button"><i class="fa fa-save"></i></button>
                                </td>
                            </tr>
                            </thead>
                        </table>
                        {{ form_widget(form._token) }}
                        {{ form_end(form) }}

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
