<div class="portlet box">
    <div class="portlet-title">
        <div class="caption">{{report.name}}</div>
    </div>
    {#{{ dump(report) }}#}

    <div class="portlet-body form less_costing_farm_section">
        <div class="row form-body ">
            <div class="form-inner-no-space">
                <div class="row">
                    <div class="col-md-12">
                        <h4>NOURISH POULTRY & HATCHERY LTD</h4>
                        <h5>Uttara, Dhaka.</h5>
                        <h4>{{ 'Medicine & Vaccine Cost for'|trans }} {{report.name}}</h4>
                    </div>
                </div>
                <div class="less_costing_farm_details_section">
                    {{ form_start(form, {'attr': {'method':'post','action': path('cost_benefit_analysis_less_costing_farm_new_modal',{'id':crmCustomer.id,'report':report.id,'parentParent':report.parent.parent.id }),'class': 'form-horizontal right','id':'less_costing_farm_form'}}) }}

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-md-4 control-label" for="">{{ 'Agent'|trans }}</label>
                                <div class="col-md-8">
                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                    <p style="text-align: left" class="form-control">{{ crmCustomer.agent.name }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4"></div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-md-4 control-label" for="">{{ 'Farmer Name'|trans }}</label>
                                <div class="col-md-8">
                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                    <p style="text-align: left" class="form-control">{{ crmCustomer.name }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-md-4 control-label" for="">{{ 'Reporting Month'|trans }}</label>
                                <div class="col-md-8">
                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                    <div class="date_section">
                                        {{ form_widget(form.reporting_month) }}
                                        {{ form_errors(form.reporting_month) }}
                                        {#<input autocomplete="off" type="text" name="hatching_date" class="form-control datePicker" value="{{ entity.hatchingDate?entity.hatchingDate|date("d-m-Y"):'' }}">#}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4"></div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="col-md-4 control-label" for="">{{ 'Hatching Date'|trans }}</label>
                                <div class="col-md-8">
                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                    <div class="date_section">
                                        {{ form_widget(form.hatching_date) }}
                                        {{ form_errors(form.hatching_date) }}
                                        {#<input autocomplete="off" type="text" name="hatching_date" class="form-control datePicker" value="{{ entity.hatchingDate?entity.hatchingDate|date("d-m-Y"):'' }}">#}
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                {{ form_label(form.hatchery, 'Hatchery'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                <div class="col-md-8">
                                    {#<span class="not-blank"> {{ 'Required'|trans }}</span>#}
                                    {{ form_widget(form.hatchery) }}
                                    {{ form_errors(form.hatchery) }}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4"></div>
                        <div class="col-md-4">
                            <div class="form-group">
                                {{ form_label(form.breed, 'Breed'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                <div class="col-md-8">
                                    {#<span class="not-blank"> {{ 'Required'|trans }}</span>#}
                                    {{ form_widget(form.breed) }}
                                    {{ form_errors(form.breed) }}
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <th>{{'SL NO'|trans }}</th>
                                    <th>{{'Particulars'|trans}}</th>
                                    <th>{{'Quantity'|trans }}</th>
                                    <th>{{'Particulars'|trans}}</th>
                                    <th>{{'Quantity'|trans }}</th>
                                    <th>{{'Particulars'|trans}}</th>
                                    <th>{{'Quantity'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td>{{ '1'|trans }}</td>
                                    <td>{{ 'Total Chicks (Pcs)'|trans }}</td>
                                    <td>{{ form_widget(form.totalStockedChicksPcs,{'type':'number'}) }}</td>
                                    <td>{{ 'Chick Price (Pcs)'|trans }}</td>
                                    <td>{{ form_widget(form.itemPricePerPcs,{'type':'number'}) }}</td>
                                    <td>{{ 'Litter Cost)'|trans }}</td>
                                    <td>{{ form_widget(form.litterOrPondRentCost,{'type':'number'}) }}</td>
                                </tr>
                                <tr>
                                    <td>{{ '2'|trans}}</td>
                                    <td>{{ 'Total Feed (Kg)'|trans }}</td>
                                    <td>{{ form_widget(form.totalFeedUsedKg,{'type':'number'}) }}</td>
                                    <td>{{ 'Feed Price (Kg)'|trans }}</td>
                                    <td>{{ form_widget(form.feedPricePerKg,{'type':'number'}) }}</td>
                                    <td>{{ 'Electricity'|trans }}</td>
                                    <td>{{ form_widget(form.electricityAndFuelCost,{'type':'number'}) }}</td>
                                </tr>
                                <tr>
                                    <td>{{ '3'|trans}}</td>
                                    <td>{{ 'Total Broiler Wt (Kg)'|trans }}</td>
                                    <td>{{ form_widget(form.totalBroilerWeightKg,{'type':'number'}) }}</td>
                                    <td>{{ 'Broiler Price (Kg)'|trans }}</td>
                                    <td>{{ form_widget(form.broilerOrFishPricePerKg,{'type':'number'}) }}</td>
                                    <td>{{ 'Labour'|trans }}</td>
                                    <td>{{ form_widget(form.labourCost,{'type':'number'}) }}</td>
                                </tr>

                                <tr>
                                    <td>{{ '4'|trans}}</td>
                                    <td>{{ 'Mortality (Pcs)'|trans }}</td>
                                    <td>{{ form_widget(form.mortality,{'type':'number'}) }}</td>
                                    <td>{{ 'Medicine Cost (Total)'|trans }}</td>
                                    <td>{{ form_widget(form.totalMedicineCost,{'type':'number'}) }}</td>
                                    <td>{{ 'Transport'|trans }}</td>
                                    <td>{{ form_widget(form.transportCost,{'type':'number'}) }}</td>

                                </tr>
                                <tr>
                                    <td>{{ '5'|trans}}</td>
                                    <td>{{ 'Age (days)'|trans }}</td>
                                    <td>{{ form_widget(form.ageDays,{'type':'number'}) }}</td>
                                    <td>{{ 'Vaccine Cost (Total))'|trans }}</td>
                                    <td>{{ form_widget(form.totalVaccineCost,{'type':'number'}) }}</td>
                                    <td>{{ 'Others'|trans }}</td>
                                    <td>{{ form_widget(form.otherCost,{'type':'number'}) }}</td>
                                </tr>
                                <tr>
                                    <td>{{ '6'|trans}}</td>
                                    <td>{{ 'FCR'|trans }}</td>
                                    <td class="fcrCalculationValue"></td>
                                    <td>{{ 'Used Bag Price (Pcs)'|trans }}</td>
                                    <td>{{ form_widget(form.usedBagPricePerPcs,{'type':'number'}) }}</td>
                                    <td></td>
                                    <td></td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="form-actions">
                        <div class="col-md-6 ">
                        </div>
                        <div class="col-md-6 text-right">
                            <div class="btn-group" role="group" aria-label="Button group with nested dropdown"><button type="reset" class="btn btn-sm yellow-bg white-font"><i class="fa fa-refresh"></i>Restore</button>
                                {{ form_widget(form.SaveAndCreate, {label: 'label.save.continue',value:'label.save.continue', attr: { class: 'btn btn-info form-submit less_costing_farm_button'}}) }}
                            </div>
                        </div>
                        <div class="clearfix"></div>
                    </div>
                    {{ form_widget(form._token) }}
                    {{ form_end(form) }}
                </div>

            </div>
        </div>
    </div>
</div>
