{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        {#<li class="breadcrumb-item"> <a href="{{ path('kpi_setup') }}">  {{ 'Employee Sales'|trans }}</a></li>#}
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Crm Visit'|trans }}</h5>
                    <div class="card-header-right">
                        {% if is_granted('ROLE_CRM_POULTRY_USER') or is_granted('ROLE_CRM_CATTLE_USER') or is_granted('ROLE_CRM_AQUA_USER') or is_granted('ROLE_CRM_SALES_MARKETING_USER')  or is_granted('ROLE_USER')  or is_granted('ROLE_CORE') %}
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('crm_tour_plan_create') }}" class="btn btn-sm  green-bg white-font"><i class="fas fa-plus"></i>{{ 'Add New'|trans }}</a>
                            <a href="{{ path('crm_tour_plan') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'CRM Tour Plan'|trans }}</a>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-block">
                    <table class="table table-striped table-bordered table-hover" id="datatable">
                        <thead class="thead-dark">
                        <tr>
                            <th style="width: 10%" scope="col">S/N</th>
                            <th style="width: 10%" scope="col">{{ 'Visiting Date'|trans }}</th>
                            <th style="width: 20%" scope="col">Working Mode</th>
                            <th style="width: 20%" scope="col">Visiting Area</th>
                            <th style="width: 10%" scope="col" class="text-center" width="12%"><i class="feather icon-settings"></i></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% if entities is defined and entities['data'] is defined and entities['data'] is not empty %}
                            {% for monthWiseData in entities['data'] %}
                                {% for visitingDate, entity in monthWiseData  %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ visitingDate|date('d-m-Y') }}</td>
                                        <td>
{#                                            {% if entity.workingMode.workingModeId is defined %}#}
                                            <a
                                                    data-type="select"
                                                    class="editable"
                                                    id="workingMode-{{ entity.workingMode.id|default('') }}"
                                                    data-name="workingMode"
                                                    href="#"
                                                    data-source="{{ path('working_mode_select') }}"
                                                    data-url="{{ path('working_mode_inline_update',{id:entity.id}) }}"
                                                    data-pk="{{ entity.workingMode.id|default('') }}"
                                                    data-value="{{ entity.workingMode.id|default('') }}"
                                                    data-original-title="Select Working Mode">
                                                {{ entity.workingMode.name|default('') }}
                                            </a>
{#                                            {% endif %}#}
                                        </td>
                                        <td>
                                            <a
                                                    data-type="text"
                                                    class="editable"
                                                    id="visitingArea-{{ entity.id }}"
                                                    data-name="visitingArea"
                                                    href="javascript:"
                                                    data-url="{{ path('inline_visiting_area_using_ajax',{'id':entity.id}) }}"
                                                    data-pk="{{ entity.id }}"
                                                    data-value="{{ entity.visitingArea|default('') }}">
                                                {{ entity.visitingArea }}
                                            </a>

                                        </td>
                                        <td>
    {#                                        <a class="btn btn-transparent btn-mini red-font remove" href="javascript:" data-action="{{ path('crm_visit_delete',{'id':entity.id}) }}"><i class="fa fa-remove"></i></a>#}
                                        </td>
                                    </tr>
                                {% endfor %}

                            {% endfor %}
                        {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
{% block cssBlock %}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/terminalbdcrm/css/crm.css') }}">
    <style>
        .editable-click, a.editable-click, a.editable-click:hover {
            text-decoration: none;
            border-bottom: dashed 1px #0088cc;
        }
    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/plugins/bootstrap-editable/js/bootstrap4-editable.js') }}"></script>


{% endblock  %}

{% block documentready %}
    {{ parent() }}
{#    <script>#}
    $.fn.editable.defaults.mode ='inline';
    {#    $.fn.editable.defaults.mode = 'popover';#}
    $('.editable').editable();
{% endblock %}
