{% extends 'admin/layout.html.twig' %}
{#{% block body_id 'kpi_domain_new' %}#}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        {#<li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>#}
                        {#<li class="breadcrumb-item"> <a href="{{ path('kpi_markchart') }}">  {{ 'Settings'|trans }}</a></li>#}
                        {#<li class="breadcrumb-item"> <a href="javascript:">{{ 'Add New'|trans }}</a></li>#}
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Manage Daily Activies'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            {#<a href="{{ path('kpi_markchart_new') }}" class="btn btn-sm  green-bg white-font"><i class="fas fa-plus"></i>{{ 'Add New'|trans }}</a>#}
                            {#<a href="{{ path('kpi_markchart') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'KPI Mark Chart'|trans }}</a>#}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box blue">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Manage Daily Activies'|trans }} </div>
                    </div>
                    <div class="portlet-body form">
                        {{ form_start(form, {'attr': {'class': 'form-horizontal right'}}) }}
                        <div class="row form-body">
                            <div class="form-inner-no-space">
                                <div class="row">
                                    <div class="col-md-6 offset-1">
                                        <div class="form-group">
                                            <label class="col-md-4 control-label">Employee Name</label>
                                            <div class="col-md-8">{{ entity.employee.name }}</div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-md-4 control-label">Designation</label>
                                            <div class="col-md-8">{{ entity.employee.designation.name }}</div>
                                        </div>

                                        <div class="form-group">
                                            {{ form_label(form.location,'Area Name'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                            <div class="col-md-8">
                                                <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                {{ form_widget(form.location) }}
                                                {{ form_errors(form.location) }}
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            {{ form_label(form.working_duration,'Working Duration'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                            <div class="col-md-8">
                                                <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                {{ form_widget(form.working_duration) }}
                                                {{ form_errors(form.working_duration) }}
                                            </div>
                                        </div>
                                        <hr>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                                <div class="row">
                                    <div class="card">
                                        <div class="card-block">
                                            <table class="table table-striped table-bordered table-hover" id="datatable">
                                                <thead class="thead-dark">
                                                <tr>
                                                    <th scope="col">Visiting week</th>
                                                    <th scope="col">Total birds</th>
                                                    <th scope="col">Age (day)</th>
                                                    <th scope="col">Pes</th>
                                                    <th scope="col">%</th>
                                                    <th scope="col">Standard</th>
                                                    <th scope="col">Achieved</th>
                                                    <th scope="col">Total(kg)</th>
                                                    <th scope="col">Per bird (gm)</th>
                                                    <th scope="col">Standard</th>
                                                    <th scope="col">Without  M</th>
                                                    <th scope="col">With M</th>
                                                    <th scope="col">Feed Type</th>
                                                    <th scope="col">Pro. Date</th>
                                                    <th scope="col">Batch No.</th>
                                                    <th scope="col">Remarks</th>
                                                </tr>
                                                </thead>
                                                <tbody>

                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Farmer  Information</h5>
                                    <div class="card-header-right">
                                        <div class="btn-group btn-group-sm">

                                            <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#farmerModal" data-whatever="@mdo">New Farmer</button>
                                            <button type="button" id="addrow" class="btn btn-sm  green-bg white-font addmore ml-2"><i class="fas fa-plus"></i> Add</button>
                                        </div>
                                    </div>
                                </div>
                                {#addmore#}
                                <div class="card-body card-body-inner">
                                    <div class="col-md-12 clone-block" id="clone-block">
                                        <div class="clone">
                                            <div class="row">
                                                <div class="col-md-2">

                                                    <select name="purpose[]" id="" class="form-control">
                                                        <option value="">Select Purpose</option>
                                                        {% for purpose in purposes %}
                                                            <option value="{{purpose.id}}"> {{purpose.name}} </option>
                                                        {% endfor %}
                                                    </select>


                                                </div>
                                                <div class="col-md-2">
                                                    <select name="farmer[]" id="farmer" class="form-control farmer">
                                                        <option value="">Select Farmers</option>
                                                        {% for farmer in farmers %}
                                                            <option value="{{farmer.id}}"> {{farmer.name}} </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="">
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="">
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" name="capacity[]" id="capacity" class="form-control form-control-sm" placeholder="Farm Capacity" value="">
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="input-group">
                                                        <input type="text" name="comments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments">
                                                        <div class="input-group-append">
                                                            <div class="btn btn-sm btn-transparent red-font row-remove hidden">
                                                                <i class="fa fa-remove"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {% if entity.crmVisitDetails is not empty %}
                                            {% for details in entity.crmVisitDetails  %}
                                                {% if details.process == "farmer" %}
                                                    <div class="row">
                                                        <div class="col-md-2">
                                                            <select name="purpose[]" id="" class="form-control">
                                                                <option value="">Select Purpose</option>
                                                                {% for purpose in purposes %}
                                                                    <option {% if details.purpose is not empty and details.purpose.id == purpose.id %} selected="selected" {% endif %} value="{{purpose.id}}"> {{purpose.name}} </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <select name="farmer[]" id="otherAgent" class="form-control farmer">
                                                                <option value="">Select Farmer</option>
                                                                {% for farmer in farmers %}
                                                                    <option {% if details.crmCustomer is not empty and details.crmCustomer.id == farmer.id %} selected="selected" {% endif %} value="{{farmer.id}}"> {{farmer.name}} </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="{% if details.crmCustomer is not empty  %} {{ details.crmCustomer.address }} {% endif %}">
                                                        </div>
                                                        <div class="col-md-2">
                                                            <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="{% if details.crmCustomer is not empty  %} {{ details.crmCustomer.mobile }} {% endif %}">
                                                        </div>
                                                        <div class="col-md-2">
                                                            <input type="text" name="capacity[]" id="capacity" class="form-control form-control-sm" placeholder="Farm Capacity" value="{{ details.farmCapacity }}">
                                                        </div>
                                                        <div class="col-md-2">
                                                            <div class="input-group">
                                                                <input type="text" name="comments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments" value="{{ details.comments }}" >
                                                                <div class="input-group-append">
                                                                    <a data-action="{{ path('crm_visit_item_delete',{'id':details.id}) }}" class="btn btn-sm btn-transparent red-font row-remove">
                                                                        <i class="fa fa-remove"></i>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                                {#end#}

                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Agent Information</h5>
                                    <div class="card-header-right">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" id="" class="btn btn-sm  green-bg white-font addAgent"><i class="fas fa-plus"></i> Add</button>
                                        </div>
                                    </div>
                                </div>
                                {#agent-addmore#}
                                <div class="card-body card-body-inner">
                                    <div class="col-md-12 agent-clone-block" id="agent-clone-block">
                                        <div class="agentClone">
                                            <div class="row">
                                                <div class="col-md-2">

                                                    <select name="agentPurpose[]" id="" class="form-control">
                                                        <option value="">Select Purpose</option>
                                                        {% for purpose in purposes %}
                                                            <option value="{{purpose.id}}"> {{purpose.name}} </option>
                                                        {% endfor %}
                                                    </select>


                                                </div>
                                                <div class="col-md-2">
                                                    <select name="agent[]" id="agent" class="form-control farmer">
                                                        <option value="">Select Agent</option>
                                                        {% for agent in agents %}
                                                            <option value="{{agent.id}}"> {{agent.name}} </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="">
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="">
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="input-group">
                                                        <input type="text" name="agentComments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments">
                                                        <div class="input-group-append">
                                                            <div class="btn btn-sm btn-transparent red-font row-remove hidden">
                                                                <i class="fa fa-remove"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {% if entity.crmVisitDetails is not empty %}
                                            {% for details in entity.crmVisitDetails  %}
                                                {% if details.process == "agent" %}
                                                    <div class="row">
                                                        <div class="col-md-2">
                                                            <select name="agentPurpose[]" id="" class="form-control">
                                                                <option value="">Select Purpose</option>
                                                                {% for purpose in purposes %}
                                                                    <option {% if details.purpose is not empty and details.purpose.id == purpose.id %} selected="selected" {% endif %} value="{{purpose.id}}"> {{purpose.name}} </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <select name="agent[]" id="agent" class="form-control farmer">
                                                                <option value="">Select Agent</option>
                                                                {% for agent in agents %}
                                                                    <option {% if details.agent is not empty and details.agent.id == agent.id %} selected="selected" {% endif %} value="{{agent.id}}"> {{agent.name}} </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="{% if details.agent is not empty  %} {{ details.agent.address }} {% endif %}">
                                                        </div>
                                                        <div class="col-md-2">
                                                            <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="{% if details.agent is not empty  %} {{ details.agent.mobile }} {% endif %}">
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="input-group">
                                                                <input type="text" name="agentComments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments" value="{{ details.comments }}" >
                                                                <div class="input-group-append">
                                                                    <a data-action="{{ path('crm_visit_item_delete',{'id':details.id}) }}" class="btn btn-sm btn-transparent red-font row-remove">
                                                                        <i class="fa fa-remove"></i>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Other Agent Information</h5>
                                    <div class="card-header-right">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-primary " data-toggle="modal" data-target="#otherAgentModal" data-whatever="@mdo">New Other-agent</button>
                                            <button type="button" id="addOtherAgent" class="btn btn-sm  green-bg white-font addOtherAgent"><i class="fas fa-plus"></i> Add</button>
                                        </div>
                                    </div>
                                </div>
                                {#agent-addmore#}
                                <div class="card-body card-body-inner">
                                    <div class="col-md-12 other-agent-clone-block" id="other-agent-clone-block">
                                        <div class="otherAgentClone">
                                            <div class="row">
                                                <div class="col-md-2">

                                                    <select name="otherPurpose[]" id="" class="form-control">
                                                        <option value="">Select Purpose</option>
                                                        {% for purpose in purposes %}
                                                            <option value="{{purpose.id}}"> {{purpose.name}} </option>
                                                        {% endfor %}
                                                    </select>


                                                </div>
                                                <div class="col-md-2">
                                                    <select name="otherAgent[]" id="otherAgent" class="form-control farmer">
                                                        <option value="">Select Other Agent</option>
                                                        {% for other in otherAgents %}
                                                            <option value="{{other.id}}"> {{other.name}} </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="">
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="">
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="input-group">
                                                        <input type="text" name="otherComments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments">
                                                        <div class="input-group-append">
                                                            <div class="btn btn-sm btn-transparent red-font row-remove hidden">
                                                                <i class="fa fa-remove"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {% if entity.crmVisitDetails is not empty %}
                                            {% for details in entity.crmVisitDetails  %}
                                                {% if details.process == "other-agent" %}
                                                    <div class="row">
                                                    <div class="col-md-2">
                                                        <select name="otherPurpose[]" id="" class="form-control">
                                                            <option value="">Select Purpose</option>
                                                            {% for purpose in purposes %}
                                                                <option {% if details.purpose is not empty and details.purpose.id == purpose.id %} selected="selected" {% endif %} value="{{purpose.id}}"> {{purpose.name}} </option>
                                                            {% endfor %}
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <select name="otherAgent[]" id="otherAgent" class="form-control farmer">
                                                            <option value="">Select Other Agent</option>
                                                            {% for other in otherAgents %}
                                                                <option {% if details.crmCustomer is not empty and details.crmCustomer.id == other.id %} selected="selected" {% endif %} value="{{other.id}}"> {{other.name}} </option>
                                                            {% endfor %}
                                                        </select>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="{% if details.crmCustomer is not empty  %} {{ details.crmCustomer.address }} {% endif %}">
                                                    </div>
                                                    <div class="col-md-2">
                                                        <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="{% if details.crmCustomer is not empty  %} {{ details.crmCustomer.mobile }} {% endif %}">
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="input-group">
                                                            <input type="text" name="otherComments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments" value="{{ details.comments }}" >
                                                            <div class="input-group-append">
                                                                <a data-action="{{ path('crm_visit_item_delete',{'id':details.id}) }}" class="btn btn-sm btn-transparent red-font row-remove">
                                                                    <i class="fa fa-remove"></i>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </div>

                                    <div class="clearfix"></div>
                                </div>

                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Sub-agent Information</h5>
                                    <div class="card-header-right">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-primary " data-toggle="modal" data-target="#subAgentModal" data-whatever="@mdo">New Sub-agent</button>
                                            <button type="button" id="addSubAgent" class="btn btn-sm  green-bg white-font addSubAgent"><i class="fas fa-plus"></i> Add</button>
                                        </div>
                                    </div>
                                </div>
                                {#agent-addmore#}
                                <div class="card-body card-body-inner">
                                    <div class="col-md-12 sub-agent-clone-block" id="sub-agent-clone-block">
                                        <div class="subAgentClone">
                                            <div class="row">
                                                <div class="col-md-2">
                                                    <select name="subPurpose[]" id="" class="form-control">
                                                        <option value="">Select Purpose</option>
                                                        {% for purpose in purposes %}
                                                            <option value="{{purpose.id}}"> {{purpose.name}} </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <select name="subAgent[]" id="subAgent" class="form-control farmer">
                                                        <option value="">Select Sub-agent</option>
                                                        {% for sub in subAgents %}
                                                            <option value="{{sub.id}}"> {{sub.name}} </option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="">
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="">
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="input-group">
                                                        <input type="text" name="subComments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments">
                                                        <div class="input-group-append">
                                                            <div class="btn btn-sm btn-transparent red-font row-remove hidden">
                                                                <i class="fa fa-remove"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {% if entity.crmVisitDetails is not empty %}
                                            {% for details in entity.crmVisitDetails  %}
                                                {% if details.process == "sub-agent" %}
                                                    <div class="row">
                                                        <div class="col-md-2">
                                                            <select name="subPurpose[]" id="" class="form-control">
                                                                <option value="">Select Purpose</option>
                                                                {% for purpose in purposes %}
                                                                    <option {% if details.purpose is not empty and details.purpose.id == purpose.id %} selected="selected" {% endif %} value="{{purpose.id}}"> {{purpose.name}} </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <select name="subAgent[]" id="subAgent" class="form-control farmer">
                                                                <option value="">Select Sub-agent</option>

                                                                {% for sub in subAgents %}
                                                                    <option {% if details.crmCustomer is not empty and details.crmCustomer.id == sub.id %} selected="selected" {% endif %} value="{{sub.id}}"> {{sub.name}} </option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                        <div class="col-md-2">
                                                            <input type="text" disabled="disabled" class="form-control form-control-sm" placeholder="Address" value="{% if details.crmCustomer is not empty  %} {{ details.crmCustomer.address }} {% endif %}">
                                                        </div>
                                                        <div class="col-md-2">
                                                            <input type="text" disabled="disabled"  class="form-control form-control-sm" placeholder="Phone"  value="{% if details.crmCustomer is not empty  %} {{ details.crmCustomer.mobile }} {% endif %}">
                                                        </div>
                                                        <div class="col-md-4">
                                                            <div class="input-group">
                                                                <input type="text" name="subComments[]" id="comments" class="form-control form-control-sm" placeholder="Enter your comments" value="{{ details.comments }}" >
                                                                <div class="input-group-append">
                                                                    <a data-action="{{ path('crm_visit_item_delete',{'id':details.id}) }}" class="btn btn-sm btn-transparent red-font row-remove">
                                                                        <i class="fa fa-remove"></i>
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                    <div class="clearfix"></div>
                                </div>

                                {#end#}
                                <div class="form-actions">
                                    <div class="col-md-6 "></div>
                                    <div class="col-md-6 text-right">
                                        <div class="btn-group" role="group" aria-label="Button group with nested dropdown"><button type="reset" class="btn btn-sm yellow-bg white-font"><i class="fa fa-refresh"></i>Restore</button>
                                            {{ form_widget(form.SaveAndCreate, {label: 'label.save.continue',value:'label.save.continue', attr: { class: 'btn btn-info form-submit'}}) }}
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div>
                        {{ form_widget(form._token) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>


        {#Modal#}
        <div class="modal fade" id="farmerModal" tabindex="-1" aria-labelledby="farmerModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content" style="padding: 20px" >
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">New Farmer</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <form action="{{ path('new_farmer_ajax',{'id':entity.id}) }}" name="farmerForm" class="form-horizontal right crm-customer-create-form" id="farmerForm" onsubmit="return validateform()"   method="post">

                    <div class="modal-body">


                        <div class="form-group">
                            <label for="recipient-name" class="col-form-label col-md-4 ">Name:</label>
                            <input type="text" name="name" class="form-control col-md-8 mr-4 name" id="name" autocomplete="off" required>
