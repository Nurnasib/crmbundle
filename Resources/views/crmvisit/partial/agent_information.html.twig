{% if entity.crmVisitDetails is not empty %}
    {% for details in entity.crmVisitDetails  %}
        {% if details.process == "agent" %}
            <tr>
                <td>
                    {{ details.purpose is not empty?details.purpose.name:'' }}
                </td>
                <td>
                    {{ details.agent is not empty?details.agent.name:'' }}
                </td>
                <td>
                    {% if details.agent is not empty  %} {{ details.agent.address }} {% endif %}
                </td>
                <td>
                    {% if details.agent is not empty  %} {{ details.agent.mobile }} {% endif %}
                </td>
                <td>
                    {{ details.comments }}
                </td>
                <td>
                    <a data-id="{{ details.id }}" class="btn btn-sm btn-transparent red-font row-remove">
                        <i class="fa fa-remove"></i>
                    </a>
                </td>
                <td>
                    {% if details.process=='agent' and details.purpose is not empty and details.purpose.slug in ['farmer-training'] %}
                        <a class="btn btn-primary btn-sm" data-action='{{ path('farmer_training_report_new_modal',{'id': details.agent is not empty?details.agent.id:'', 'purpose':details.purpose is not empty? details.purpose.id:''}) }}' href='?process=postView_{{ details.id }}_{{ details.purpose is not empty? details.purpose.id:'' }}&report={{ details.purpose is not empty? details.purpose.slug:'' }}&check=show#modal' id='postView_{{ details.id }}_{{ details.purpose is not empty? details.purpose.id:'' }}' >{{ 'Report'|trans }}</a>
                    {% endif %}
                </td>
            </tr>

        {% endif %}
    {% endfor %}
{% endif %}