
{% if entity.crmVisitDetails is not empty %}
    {% for details in entity.crmVisitDetails  %}
        {% if details.process == "farmer" %}
            <tr>
                <td>
                    {{ details.purpose is not empty?details.purpose.name:'' }}
                </td>
                <td>
                    {{ details.crmCustomer is not empty?details.crmCustomer.name:'' }}
                </td>
                <td>
                    {% if details.crmCustomer is not empty  %} {{ details.crmCustomer.address }} {% endif %}
                </td>
                <td>
                    {% if details.crmCustomer is not empty  %} {{ details.crmCustomer.mobile }} {% endif %}
                </td>
                <td>
                    {{ details.farmCapacity }}
                </td>
                <td>
                    {{ details.comments }}
                </td>
                <td>
                    <a data-id="{{ details.id }}" class="btn btn-sm btn-transparent red-font row-remove">
                        <i class="fa fa-remove"></i>
                    </a>
                    <div class="btn-group card-option"><button type="button" class="btn btn-notify" data-toggle="dropdown" aria-expanded="false"><i class="fas fa-ellipsis-h"></i></button>
                        <ul class="list-unstyled card-option dropdown-info dropdown-menu dropdown-menu-right" x-placement="top-end" style="position: absolute; transform: translate3d(-115px, -91px, 0px); top: 0px; left: 0px; will-change: transform;">
                            <li class="dropdown-item"> <a data-action="{{ path('chick_new') }}" href="?process=postView-{{ details.id }}&amp;check=new#modal" id='postView-{{ details.id }}'>Chick</a></li>
                        </ul>
                    </div>
                </td>
            </tr>
        {% endif %}
    {% endfor %}
{% endif %}