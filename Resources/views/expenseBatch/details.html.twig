{% extends 'admin/layout.html.twig' %}
{% block body %}

    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header hidden-print">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('crm_expense_batch_list') }}">  {{ 'Expense Batch'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Details'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row hidden-print">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Monthly Expense'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('crm_expense_batch_list') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Monthly Expense'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box">
                    <div class="portlet-title hidden-print">
                        <div class="caption ">{{'Monthly Expense Details'|trans}} </div>
                        {% if expenseBatch.status>1 %}
                            <div style="float: right; padding-right: 15px" class="caption hidden-print">
                                <div class="pull-right">
                                    <button class="btn btn-info btn-sm" id="windowPrint"><i class="fa fa-print"></i> </button>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="portlet-body form expense_body" id="expense_form_section">

                        <div style="text-align: center">
                            <h4>Nourish Poultry & Hatchery Ltd.</h4>
                            <h6>Uttara, Dhaka</h6>
                            <h6>Monthly TA DA Bill</h6>
                            <h6>Month: {{ expenseBatch.expenseMonth|date('F Y') }}</h6>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <table class="table table-borderless" border="0">
                                    <tr>
                                        <td>
                                            <strong>Name:</strong> {{ expenseBatch.employee.name|default('') }}
                                        </td>
                                        <td class="text-center">
                                            <strong>Employee Id:</strong> {{ expenseBatch.employee.userId|default('') }}
                                        </td>
                                        <td>
                                            <strong>Working Station:</strong> {{ expenseBatch.employee.address|default('') }}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <strong>Designation:</strong> {{ expenseBatch.employee.designation.name|default('') }}
                                        </td>
                                        <td class="text-center">
                                            <strong>Vehicle Type:</strong> {{ expenseBatch.employee.typeOfVehicle|default('')|capitalize }} /  No: {{ expenseBatch.employee.vehicleNo|default('') }}
                                        </td>
                                        <td>
                                            <strong>Responsible of:</strong> {{ expenseBatch.employee.responsibleOf.name|default('') }}
                                        </td>
                                    </tr>
                                </table>
                            </div>

                        </div>

                        <table class="table table-bordered">
                            <thead>
                            <tr>
                                <th rowspan="2">SL</th>
                                <th rowspan="2">Date</th>
                                <th rowspan="2" class="hidden-print">Schedule</th>
                                <th rowspan="2">Visiting Area</th>
                                <th rowspan="2">Area</th>
                                {% if areaWiseExpenseParticulars is defined and areaWiseExpenseParticulars['areaName'] is defined and areaWiseExpenseParticulars['areaName'] is iterable %}
                                    {% for areaId, expenseParticularAttribute in areaWiseExpenseParticulars['areaName'] %}
                                        <th colspan="{{ areaWiseExpenseParticulars['chartDetails'][areaId]|length }}" class="text-center" scope="col">{{ expenseParticularAttribute }}</th>
                                    {% endfor %}
                                {% endif %}


                                {% if typeOfVehicles is not empty %}
                                    {% for typeOfVehicle in typeOfVehicles%}
                                        <th rowspan="2">{{ typeOfVehicle.name }}</th>
                                    {% endfor %}
                                {% endif %}

                                {#{% if dailyExpenseParticularAttributes is defined and dailyExpenseParticularAttributes is iterable %}
                                    {% for dailyExpenseParticularAttribute in dailyExpenseParticularAttributes %}
                                        <th scope="col">{{ dailyExpenseParticularAttribute.name }}</th>
                                    {% endfor %}
                                {% endif %}#}
                                <th rowspan="2" title="Total">Total (TK.)</th>
                                <th class="hidden-print" rowspan="2"></th>
                            </tr>
                            <tr>
                                {% if areaWiseExpenseParticulars is defined and areaWiseExpenseParticulars['areaName'] is defined and areaWiseExpenseParticulars['areaName'] is iterable %}
                                    {% for areaId, expenseParticularAttribute in areaWiseExpenseParticulars['areaName'] %}
                                        {% if areaWiseExpenseParticulars is defined and areaWiseExpenseParticulars['chartDetails'] is defined and areaWiseExpenseParticulars['chartDetails'][areaId] is defined and areaWiseExpenseParticulars['chartDetails'][areaId] is iterable %}
                                            {% for expenseChart in areaWiseExpenseParticulars['chartDetails'][areaId] %}
                                                <th class="text-center" scope="col">{{ expenseChart.particularName }}</th>
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </tr>
                            </thead>
                            {% if expenseBatch is defined and expenseBatch.expenses is not empty %}
                                <tbody>

                                {% set totalLineTotal=0 %}
                                {% set totalMilage=0 %}
                                {% for entity in expenseBatch.expenses %}
                                    {% set lineTotal = 0 %}

{#                                    {% set lineTotal= expensePaticularAmount['inLine'] is defined? expensePaticularAmount['inLine'][entity.employee.id][entity.id]|arraySumColWise('amount'):'0.00' %}#}
{##}
{#                                    {% set totalLineTotal=totalLineTotal+lineTotal %}#}
                                <tr>
                                    <td class="show-print">
                                        {{ loop.index }}

                                    </td>
                                    <td>{{ entity.expenseDate|date('d-m-Y') }}</td>
                                    <td class="hidden-print">{{ entity.scheduleVisit }}</td>
                                    <td>{{ entity.visitLocation|default('') }}</td>
                                    <td>{{ entity.workingArea.name|default('') }}</td>

                                    {% if areaWiseExpenseParticulars is defined and areaWiseExpenseParticulars['areaName'] is defined and areaWiseExpenseParticulars['areaName'] is iterable %}
                                        {% for areaId, expenseParticularAttribute in areaWiseExpenseParticulars['areaName'] %}
                                            {% if areaWiseExpenseParticulars is defined and areaWiseExpenseParticulars['chartDetails'] is defined and areaWiseExpenseParticulars['chartDetails'][areaId] is defined and areaWiseExpenseParticulars['chartDetails'][areaId] is iterable %}
                                                {% for chartDetailsId, expenseChart in areaWiseExpenseParticulars['chartDetails'][areaId] %}
                                                    {% set expenseParticularId = expensePaticularAmount['inLine'] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId] is defined ? expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId]['expenseParticularId']:'' %}
                                                    {% set amount = expensePaticularAmount['inLine'] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId] is defined ? expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId]['amount']|number_format(2,'.',''):0 %}
                                                    {% set lineTotal = lineTotal + amount %}

                                                    <td class="text-right">
                                                        {% if expensePaticularAmount['inLine'] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId]['path'] is not empty%}
                                                            <a title="Attachment Available" href="{{ asset('uploads/expense/'~expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId]['path']) }}" download>
                                                                {{ expensePaticularAmount['inLine'] is defined? expensePaticularAmount['inLine'][entity.employee.id][entity.id][chartDetailsId][expenseChart.particularId]['amount']|number_format(2,'.',','):'0.00' }}
                                                            </a>
                                                        {% else %}
                                                            {{ amount|number_format(2,'.',',') }}
                                                            {#                                                                    == {{ expenseParticularId }}#}
                                                        {% endif %}
                                                    </td>

                                                {% endfor %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                    {% if typeOfVehicles is not empty %}
                                        {% for typeOfVehicle in typeOfVehicles%}
                                            <td class="text-right">
                                                {% set conveyanceAmount = conveyanceDetailsTotalAmount['data'] is defined and conveyanceDetailsTotalAmount['data'][entity.id] is defined and conveyanceDetailsTotalAmount['data'][entity.id][typeOfVehicle.slug] is defined?conveyanceDetailsTotalAmount['data'][entity.id][typeOfVehicle.slug]['totalAmount']|number_format(2,'.',''):0 %}
                                                {% if typeOfVehicle.slug=='motorcycle' %}
                                                {% set totalMileageKm = conveyanceDetailsTotalAmount['data'] is defined and conveyanceDetailsTotalAmount['data'][entity.id] is defined and conveyanceDetailsTotalAmount['data'][entity.id][typeOfVehicle.slug] is defined?conveyanceDetailsTotalAmount['data'][entity.id][typeOfVehicle.slug]['totalMileage']:0 %}
                                                    {% set totalMilage = totalMilage + totalMileageKm %}
                                                {% endif %}

                                                {% set lineTotal = lineTotal + conveyanceAmount %}
{#                                                {% set totalLineTotal = totalLineTotal + conveyanceAmount %}#}

                                                {{ conveyanceAmount|number_format(2,'.',',') }}
                                            </td>
                                        {% endfor %}
                                    {% endif %}
{#                                    {% set totalLineTotal = totalLineTotal + lineTotal %}#}

                                    <th class="text-right">{{ lineTotal|number_format(2,'.',',') }}</th>
                                    <td class="hidden-print">
{#                                        {% if expenseBatch.status<2 %}#}
{#                                            <input type="hidden" name="expense[{{ entity.id }}]" value="{{ entity.id }}">#}
                                            <div class="btn-group">
                                                <a style="margin-right: 2px" class="btn btn-primary btn-mini white-font" href="{{ path('crm_expense_edit',{'id':entity.id}) }}"><i class="fa fa-edit"></i></a>
                                                {#                                                <a class="btn btn-danger btn-mini white-font removeReload" href="javascript:" data-action="{{ path('crm_expense_delete',{'id':entity.id}) }}"><i class="fa fa-remove"></i></a>#}
                                            </div>
{#                                        {% endif %}#}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                                <tfoot>
                                    <tr class="text-right">
{#                                        <th class="text-right hidden show-print" colspan="3">Total</th>#}
                                        <th class="text-right hidden show-print" colspan="{{ 4 }}">Total</th>
                                        <th class="text-right hidden-print" colspan="{{ 5 }}">Total</th>
                                        {% if areaWiseExpenseParticulars is defined and areaWiseExpenseParticulars['areaName'] is defined and areaWiseExpenseParticulars['areaName'] is iterable %}
                                            {% for areaId, expenseParticularAttribute in areaWiseExpenseParticulars['areaName'] %}
                                                {% if areaWiseExpenseParticulars is defined and areaWiseExpenseParticulars['chartDetails'] is defined and areaWiseExpenseParticulars['chartDetails'][areaId] is defined and areaWiseExpenseParticulars['chartDetails'][areaId] is iterable %}
                                                    {% for chartDetailsId, expenseChart in areaWiseExpenseParticulars['chartDetails'][areaId] %}
                                                        {% set totalAmount = expensePaticularAmount['grandTolalPerColumn'] is defined and expensePaticularAmount['grandTolalPerColumn'][chartDetailsId] is defined ?expensePaticularAmount['grandTolalPerColumn'][chartDetailsId][expenseChart.particularId]|arraySumColWise('amount')|number_format(2,'.',''):0 %}
                                                        {% set totalLineTotal = totalLineTotal + totalAmount %}
                                                        <td class="text-right">{{ totalAmount|number_format(2,'.',',') }}</td>
                                                    {% endfor %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                        {% if typeOfVehicles is not empty %}
                                            {% for typeOfVehicle in typeOfVehicles%}
                                                <td class="text-right">
                                                    {% set conveyanceTotalAmount = conveyanceDetailsTotalAmount['grandTotal'] is defined and conveyanceDetailsTotalAmount['grandTotal'][typeOfVehicle.slug] is defined ? conveyanceDetailsTotalAmount['grandTotal'][typeOfVehicle.slug]|arraySum()|number_format(2,'.',''):0 %}

                                                    {% set totalLineTotal = totalLineTotal + conveyanceTotalAmount %}

                                                    {{ conveyanceTotalAmount|number_format(2,'.',',') }}
                                                </td>
                                            {% endfor %}
                                        {% endif %}

                                        <th>{{ totalLineTotal|number_format(2,'.',',') }}</th>
                                        <th class="hidden-print"></th>
                                    </tr>

                                    <tr>
                                        <th class="text-right hidden show-print" colspan="{{ 4 + (areaWiseExpenseParticulars['chartDetails'] is defined? areaWiseExpenseParticulars['chartDetails']|multiArrayLength: 0)+ typeOfVehicles|length }}">
                                            Bike Miles Amount (Total reading {{ totalMilage }} KM, Per KM = {{ expenseBatch.perMilesAmount }} Tk.)
                                        </th>
                                        <th class="text-right hidden-print" colspan="{{ 5 + (areaWiseExpenseParticulars['chartDetails'] is defined? areaWiseExpenseParticulars['chartDetails']|multiArrayLength: 0)+ typeOfVehicles|length }}">
                                            Bike Miles Amount (Total reading {{ totalMilage }} KM, Per KM = {{ expenseBatch.perMilesAmount }} Tk.)
                                        </th>
                                        <th class="text-right">{{ (totalMilage*3.5)|number_format(2) }}</th>
                                        <th class="hidden-print"></th>
                                    </tr>

                                <tr>
                                    <th class="text-right hidden show-print" colspan="{{ 4 + (areaWiseExpenseParticulars['chartDetails'] is defined? areaWiseExpenseParticulars['chartDetails']|multiArrayLength: 0)+ typeOfVehicles|length }}">
                                        Grand Total
                                    </th>
                                    <th class="text-right hidden-print" colspan="{{ 5 + (areaWiseExpenseParticulars['chartDetails'] is defined? areaWiseExpenseParticulars['chartDetails']|multiArrayLength: 0)+ typeOfVehicles|length }}">
                                        Grand Total
                                    </th>
{#                                    <th colspan="{{ dailyExpenseParticularAttributes|length + typeOfVehicles|length }}" class="text-right hidden-print">Grand Total</th>#}
                                    <th class="text-right">{{ (totalLineTotal+(totalMilage*3.5))|number_format(2,'.',',') }}</th>
                                    <th class="hidden-print"></th>
                                </tr>
                                </tfoot>
                            {% endif %}

                        </table>
                        {% if expenseBatch.status<2 %}
                            <div class="hidden-print" style="padding-bottom: 20px">
                                <div class="col-md-12 text-right">
                                    <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                        <a class="btn btn-sm btn-primary" href="{{ path('crm_expense_batch_approved',{'id':expenseBatch.id}) }}">Approved</a>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        {% endif %}


                    </div>
                    {% if expenseBatch.status>1 %}
                        <table width="100%" class="no-bordered" style="margin-bottom: 20px">
                            <tr>
                                <th style="text-align: center; color: #000">{{ expenseBatch.employee.name|default('') }}</th>
                                <th style="text-align: center; color: #000">{{ expenseBatch.approvedBy.name|default('') }}</th>
                                <th style="text-align: center; color: #000"></th>
                                <th style="text-align: center; color: #000"></th>
                                <th style="text-align: center; color: #000"></th>
                                <th style="text-align: center; color: #000"></th>
                            </tr>
                            <tr>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Submited by</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Supervisor/ Authorized Official</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Junior AGM</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Senior DGM (S&S)</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">GM(S&M)</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Avp (S&M</span></th>
                            </tr>
                        </table>
                    {% endif %}



                    <div class="portlet-body">

                        {% if typeOfVehicles is not empty %}
                            {% for typeOfVehicle in typeOfVehicles %}

                                {% if typeOfVehicle.slug == 'motorcycle' %}

                                    {% if transportTypeConveyanceDetails[typeOfVehicle.slug] is defined and  transportTypeConveyanceDetails[typeOfVehicle.slug] is not empty  %}

                                        {% set presentReadingArray = transportTypeConveyanceDetails[typeOfVehicle.slug]|multiDimensionalArrayCol('meterReadingToConcat') %}

                                        {% set presentReading =  presentReadingArray is defined and presentReadingArray|length >0 and presentReadingArray|last is not null  ? presentReadingArray|last : 0 %}

                                        {% set previousReadingArray = transportTypeConveyanceDetails[typeOfVehicle.slug]|multiDimensionalArrayCol('meterReadingFromConcat') %}

                                        {% set previousReading = previousReadingArray is defined and previousReadingArray|length >0 and previousReadingArray[0] is not null  ? previousReadingArray[0] : 0 %}

                                        {% set usedReadingBill = (transportTypeConveyanceDetails[typeOfVehicle.slug]|arraySumColWise('totalMileage') * 3.5)|number_format(2,'.','') %}
                                        {% set totalMobileBill = transportTypeConveyanceDetails[typeOfVehicle.slug]|arraySumColWise('totalMobileBill')|number_format(2,'.','')   %}
                                        {% set totalMaintenanceBill = transportTypeConveyanceDetails[typeOfVehicle.slug]|arraySumColWise('totalMaintenanceBill')|number_format(2,'.','') %}
                                        {% set totalServicingBill = transportTypeConveyanceDetails[typeOfVehicle.slug]|arraySumColWise('totalServicingBill')|number_format(2,'.','') %}
                                        {% set totalTollBill = transportTypeConveyanceDetails[typeOfVehicle.slug]|arraySumColWise('totalTollBill')|default(0)|number_format(2,'.','') %}
                                        {% set grandTotalBill = usedReadingBill + totalMobileBill + totalMaintenanceBill + totalServicingBill +totalTollBill %}

                                        <div style="page-break-after: always "></div>

                                        <button type="submit" name="excel" class="btn blue-bg btn-sm white-font pull-right hidden-print" title="Excel" value="excel" id="button-excel-motorcycle"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>

                                        <div class="expense_body print-margin-top-100">
                                            <table data-cols-width="35,25" class="table table-bordered download-excel-motorcycle">
                                                <thead>
                                                <tr class="border-0">
                                                    <td colspan="2" class="text-center border-0" data-a-h="center">
                                                        <h4>Nourish Poultry & Hatchery Ltd.</h4>
                                                    </td>
                                                </tr>
                                                <tr class="border-0">
                                                    <td colspan="2" class="text-center border-0" data-a-h="center">
                                                        <h6>Uttara, Dhaka</h6>
                                                    </td>
                                                </tr>
                                                <tr class="border-0">
                                                    <td colspan="2" class="text-center border-0" data-a-h="center">
                                                        <h6>{{ typeOfVehicle.name }}</h6>
                                                    </td>
                                                </tr>
                                                <tr class="border-0">
                                                    <td colspan="2" class="text-center border-0" data-a-h="center">
                                                        <h6>Month: {{ expenseBatch.expenseMonth|date('F Y') }}</h6>
                                                    </td>
                                                </tr>
                                                <tr class="border-0">

                                                    <td class="border-0">
                                                        <strong>Employee Id:</strong> {{ expenseBatch.employee.userId|default('') }}
                                                    </td>
                                                    <td class="border-0">
                                                        <strong>Designation:</strong> {{ expenseBatch.employee.designation.name|default('') }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="border-0">
                                                        <strong>Name:</strong> {{ expenseBatch.employee.name|default('') }}
                                                    </td>
                                                    <td class="border-0">
                                                        <strong>Station:</strong> {{ expenseBatch.employee.address|default('') }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <th> Particulars</th>
                                                    <th>Amount</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                <tr>
                                                    <td>
                                                        Present Meter Reading
                                                    </td>
                                                    <td>
                                                        {{ presentReading }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Previous Meter Reading
                                                    </td>
                                                    <td>
                                                        {{ previousReading }}

                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Used Reading
                                                    </td>
                                                    <td>
                                                        {{ transportTypeConveyanceDetails[typeOfVehicle.slug]|arraySumColWise('totalMileage')|number_format(0,'.','') }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Used Reading Bill
                                                    </td>
                                                    <td>
                                                        {{ usedReadingBill }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Mobil Bill (After 1000 km)
                                                    </td>
                                                    <td>
                                                        {{ totalMobileBill }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Maintenance Bill (Minimum 1000 km)
                                                    </td>
                                                    <td>
                                                        {{ totalMaintenanceBill }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Servicing Bill (After 2000 km)
                                                    </td>
                                                    <td>
                                                        {{ totalServicingBill }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        Toll Bill
                                                    </td>
                                                    <td>
                                                        {{ totalTollBill }}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td class="text-right">
                                                        Total Bill (Taka)
                                                    </td>
                                                    <td>
                                                        {{ grandTotalBill }}
                                                    </td>
                                                </tr>
                                                </tbody>

                                            </table>
                                        </div>
                                        <table width="100%" class="no-bordered" style="margin-bottom: 20px">
                                            <tr>
                                                <th style="text-align: center; color: #000">{{ expenseBatch.employee.name|default('') }}</th>
                                                <th style="text-align: center; color: #000"></th>
                                                <th style="text-align: center; color: #000"></th>
                                                <th style="text-align: center; color: #000"></th>
                                                <th style="text-align: center; color: #000"></th>
                                                <th style="text-align: center; color: #000"></th>
                                            </tr>
                                            <tr>
                                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Submited by</span></th>
                                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Supervisor/ Authorized Official</span></th>
                                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Junior AGM</span></th>
                                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Senior DGM (S&S)</span></th>
                                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">GM(S&M)</span></th>
                                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Avp (S&M</span></th>
                                            </tr>
                                        </table>

                                    {% endif %}

                                {% elseif typeOfVehicle.slug == 'car' %}

                                    {% if transportTypeConveyanceDetails[typeOfVehicle.slug] is defined and  transportTypeConveyanceDetails[typeOfVehicle.slug] is not empty  %}
                                        <div style="page-break-after: always "></div>
                                        <button type="submit" name="excel" class="btn blue-bg btn-sm white-font pull-right hidden-print" title="Excel" value="excel" id="button-excel-car"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>

                                        <div class="expense_body print-margin-top-100">
                                            <table data-cols-width="8,12,10,10,10,10,15" class="table table-bordered download-excel-car">
                                            <thead>

                                            <tr>
                                                <td colspan="7" class="text-center border-0" data-a-h="center">
                                                    <h4>Nourish Poultry & Hatchery Ltd.</h4>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="7" class="text-center border-0" data-a-h="center">
                                                    <h6>Uttara, Dhaka</h6>
                                                </td>
                                            </tr>
                                            <tr>
