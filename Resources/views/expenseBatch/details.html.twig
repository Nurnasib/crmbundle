{% extends 'admin/layout.html.twig' %}
{% block body %}

    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header hidden-print">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('crm_expense_batch') }}">  {{ 'Expense Batch'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Details'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row hidden-print">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Monthly Expense'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('crm_expense_batch') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Expense Batch'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box ">
                    <div class="portlet-title">
                        <div class="caption">{{'Monthly Expense Details'|trans}} </div>
                        {% if expenseBatch.status>1 %}
                            <div style="float: right; padding-right: 15px" class="caption hidden-print">
                                <div class="pull-right">
                                    <button class="btn btn-info btn-sm" id="windowPrint"><i class="fa fa-print"></i> </button>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <div class="portlet-body form expense_form_section" id="expense_form_section">

                        <div style="text-align: center">
                            <h4>Nourish Poultry & Hatchery Ltd.</h4>
                            <h6>Uttara, Dhaka</h6>
                            <h6>Monthly TA DA Bill</h6>
                            <h6>Month: {{ expenseBatch.expenseMonth|date('F Y') }}</h6>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Name: {{ expenseBatch.employee.name|default('')}}</h6>
                                <h6>Designation: {{ expenseBatch.employee.designation.name|default('')}}</h6>

                            </div>
                            <div class="col-md-6 text-center">
                                <h6>Employee Id: {{ expenseBatch.employee.userId|default('') }}</h6>
                            </div>
                        </div>

                        <table class="table table-bordered">
                            <thead>
                            <tr>
                                <th class="hidden-print">SL</th>
                                <th>Date</th>
                                <th class="hidden-print">Schedule</th>
                                <th>Visiting Area</th>
                                <th>Area</th>
                                <th class="hidden-print">Purpose</th>
                                <th class="hidden-print">Vehicle</th>
                                <th class="hidden-print" title="Riding">Riding (KM)</th>
                                {% if dailyExpenseParticularAttributes is defined and dailyExpenseParticularAttributes is iterable %}
                                    {% for dailyExpenseParticularAttribute in dailyExpenseParticularAttributes %}
                                        <th scope="col">{{ dailyExpenseParticularAttribute.name }}</th>
                                    {% endfor %}
                                {% endif %}
                                <th title="Total">Total (TK.)</th>
                            </tr>
                            </thead>
                            {% if expenseBatch is defined and expenseBatch.expenses is not empty %}
                                <tbody>

                                {% set totalLineTotal=0 %}
                                {% for entity in expenseBatch.expenses %}

                                    {% set lineTotal= expensePaticularAmount['inLine'] is defined? expensePaticularAmount['inLine'][entity.employee.id][entity.id]|arraySumColWise('amount'):'0.00' %}

                                    {% set totalLineTotal=totalLineTotal+lineTotal %}
                                <tr>
                                    <td class="hidden-print">
                                        {{ loop.index }}

                                    </td>
                                    <td>{{ entity.expenseDate|date('d-m-Y') }}</td>
                                    <td class="hidden-print">{{ entity.scheduleVisit }}</td>
                                    <td>{{ entity.visitLocation|default('') }}</td>
                                    <td>{{ entity.workingArea.name|default('') }}</td>
                                    <td class="hidden-print">
                                        {% if entity.purpose is defined and entity.purpose is not empty %}
                                            {% for purpose in entity.purpose %}
                                            {{ purpose.name }}
                                                {% if loop.last == false  %}{{ '; ' }} {% endif%}
                                            {% endfor %}
                                        {% endif%}
                                    </td>
                                    <td class="hidden-print">
                                        {% if entity.vehicle is defined and entity.vehicle is not empty %}
                                            {% for vehicle in entity.vehicle %}
                                            {{ vehicle.name }}
                                                {% if loop.last == false  %}{{ '; ' }} {% endif%}
                                            {% endfor %}
                                        {% endif%}
                                    </td>
                                    <td class="hidden-print">{{ entity.riding|default('') }}</td>

                                    {% if dailyExpenseParticularAttributes is defined and dailyExpenseParticularAttributes is iterable %}
                                        {% for dailyExpenseParticularAttribute in dailyExpenseParticularAttributes %}
                                            <td class="text-right">
                                                {% if expensePaticularAmount['inLine'] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][dailyExpenseParticularAttribute.id]['path'] is not empty%}
                                                    <a title="Attachment Available" href="{{ asset('uploads/expense/'~expensePaticularAmount['inLine'][entity.employee.id][entity.id][dailyExpenseParticularAttribute.id]['path']) }}" download>{{ expensePaticularAmount['inLine'] is defined? expensePaticularAmount['inLine'][entity.employee.id][entity.id][dailyExpenseParticularAttribute.id]['amount']|number_format(2,'.',','):'0.00' }}</a>
                                                {% else %}
                                                    {{ expensePaticularAmount['inLine'] is defined? expensePaticularAmount['inLine'][entity.employee.id][entity.id][dailyExpenseParticularAttribute.id]['amount']|number_format(2,'.',','):'0.00' }}
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    {% endif %}
                                    <th class="text-right">{{ lineTotal|number_format(2,'.',',') }}</th>
                                </tr>
                                {% endfor %}
                            </tbody>
                                <tfoot>
                                    <tr class="text-right">
                                        <th class="text-right hidden show-print" colspan="3">Total</th>
                                        <th class="text-right hidden-print" colspan="8">Total</th>

                                        {% if dailyExpenseParticularAttributes is defined and dailyExpenseParticularAttributes is iterable %}
                                            {% for dailyExpenseParticularAttribute in dailyExpenseParticularAttributes %}
                                                <td class="text-right">{{ expensePaticularAmount['grandTolalPerColumn'] is defined?expensePaticularAmount['grandTolalPerColumn'][dailyExpenseParticularAttribute.id]|arraySumColWise('amount')|number_format(2,'.',','):'0.00' }}</td>
                                            {% endfor %}
                                        {% endif %}
                                        <th>{{ totalLineTotal|number_format(2,'.',',') }}</th>
                                    </tr>
                                    {% set monthlyAttrAmount=0 %}

                                    {% if expenseBatch.expenseParticulars is defined and expenseBatch.expenseParticulars is not empty %}
                                        {% for expenseParticular in expenseBatch.expenseParticulars %}
                                            {% set monthlyAttrAmount=monthlyAttrAmount+ expenseParticular.amount%}
                                            <tr>
                                                <th colspan="{{ dailyExpenseParticularAttributes|length +3 }}" class="text-right hidden show-print">{{ expenseParticular.particular.name|default('') }}</th>
                                                <th colspan="{{ dailyExpenseParticularAttributes|length +8 }}" class="hidden-print text-right">{{ expenseParticular.particular.name|default('') }}</th>
                                                <th class="text-right">{{ expenseParticular.amount|number_format(2,'.',',') }}</th>
                                            </tr>
                                        {% endfor %}

                                    {% endif %}

                                    <tr>
                                        <th colspan="{{ dailyExpenseParticularAttributes|length +3 }}" class="text-right hidden show-print">Bike Miles Amount (Total reading {{ expenseBatch.totalRiding }} KM, Per KM = {{ expenseBatch.perMilesAmount }} Tk.) </th>
                                        <th colspan="{{ dailyExpenseParticularAttributes|length +8 }}" class="text-right hidden-print">Bike Miles Amount (Total reading {{ expenseBatch.totalRiding }} KM, Per KM = {{ expenseBatch.perMilesAmount }} Tk.) </th>
                                        <th class="text-right">{{ expenseBatch.totalMilesAmount|number_format(2,'.',',') }}</th>
                                    </tr>

                                <tr>
                                    <th class="text-right hidden show-print" colspan="{{ dailyExpenseParticularAttributes|length +3 }}">Grand Total</th>
                                    <th colspan="{{ dailyExpenseParticularAttributes|length +8 }}" class="text-right hidden-print">Grand Total</th>
                                    <th class="text-right">{{ (totalLineTotal+monthlyAttrAmount+expenseBatch.totalMilesAmount)|number_format(2,'.',',') }}</th>
                                </tr>
                                </tfoot>
                            {% endif %}

                        </table>
                        {% if expenseBatch.status<2 %}
                            <div class="hidden-print" style="padding-bottom: 20px">
                                <div class="col-md-12 text-right">
                                    <div class="btn-group" role="group" aria-label="Button group with nested dropdown">
                                        <a class="btn btn-sm btn-primary" href="{{ path('crm_expense_batch_approved',{'id':expenseBatch.id}) }}">Approved</a>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        {% endif %}


                    </div>
                </div>

                <style>
                    #expense_form_vehicle .checkbox{
                        width: unset;
                        padding-right: 30px;
                    }
                </style>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
     <style>
         @media print {
             .hidden-print {
                 display: none!important;
             }
             .show-print {
                 display: table-cell!important;
             }
         }
     </style>
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script>
        $('#windowPrint').on('click', function () {
            window.print();
        })
    </script>
{% endblock  %}