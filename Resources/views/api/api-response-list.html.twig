{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        {#<li class="breadcrumb-item"> <a href="{{ path('crm_chick') }}">  {{ 'Chick Life Cycle'|trans }}</a></li>#}
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'API Response List'|trans }}</h5>
                    <div class="btn-group btn-group-sm float-right">
{#                        {% if countVisit > 0 %}
                            <a href="{{ path('crm_sync_app_data_crm_visit') }}" class="btn purple-bg white-font"><i class="fa fa-sync"></i> Sync Visit</a>
                        {% elseif(countVisitDetails > 0 and countVisit == 0) %}
                            <a href="{{ path('crm_sync_app_data_crm_visit_details') }}" class="btn blue-bg white-font"><i class="fa fa-sync"></i> Sync Visit Details</a>

                        {% endif %}#}
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-block">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="thead-dark">
                        <tr>

                            <th>{{ 'S/N'|trans }}</th>
                            <th>{{ 'Process'| trans }}</th>
                            <th>{{ 'Device Id'| trans }}</th>
                            <th>{{ 'Status'| trans }}</th>
                            <th class=" text-center"><i class="feather icon-settings"></i></th>

                        </tr>
                        </thead>
                        <tbody>
                        {% if records is not empty and records is iterable %}
                            {% for record in records %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td>{{ record.process|replace({'_': ' '})|capitalize|default('') }}</td>
                                    <td>{{ record.batchNo|default('') }}</td>
                                    <td>{{ record.status == 1 ? 'Yes':'No' }}</td>
                                    <td align="right">
                                        {% if record.status == 0 %}
                                            <a class="btn btn-mini white-font {% if countVisit == 0 and countVisitDetails == 0 %} green-bg {% else %} bg-secondary {% endif %}"
                                               href="{{ path('insert_json_data', {'id': record.id}) }}"
                                                    {% if countVisit > 0 or countVisitDetails > 0 %} style="pointer-events: none; cursor: default;" {% endif %}>
                                                <i class="feather icon-upload"></i> Migrate
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                        </tbody>
                    </table>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="count">
                                Total Records: {{ records.getTotalItemCount }}
                            </div>
                        </div>
                        <div class="col-md-9 navigation" style="padding-right: 0;">
                            {{ knp_pagination_render(records) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
{% block cssBlock %}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
        .pagination{
            float: right;
        }
    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}
