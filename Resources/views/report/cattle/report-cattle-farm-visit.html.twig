{% extends 'admin/layout.html.twig' %}

{% block body %}
{#    {{ dump(entities) }}#}

<div class="row">
    <div class="col">
        <div class="card">
            <div class="card-header p-3">
                <h5>{{ 'Weekly Cattle Farm Visit Report'|trans }}</h5>
                {% if entities is not empty %}
                    <div class="btn-group btn-group-sm float-right" role="group" aria-label="Button group with nested dropdown">
                        <a target="_blank" href="/en/crm/chick/27/report/pdf" class="btn blue-bg white-font btn-sm"><i class="fa fa-file-pdf"></i> PDF</a>
                        <a target="_blank" href="/en/crm/chick/27/report/excel" class="btn btn-sm bg-primary white-font"><i class="fa fa-file-excel"></i> Excel</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col">
        <div class="card">
            <div class="card-body p-1">
                {{ form_start(searchForm) }}
                <table class="table table-borderd m-0">
                    <thead class="thead-dark">
                    <tr>
                        <th>
                            {{ form_label(searchForm.startDateCreated, 'Beginning of Month:') }}
                            {{ form_widget(searchForm.startDateCreated, {'id':'start-date'}) }}
                        </th>
                        <th>
                            {{ form_label(searchForm.endDateCreated, 'End of Month:') }}
                            {{ form_widget(searchForm.endDateCreated, {'id':'end-date'}) }}
                        </th>
                        <th>
                            {{ form_label(searchForm.employee, 'Select Employee:') }}
                            {{ form_widget(searchForm.employee) }}
                        </th>
                        <th>
                            {{ form_label(searchForm.filter, '') }}
                            {{ form_widget(searchForm.filter) }}
                        </th>
                    </tr>
                    </thead>
                </table>
{#                                    {{ form_end(searchForm) }}#}
            </div>
        </div>
    </div>
</div>
    {% if entities is not empty %}
        <div class="row">
            <div class="col">
                <div class="card" style="overflow-x: scroll">
                    <div class="card-body">
                        <h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3>
                        <h5 class="text-center">UTTARA, DHAKA.</h5>
                        <h6 class="text-center">Cattle Farm Visit Report</h6>
                        <table class="table table-borderd">
                            <thead class="thead-dark">
                            <tr>
                                <th>Name of CSO: {{ entities[0].employeeName|default('N/A') }}</th>
                                <th> Region: {{ entities[0].customerDistrict|default('N/A') }}</th>
                                <th class="text-right">Month: {{ entities[0].visitingDate|date('F-Y') }}</th>
                            </tr>
                            </thead>
                        </table>
                        <table class="table table-striped table-bordered table-hover" id="datatable">
                            <thead class="thead-dark">
                            <tr>
                                <th scope="col" rowspan="2" style="text-align: center">Visiting Date</th>
                                <th scope="col" rowspan="2" style="text-align: center">Name of Farm</th>
                                <th scope="col" rowspan="2" style="text-align: center">Name of Farmer(Contact Person)</th>
                                <th scope="col" rowspan="2" style="text-align: center">Mobile No.</th>
                                <th scope="col" colspan="3" style="text-align: center">Address</th>
                                <th scope="col" colspan="3" style="text-align: center">Cattle Population</th>
                                <th scope="col" rowspan="2" style="text-align: center">Avg Milk Yield(Ltr.) per day</th>
                                <th scope="col" rowspan="2" style="text-align: center">Conception Rate(%)</th>
                                <th scope="col" colspan="2" style="text-align: center">Fodder(Yes/No)</th>
                                <th scope="col" rowspan="2" style="text-align: center">Type of Concentrate Feed</th>
                                <th scope="col" colspan="2" style="text-align: center">Market Price</th>
                                <th scope="col" rowspan="2" style="text-align: center">Comment</th>
                            </tr>

                            <tr>
                                <th scope="col" style="text-align: center">Village</th>
                                <th scope="col" style="text-align: center">Upazila</th>
                                <th scope="col" style="text-align: center">District</th>
                                <th scope="col" style="text-align: center">Ox</th>
                                <th scope="col" style="text-align: center">Cow</th>
                                <th scope="col" style="text-align: center">Calf</th>
                                <th scope="col" style="text-align: center">Green Grass</th>
                                <th scope="col" style="text-align: center">Straw</th>
                                <th scope="col" style="text-align: center">Milk(per liter)</th>
                                <th scope="col" style="text-align: center">Meat(per kg)</th>
                            </tr>
                            </thead>

                            <tbody>
                            {% for entity in entities %}
                                <tr>
                                    <td>{{ entity.visitingDate|date('d-m-Y') }}</td>
                                    <td>{{ entity.customerName|default('N/A') }}</td>
                                    <td>{{ entity.customerName|default('N/A') }}</td>
                                    <td>{{ entity.customerMobile|default('N/A') }}</td>
                                    <td>{{ entity.customerAddress|default('N/A') }}</td>
                                    <td>{{ entity.customerUpazila|default('N/A') }}</td>
                                    <td>{{ entity.customerDistrict|default('N/A') }}</td>
                                    <td>{{ entity.cattlePopulationOx|default('N/A') }}</td>
                                    <td>{{ entity.cattlePopulationCow|default('N/A') }}</td>
                                    <td>{{ entity.cattlePopulationCalf|default('N/A') }}</td>
                                    <td>{{ entity.avgMilkYieldPerDay|default('N/A') }}</td>
                                    <td>{{ entity.conceptionRate|default('N/A') }}</td>
                                    <td>{{ entity.fodderGreenGrassKg|default('N/A') }}</td>
                                    <td>{{ entity.fodderStrawKg|default('N/A') }}</td>
                                    <td>{{ entity.typeOfConcentrateFeed|default('N/A') }}</td>
                                    <td>{{ entity.marketPriceMilkPerLiter|default('N/A') }}</td>
                                    <td>{{ entity.marketPriceMeatPerKg|default('N/A') }}</td>
                                    <td>{{ entity.comments|default('N/A') }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}
{% block documentready %}
    {{ parent() }}

    $('#start-date').datepicker(
    {
    dateFormat: 'yy-mm-dd'
    }
    );
    $('#end-date').datepicker(
    {
    dateFormat: 'yy-mm-dd'
    }
    );

    $('#datatable').DataTable( {
    "pageLength": 25,
    "ordering": false,
    "order": [[ 2, "desc" ]],
    'columnDefs': [ {
    'targets': [0,4,5,6,12],
    'orderable': false
    }],
    "responsive": false,
    "scrollX": true
    });
{% endblock %}