                                    <td valign="middle" rowspan="{{ loop.index==1?monthDetail.crmChickLifeCycleDetails|length:0 }}">{{ monthDetail.hatchery.name|default('N/A') }}</td>
                                {% endif %}
                                {% if loop.index==1 %}
                                    <td valign="middle" rowspan="{{ loop.index==1?monthDetail.crmChickLifeCycleDetails|length:0 }}">{{ monthDetail.breed.name|default('N/A') }}</td>
                                {% endif %}
                                {% if loop.index==1 %}
                                    <td valign="middle" rowspan="{{ loop.index==1?monthDetail.crmChickLifeCycleDetails|length:0 }}">{{ monthDetail.freed.name|default('N/A') }}</td>
                                {% endif %}
                                <td>{{ monthDetail.freed.settingType|default('N/A') }}</td>
                                <td>{{ detail.proDate|date('d-m-Y') }}</td>
                                <td>{{ detail.batchNo|default('N/A') }}</td>
                                <td>{{ detail.remarks|default('N/A') }}</td>
                            </tr>
                        {% endfor %}
                    {% endfor %}#}
                    </tbody>
                </table>
            {% endif %}
        {% endfor %}
    {% endif %}
{% endblock %}