{% extends 'base-pdf.html.twig' %}

{% block body %}
    {% if entities is not empty%}
        <div style="text-align: center; margin: 0; padding: 0">
            <p class="title-h4">NOURISH POULTRY AND HATCHERY LTD</p>
            <p class="title-h5">UTTARA, DHAKA.</p>
            <p class="title-h6">{{ entities['life_cycle']|upper}} LIFE CYCLE REPORT</p>
        </div>
        <table class="table table-borderd">
            <thead class="thead-dark">
            <tr>
                <th style="text-align: left">Officer's Name: {{ entities['officer_name'] }}</th>
                <th style="text-align: left">Region: {{ entities['officer_region'] }}</th>
            </tr>
            </thead>
        </table>
        {% for month, entity in entities %}
            {% if entity is iterable %}
                <button type="button">{{ month }}</button>
                <table  border="1" cellpadding="0" cellspacing="0">
                    <thead class="thead-dark">
                    <tr>
                        <th scope="col" colspan="2" style="text-align: center">Agent</th>
                        <th scope="col" colspan="3" style="text-align: center">Farmer</th>
                        <th scope="col" rowspan="2">H.Date</th>
                        <th scope="col" rowspan="2" >VisitingWeek</th>
                        <th scope="col" rowspan="2">Total Birds</th>
                        <th scope="col" rowspan="2">Age (Day)</th>
                        <th scope="col" colspan="2" style="text-align: center">Mortality</th>
                        <th scope="col" colspan="2" style="text-align: center">Weight (gm)</th>
                        <th scope="col" colspan="3" style="text-align: center">Feed Consumtion</th>
                        <th scope="col" colspan="2" style="text-align: center">F.C.R</th>
                        <th scope="col" rowspan="2">Hatchery</th>
                        <th scope="col" rowspan="2">Breed</th>
                        <th scope="col" rowspan="2">Freed</th>
                        <th scope="col" rowspan="2">Freed Type</th>
                        <th scope="col" rowspan="2">Pro. Date</th>
                        <th scope="col" rowspan="2">Batch No.</th>
                        <th scope="col" rowspan="2">Remarks</th>
                    </tr>

                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Address</th>
                        <th scope="col">Name</th>
                        <th scope="col">Address</th>
                        <th scope="col">Mobile</th>
                        <th scope="col">Pes</th>
                        <th scope="col">%</th>
                        <th scope="col">Standard</th>
                        <th scope="col">Achieved</th>
                        <th scope="col">Total (kg)</th>
                        <th scope="col">Per Bird (gm)</th>
                        <th scope="col">Standard</th>
                        <th scope="col">Without M</th>
                        <th scope="col">With M</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for monthDetail in entity %}
                        {% for detail in monthDetail.crmChickLifeCycleDetails %}
                            <tr>
                                <td valign="middle">{{ monthDetail.customer.agent.name|default('') }}</td>
                                <td valign="middle">{{ monthDetail.customer.agent.address|default('') }}</td>
                                <td valign="middle">{{ monthDetail.customer.name|default('') }}</td>
                                <td valign="middle">{{ monthDetail.customer.address|default('') }}</td>
                                <td valign="middle">{{ monthDetail.customer.mobile|default('') }}</td>
                                <td valign="middle">{{ monthDetail.hatchingDate|date('d-m-Y') }}</td>
                                <td>{{ detail.visitingWeek|default('N/A') }}</td>
                                <td>{{ detail.totalBirds|default(0) }}</td>
                                <td>{{ detail.ageDays|default(0) }}</td>
                                <td>{{ detail.mortalityPes|default(0) }}</td>
                                <td>{{ detail.mortalityPercent|default(0) }}</td>
                                <td>{{ detail.weightStandard|default(0) }}</td>
                                <td>{{ detail.weightAchieved|default(0) }}</td>
                                <td>{{ detail.feedTotalKg|default(0) }}</td>
                                <td>{{ detail.perBird|default(0) }}</td>
                                <td>{{ detail.feedStandard|default(0) }}</td>
                                <td>{{ detail.withoutMortality|default(0) }}</td>
                                <td>{{ detail.withMortality|default(0) }}</td>
                                <td valign="middle">{{ monthDetail.hatchery.name|default('N/A') }}</td>
                                <td valign="middle">{{ monthDetail.breed.name|default('N/A') }}</td>
                                <td valign="middle">{{ monthDetail.freed.name|default('N/A') }}</td>
                                <td>{{ monthDetail.freed.settingType|default('N/A') }}</td>
                                <td>{{ detail.proDate|date('d-m-Y') }}</td>
                                <td>{{ detail.batchNo|default('N/A') }}</td>
                                <td>{{ detail.remarks|default('N/A') }}</td>
                            </tr>
                        {% endfor %}
                    {% endfor %}




