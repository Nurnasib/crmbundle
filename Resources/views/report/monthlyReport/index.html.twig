            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }
/*        table.filter thead th{
            border: 0 !important;
        }*/
        .btn-xs{
            padding: 0.25rem;
            font-size: 0.80rem;
            line-height: 1;
            color: #FFFFFF!important;
        }

    </style>

{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>

    <script>
        $("#search_filter_form_employee").on('change', function () {
            var employeeId = $(this).val();
            if(employeeId==''){
                return false;
            }
            $.ajax({
                url: Routing.generate('get_farmer_by_employee_location',{'id':employeeId}),
                type: 'post',
                dataType: 'json',
                success: function (res) {
                    console.log(res)
                    $("#search_filter_form_employeeWiseFarmer").find('option').remove();
                    $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:'', text:'Select Farmer'}));
                    $.each(res, function (id, name) {
                        $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:id, text:name}))
                    })
                }
            })
        })

        $('#start-date, #end-date').datepicker(
            {
                changeMonth: true,
                changeYear: true,
                yearRange: "2020:" + new Date().getFullYear(),
                dateFormat: 'dd-mm-yy'
            }
        );

        let button = document.querySelector("#button-excel");

        if(button){
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "{{ report is defined and report is not null ? report.slug : ''}} ({{ filterBy['startDate'] is defined ? filterBy['startDate']:'' }} {{ filterBy['endDate'] is defined ? ' to '~filterBy['endDate']:'' }}).xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }

        $(document).on('click', '.record_delete', function (event) {
            event.preventDefault();
            var url = $(this).attr('data-action');
            var formData=new FormData($('form#search_filter_form')[0]);
            /*var reportId= $('#search_filter_form_monthlyReport').val();
            console.log(reportId);*/
            $.MessageBox({
                buttonFail  : "No",
                buttonDone  : "Yes",
                message     : "Are you sure want to delete this record?"
            }).done(function(){
                /*$.get(url, {name:'Steve'}, function( data ) {
                    $(event.target).closest('tr').hide();
                });*/
                $.ajax({
                    url         :url,
                    type        : 'post',
                    data        : formData,
                    processData : false,
                    contentType : false,
                    beforeSend: function(){
                        $('.loader-double').fadeIn(1000).addClass('is-active');
                    },
                    complete: function(){
                        $('.loader-double').fadeIn(1000).removeClass('is-active');
                    },
                    success: function(response){
                        console.log(response);
                        $('#data-load').html(response);
                    }
                });
            });
        });

    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}