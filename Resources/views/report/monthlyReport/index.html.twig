{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
{#        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="javascript:void(0)">  {{ 'Monthly Report'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>#}
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->

        <div class="row">
            <div class="col p-0">
                <table class="table">
                    <thead class="thead-dark">
                    {{ form_start(form) }}
                    <tr>
                        <th style="min-width: 300px">
                            {{ form_label(form.monthlyReport, 'Report:', { 'label_attr': {'class': 'col-md-3 text-right'} })}}
                            <div class="col-md-9 p-0">
                                {{ form_widget(form.monthlyReport) }}
                            </div>
                        </th>
                        <th style="min-width: 200px">
                        <div class="form-group">
                            {{ form_label(form.employee, 'Employee:', { 'label_attr': {'class': 'col-md-4 text-right'} })}}
                            <div class="col-md-8 p-0">
                            {{ form_widget(form.employee) }}
                            </div>
                        </div>
                        </th>
                        <th>
                            {{ form_label(form.startDate, 'Start Date:', { 'label_attr': {'class': 'col-md-4 text-right'} }) }}
                            <div class="col-md-8 p-0">
                            {{ form_widget(form.startDate,{'id':'start-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                            </div>
                        </th>
                        <th>
                            {{ form_label(form.endDate, 'End Date:', { 'label_attr': {'class': 'col-md-4 text-right'} }) }}
                            <div class="col-md-8 p-0">
                            {{ form_widget(form.endDate,{'id':'end-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                            </div>
                        </th>
{#                        <th></th>#}
                    </tr>
                    <tr>
                        <th>
                            {{ form_label(form.region, 'Region:', { 'label_attr': {'class': 'col-md-3 text-right'} }) }}
                            <div class="col-md-9 p-0">
                            {{ form_widget(form.region) }}
                            </div>
                        </th>
                        {#<th>
                            {{ form_label(form.zone, 'Zone:') }}
                            {{ form_widget(form.zone) }}
                        </th>#}
                        <th>
                            {{ form_label(form.feedMill, 'Feed Mill:', { 'label_attr': {'class': 'col-md-4 text-right'} }) }}
                            <div class="col-md-8 p-0">
                            {{ form_widget(form.feedMill) }}
                            </div>
                        </th>
                        <th>
                            {{ form_label(form.breed, 'Breed:', { 'label_attr': {'class': 'col-md-4 text-right'} }) }}
                            <div class="col-md-8 p-0">
                            {{ form_widget(form.breed) }}
                            </div>
                        </th>
                        <th>
                            <div class="btn-group float-right">
                                {{ form_widget(form._token) }}
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('monthly_report_index') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    {% set filterBy = filterBy|merge({"lifeCycle" : reportSlug}) %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
{#                                    <a target="_blank" href="{{ path('life_cycle_pdf', {filterBy: filterBy}) }}" class="btn blue-bg btn-sm white-font"><i class="fa fa-download" aria-hidden="true"></i> {{ 'PDF'|trans }}</a>#}
{#                                    <a target="_blank" href="{{ path('life_cycle_excel', {filterBy: filterBy}) }}" class="btn blue-bg btn-sm white-font"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</a>#}
                                {% endif %}
                            </div>
                        </th>
{#                        <th></th>#}
                    </tr>
                    </form>
                    </thead>
                </table>
            </div>
        </div>
        {% if entities is defined and entities is not empty %}
            <div class="row">
                <div class="card" style="overflow-x: scroll; max-height: 75vh">
                    <div class="card-body p-0">
                        {% if reportSlug is same as 'fcr-before-sale-boiler' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_broiler_before.html.twig'%}

                        {% elseif reportSlug is same as 'fcr-after-sale-boiler' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_broiler_after.html.twig'%}

                        {% elseif reportSlug is same as 'fcr-before-sale-sonali' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_sonali_before.html.twig'%}

                        {% elseif reportSlug is same as 'fcr-after-sale-sonali' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_sonali_after.html.twig'%}

                        {% elseif reportSlug in ['layer-performance-brown','layer-performance-white'] %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_layer_performance.html.twig'%}

                        {% elseif reportSlug is same as 'antibiotic-free-farm-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_antibiotic_free_farm.html.twig'%}

                        {% elseif reportSlug is same as 'less-costing-farm-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_less_costing_farm.html.twig'%}

                        {% elseif reportSlug is same as 'less-costing-farm-fish' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/fish/_less_costing_farm.html.twig'%}

                        {% elseif reportSlug is same as 'disease-mapping-report-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_disease_mapping.html.twig'%}

                        {% elseif reportSlug is same as 'disease-mapping-report-cattle' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/cattle/_disease_mapping.html.twig'%}

                        {% elseif reportSlug is same as 'disease-mapping-report-fish' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/fish/_disease_mapping.html.twig'%}

                        {% elseif reportSlug is same as 'farmer-introduce-report-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_farmer_introduce.html.twig'%}

                        {% elseif reportSlug is same as 'farmer-introduce-report-fish' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/fish/_farmer_introduce.html.twig'%}

                        {% elseif reportSlug is same as 'farmer-introduce-report-cattle' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/cattle/_farmer_introduce.html.twig'%}

                        {% elseif reportSlug in ['company-species-wise-average-fcr-before','company-species-wise-average-fcr-after'] %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/fish/_company_species_average_fcr.html.twig'%}

                        {% elseif reportSlug in ['fattening-performance-report'] %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/cattle/_fattening_performance.html.twig'%}

                        {% elseif reportSlug in ['dairy-performance-report'] %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/cattle/_dairy_performance.html.twig'%}

                        {% elseif reportSlug is same as 'cattle-farm-visit-report' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/cattle/_farm_visit.html.twig'%}

                        {% endif %}

                    </div>
                </div>
            </div>
        {% endif %}





        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
/*        table.filter-result thead {
            position: sticky;
            top: -1px;
            background-color: #dbdee3 !important;
            border-bottom: 2px solid #4C9EE7!important;
        }*/
        table thead tr.data-header th{

            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }
/*        table.filter thead th{
            border: 0 !important;
        }*/
    </style>

{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>

    <script>
        $("#search_filter_form_employee").on('change', function () {
            var employeeId = $(this).val();
            $.ajax({
                url: Routing.generate('get_farmer_by_employee_location',{'id':employeeId}),
                type: 'post',
                dataType: 'json',
                success: function (res) {
                    console.log(res)
                    $("#search_filter_form_employeeWiseFarmer").find('option').remove();
                    $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:'', text:'Select Farmer'}));
                    $.each(res, function (id, name) {
                        $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:id, text:name}))
                    })
                }
            })
        })

        $('#start-date, #end-date').datepicker(
            {
                changeMonth: true,
                changeYear: true,
                yearRange: "2020:" + new Date().getFullYear(),
                dateFormat: 'dd-mm-yy'
            }
        );

        let button = document.querySelector("#button-excel");

        button.addEventListener("click", e => {
            e.preventDefault();
            let table = document.querySelector(".download-excel");
            TableToExcel.convert(table, {
                name: "{{ report is defined and report is not null ? report.slug : ''}} ({{ filterBy['startDate'] is defined ? filterBy['startDate']:'' }} {{ filterBy['endDate'] is defined ? ' to '~filterBy['endDate']:'' }}).xlsx",
                sheet: {
                    name: "Sheet 1"
                }
            });
        });
    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}