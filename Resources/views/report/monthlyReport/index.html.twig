{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="javascript:void(0)">  {{ 'Monthly Report'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Monthly Report'|trans }}</h5>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <table class="table ">
                    <thead class="thead-dark">
                    {{ form_start(form) }}
                    <tr>
                        <th style="min-width: 200px">
                            {{ form_label(form.monthlyReport, 'Report:') }}
                            {{ form_widget(form.monthlyReport) }}
                        </th>
                        <th style="min-width: 200px">
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                        </th>
                        <th>
                            {{ form_label(form.startDate, 'Start Date:') }}
                            {{ form_widget(form.startDate,{'id':'start-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                        </th>
                        <th>
                            {{ form_label(form.endDate, 'End Date:') }}
                            {{ form_widget(form.endDate,{'id':'end-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                        </th>
                        <th>
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('life_cycle_report_index') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    {% set filterBy = filterBy|merge({"lifeCycle" : lifeCycleSlug}) %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
{#                                    <a target="_blank" href="{{ path('life_cycle_pdf', {filterBy: filterBy}) }}" class="btn blue-bg btn-sm white-font"><i class="fa fa-download" aria-hidden="true"></i> {{ 'PDF'|trans }}</a>#}
{#                                    <a target="_blank" href="{{ path('life_cycle_excel', {filterBy: filterBy}) }}" class="btn blue-bg btn-sm white-font"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</a>#}
                                {% endif %}
                            </div>
                        </th>
                    </tr>
                    </form>
                    </thead>
                </table>
            </div>
        </div>
        {% if entities is defined and entities is not empty %}
            <div class="row">
                <div class="card" style="overflow-x: scroll">
                    <div class="card-block">
                        {#<h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3>
                        <h5 class="text-center">UTTARA, DHAKA.</h5>
                        <h6 class="text-center">{{ lifeCycleSlug|replace({'-': ' '})|upper }}</h6>
                        #}
                        {% if lifeCycleSlug is same as 'fcr-before-sale-boiler' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_broiler_before.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'fcr-after-sale-boiler' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_broiler_after.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'fcr-before-sale-sonali' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_sonali_before.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'fcr-after-sale-sonali' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/_fcr_sonali_after.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'layer-performance-brown' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_layer_performance.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'layer-performance-white' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_layer_performance.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'antibiotic-free-farm-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_antibiotic_free_farm.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'less-costing-farm-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_less_costing_farm.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'less-costing-farm-fish' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/fish/_less_costing_farm.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'disease-mapping-report-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_disease_mapping.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'disease-mapping-report-cattle' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/cattle/_disease_mapping.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'disease-mapping-report-fish' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/fish/_disease_mapping.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'farmer-touch-report-poultry' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/poultry/_farmer_introduce.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'farmer-touch-report-fish' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/fish/_farmer_introduce.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'farmer-touch-report-cattle' %}
                            {% include '@TerminalbdCrm/report/monthlyReport/inc/cattle/_farmer_introduce.html.twig'%}
                        {% elseif lifeCycleSlug is same as 'dairy-life-cycle' %}
                        {% elseif lifeCycleSlug is same as 'fattening-life-cycle' %}
                        {% elseif lifeCycleSlug is same as 'fish-life-cycle-report' %}
                        {% elseif lifeCycleSlug is same as 'fish-life-cycle-after-sale-report' %}
                        {% endif %}

                    </div>
                </div>
            </div>
        {% endif %}





        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script>
        $("#search_filter_form_employee").on('change', function () {
            var employeeId = $(this).val();
            $.ajax({
                url: Routing.generate('get_farmer_by_employee_location',{'id':employeeId}),
                type: 'post',
                dataType: 'json',
                success: function (res) {
                    console.log(res)
                    $("#search_filter_form_employeeWiseFarmer").find('option').remove();
                    $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:'', text:'Select Farmer'}));
                    $.each(res, function (id, name) {
                        $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:id, text:name}))
                    })
                }
            })
        })

        $('#start-date, #end-date').datepicker(
            {
                changeMonth: true,
                changeYear: true,
                yearRange: "2020:" + new Date().getFullYear(),
                dateFormat: 'dd-mm-yy'
            }
        );
    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}