{% if entities is not empty %}
    {% for monthYear, employeesDetails in entities %}
        {% for employeeId, details in employeesDetails %}
            <table class="table table-striped table-bordered table-hover download-excel">
                <thead class="thead-dark" style="background-color: #dbdee3">
                <tr>
                    <th colspan="11" class="border-0" data-a-h="center"><h3 class="text-center">NOURISH POULTRY AND
                            HATCHERY LTD</h3></th>
                </tr>
                <tr>
                    <th colspan="11" class="border-0" data-a-h="center"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                </tr>
                <tr>
                    <th colspan="11" class="border-0" data-a-h="center"><h6
                                class="text-center">{{ report.name|default('') }}</h6></th>
                </tr>
                <tr>
                    <th colspan="4" class="border-0"><h5>{{ 'Name Of CSO' }}
                            : {{ entities[monthYear][employeeId]['name'] }}</h5></th>
                    <th colspan="4" class="border-0 text-center"><h5>{{ 'Designation' }}
                            : {{ entities[monthYear][employeeId]['employeeDesignationName'] }}</h5></th>
                    <th colspan="3" class="border-0 text-right"><h5>{{ 'Month' }}: {{ monthYear }}</h5></th>
                </tr>

                <tr style="position: sticky; top: -1px; background-color: #dbdee3" class="data-header">
                    <th>{{ 'SL'|trans }}</th>
                    <th>{{ 'Visting Date'|trans }}</th>
                    <th>{{ 'Name of Farmer'|trans }}</th>
                    <th>{{ 'Address'|trans }}</th>
                    <th>{{ 'Mobile No.'|trans }}</th>
                    <th>{{ 'Hatchery'|trans }}</th>
                    <th>{{ 'Feed'|trans }}</th>
                    <th>{{ 'Type of Birds'|trans }}</th>
                    <th>{{ 'Flock Size'|trans }}</th>
                    <th>{{ 'Age'|trans }}</th>
                    <th>{{ 'Presumptive Diagnosis'|trans }}</th>
                </tr>

                </thead>
                <tbody>
                {% for detail in details['details'] %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td data-t="s">{{ detail['visitingDate']|date('d-M-Y') }}</td>
                        <td>{{ detail['customerName']|default('') }}</td>
                        <td>{{ detail['customerAddress']|default('') }}</td>
                        <td data-t="s">{{ detail['customerMobile']|default('') }}</td>
                        <td>{{ detail['hatcheryName']|default('') }}</td>
                        <td>{{ detail['feedName']|default('') }}</td>
                        <td>{{ detail['feedTypeName']|default('') }}</td>
                        <td data-t="n">{{ detail['flockSizeOrCapacity']|default('') }}</td>
                        <td data-t="n">{{ detail['ageDays']|default('') }}</td>
                        <td>{{ detail['diseaseName']|default('') }}</td>
                        {#                        <td>{{ detail['remarks']|default('') }}</td>#}
                    </tr>
                {% endfor %}

                </tbody>
            </table>

        {% endfor %}
    {% endfor %}
{% endif %}
