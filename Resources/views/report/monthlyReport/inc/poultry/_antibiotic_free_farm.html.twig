{% if entities is not empty %}
    {% for employeeId, employeesDetails in entities %}

        <table width="100%">
            <tr>
                <th colspan="26"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
            </tr>
            <tr>
                <th colspan="26"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
            </tr>
            <tr>
                <td colspan="26" align="center"><h6>{{ report.name|default('') }}</h6></td>
            </tr>
        </table>
        <table width="100%">
            <tr>
                <th colspan="13"><h5>{{ 'Name Of CSO' }}: {{ entities[employeeId]['name'] }}</h5></th>
                <th colspan="13" class="text-center"><h5>{{ 'Designation' }}
                        : {{ entities[employeeId]['employeeDesignationName'] }}</h5></th>
{#                <th colspan="8" class="text-right"><h5>{{ 'Month' }}: {{ monthYear }}</h5></th>#}
            </tr>
        </table>

        <table class="table table-striped table-bordered table-hover" id="datatable">
            <thead class="thead-dark">
            <tr>
                <th scope="col" rowspan="2" class="text-center">Month</th>
                <th scope="col" rowspan="2" class="text-center">SL No.</th>
                <th scope="col" colspan="3" class="text-center">Agent Information</th>
                <th scope="col" colspan="3" class="text-center">Farmer Information</th>
                <th scope="col" colspan="3" class="text-center">DOC Information</th>
                <th scope="col" colspan="6" class="text-center">Flock Details</th>
                <th scope="col" colspan="3" class="text-center">Cost Details (Total)</th>
                <th scope="col" colspan="3" class="text-center">Cost Details (Per Bird)</th>
                <th scope="col" colspan="3" class="text-center">Cost Details (Per kg)</th>
            </tr>
            <tr>
                <th scope="col">Agent Name</th>
                <th scope="col">Address</th>
                <th scope="col">Mobile</th>

                <th scope="col">Farmer Name</th>
                <th scope="col">Address</th>
                <th scope="col">Mobile</th>

                <th scope="col">Hatch Date</th>
                <th scope="col">Hatchery</th>
                <th scope="col">Breed</th>

                <th scope="col">Total Chicks (Pcs)</th>
                <th scope="col">Total Feed (Kg)</th>
                <th scope="col">Total Broiler Wt (Kg)</th>
                <th scope="col">Mortality (Pcs)</th>
                <th scope="col">Age (days)</th>
                <th scope="col">FCR</th>

                <th scope="col">Medicine Cost (Total)</th>
                <th scope="col">Vaccine Cost (Total)</th>
                <th scope="col">M & V Cost (Total)</th>

                <th scope="col">Medicine Cost/Bird</th>
                <th scope="col">Vaccine Cost/Bird</th>
                <th scope="col">M & V Cost/Bird</th>

                <th scope="col">Medicine Cost/kg</th>
                <th scope="col">Vaccine Cost/kg</th>
                <th scope="col">M & V Cost/kg</th>
            </tr>

            </thead>
            <tbody>
            {% for monthYear,details in employeesDetails['details'] %}
                {% for detail in details %}
                    {% set totalStockedChicksPcs = detail['totalStockedChicksPcs']|default(0) %}
                    {% set totalBroilerWeightKg = detail['totalBroilerWeightKg']|default(0) %}
                    {% set medicineCost = detail['medicineTotalCost']|default(0) %}
                    {% set vaccineCost = detail['vaccineTotalCost']|default(0) %}
                    {% set medicineAndVaccineCost = medicineCost+vaccineCost %}
                    {% set medicineCostPerBird = totalStockedChicksPcs>0?(medicineCost/totalStockedChicksPcs):0 %}
                    {% set vaccineCostPerBird = totalStockedChicksPcs>0?(vaccineCost/totalStockedChicksPcs):0 %}
                    {% set medicineAndVaccineCostPerBird = totalStockedChicksPcs>0?(medicineAndVaccineCost/totalStockedChicksPcs):0 %}

                    {% set medicineCostPerKg = totalBroilerWeightKg>0?(medicineCost/totalBroilerWeightKg):0 %}
                    {% set vaccineCostPerKg = totalBroilerWeightKg>0?(vaccineCost/totalBroilerWeightKg):0 %}
                    {% set medicineAndVaccineCostPerKg = totalBroilerWeightKg>0?(medicineAndVaccineCost/totalBroilerWeightKg):0 %}
                    <tr>
                        {% if loop.first %}
                            <td valign="middle"
                                rowspan="{{ details|length }}">{{ monthYear }}</td>
                        {% endif %}
{#                        <td>{{ monthYear }}</td>#}
                        <td>{{ loop.index }}</td>
                        <td>{{ detail['agentName']|default('') }}</td>
                        <td>{{ detail['agentAddress']|default('') }}</td>
                        <td>{{ detail['agentMobile']|default('') }}</td>

                        <td>{{ detail['customerName']|default('') }}</td>
                        <td>{{ detail['customerAddress']|default('') }}</td>
                        <td>{{ detail['customerMobile']|default('') }}</td>

                        <td>{{ detail['hatchingDate']|date('d-m-Y') }}</td>
                        <td>{{ detail['hatcheryName']|default('') }}</td>
                        <td>{{ detail['breedBame']|default('') }}</td>

                        <td>{{ detail['totalStockedChicksPcs']|default(0) }}</td>
                        <td>{{ detail['totalFeedUsedKg']|default(0) }}</td>
                        <td>{{ detail['totalBroilerWeightKg']|default(0) }}</td>
                        <td>{{ detail['mortality']|default(0) }}</td>
                        <td>{{ detail['ageDays']|default(0) }}</td>
                        <td>{{ detail['fcr']|default(0)|number_format(2,'.','') }}</td>

                        <td>{{ detail['medicineTotalCost']|default(0)|number_format(2,'.','') }}</td>
                        <td>{{ detail['vaccineTotalCost']|default(0)|number_format(2,'.','') }}</td>
                        <td>{{ medicineAndVaccineCost|number_format(2,'.','') }}</td>

                        <td>{{ medicineCostPerBird|number_format(2,'.','') }}</td>
                        <td>{{ vaccineCostPerBird|number_format(2,'.','') }}</td>
                        <td>{{ medicineAndVaccineCostPerBird|number_format(2,'.','') }}</td>

                        <td>{{ medicineCostPerKg|number_format(2,'.','') }}</td>
                        <td>{{ vaccineCostPerKg|number_format(2,'.','') }}</td>
                        <td>{{ medicineAndVaccineCostPerKg|number_format(2,'.','') }}</td>
                    </tr>
                {% endfor %}

            {% endfor %}
            </tbody>
        </table>

    {% endfor %}
{% endif %}