<table width="100%" style="color: black; text-align: center">
    <tr>
        <th style="border: 1px solid black">Age of Prod.</th>
        <th style="border: 1px solid black">Av. Feed Intake (g)</th>
        <th style="border: 1px solid black">Av. Egg Prod.%</th>
        <th colspan="24"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
    </tr>
    <tr>
        <th style="border: 1px solid black">26 - 40 wks</th>
        <th style="border: 1px solid black">{{ entities['avgSummery'] is defined and entities['avgSummery']['young_age'] is defined and entities['avgSummery']['young_age']|length>0?(entities['avgSummery']['young_age']|arraySumColWise('feedIntakePerBird')/entities['avgSummery']['young_age']|length)|number_format(0,'.',''):'0' }}</th>
        <th style="border: 1px solid black">{{ entities['avgSummery'] is defined and entities['avgSummery']['young_age'] is defined and entities['avgSummery']['young_age']|length>0?(entities['avgSummery']['young_age']|arraySumColWise('eggProductionAchieved')/entities['avgSummery']['young_age']|length)|number_format(0,'.',''):'0' }}</th>
        <th colspan="24"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
    </tr>
    <tr>
        <th style="border: 1px solid black">41 - 60 wks</th>
        <th style="border: 1px solid black">{{ entities['avgSummery'] is defined and entities['avgSummery']['middle_age'] is defined and entities['avgSummery']['middle_age']|length>0?(entities['avgSummery']['middle_age']|arraySumColWise('feedIntakePerBird')/entities['avgSummery']['middle_age']|length)|number_format(0,'.',''):'0' }}</th>
        <th style="border: 1px solid black">{{ entities['avgSummery'] is defined and entities['avgSummery']['middle_age'] is defined and entities['avgSummery']['middle_age']|length>0?(entities['avgSummery']['middle_age']|arraySumColWise('eggProductionAchieved')/entities['avgSummery']['middle_age']|length)|number_format(0,'.',''):'0' }}</th>
        <th></th>
    </tr>
    <tr>
        <th style="border: 1px solid black">61 - up to cull</th>
        <th style="border: 1px solid black">{{ entities['avgSummery'] is defined and entities['avgSummery']['old_age'] is defined and entities['avgSummery']['old_age']|length>0?(entities['avgSummery']['old_age']|arraySumColWise('feedIntakePerBird')/entities['avgSummery']['old_age']|length)|number_format(0,'.',''):'0' }}</th>
        <th style="border: 1px solid black">{{ entities['avgSummery'] is defined and entities['avgSummery']['old_age'] is defined and entities['avgSummery']['old_age']|length>0?(entities['avgSummery']['old_age']|arraySumColWise('eggProductionAchieved')/entities['avgSummery']['old_age']|length)|number_format(0,'.',''):'0' }}</th>
        <td colspan="24" align="center"><h6>{{ report.name|default('') }}</h6></td>
    </tr>

</table>
<table class="table table-striped table-bordered table-hover" id="datatable">
    <thead class="thead-dark">
    <tr>
        <th scope="col" rowspan="2" class="text-center">Region</th>
        <th scope="col" rowspan="2" class="text-center">Name of CSO</th>
        <th scope="col" rowspan="2" class="text-center">SL No.</th>
        <th scope="col" rowspan="2" class="text-center">Agent's Name</th>
        <th scope="col" rowspan="2" class="text-center">Address</th>
        <th scope="col" rowspan="2" class="text-center">Farmer's Name</th>
        <th scope="col" rowspan="2" class="text-center">Mobile No.</th>
        <th scope="col" rowspan="2" class="text-center">Total birds</th>
        <th scope="col" rowspan="2" class="text-center">Age (Wk)</th>
        <th scope="col" rowspan="2" class="text-center">Age Group</th>
        <th scope="col" colspan="2" class="text-center">B.Weight (gm)</th>
        <th scope="col" colspan="2" class="text-center">Feed Intake (gm)</th>
        <th scope="col" colspan="2" class="text-center">Egg Production %</th>
        <th scope="col" colspan="2" class="text-center">Egg weight (gm)</th>
        <th scope="col" colspan="4" class="text-center">Feed Information</th>
        <th scope="col" colspan="3" class="text-center">Others Information</th>
        <th scope="col" rowspan="2" class="text-center">Disease</th>
        <th scope="col" rowspan="2" class="text-center">Remarks</th>

    </tr>
    <tr>
        <th scope="col">Achieved</th>
        <th scope="col">Target</th>
        <th scope="col">Feed/bird</th>
        <th scope="col">Target</th>
        <th scope="col">Achieved</th>
        <th scope="col">Target</th>
        <th scope="col">Achieved</th>
        <th scope="col">Stand</th>
        <th scope="col">F.Type</th>
        <th scope="col">P.Date</th>
        <th scope="col">Batch No.</th>
        <th scope="col">Feed Mill</th>
        <th scope="col">Hatchery</th>
        <th scope="col">Breed</th>
        <th scope="col">Color</th>
    </tr>

    </thead>
    <tbody>
{% if entities is not empty %}
    {% set recordCount=1 %}
        {% for monthYear, regionFcrDetails in entities %}
            {% if monthYear is not same as 'avgSummery' %}
            <tr>
                <td colspan="30">{{ monthYear }}</td>
            </tr>
            {% for regionId, employeesDetails in regionFcrDetails %}
            {% set regionRecordCount=1 %}
            {% for employeeId, details in employeesDetails %}
                {% if employeeId is not same as 'recordCount' %}
                    {% for detail in details['details'] %}
                        <tr>
                            {% if regionRecordCount==1 %}
                                <td valign="middle"
                                    rowspan="{{ employeesDetails['recordCount']|length }}">{{ detail['regionName'] }}</td>
                            {% endif %}
                            {% if loop.first %}

                                <td valign="middle"
                                    rowspan="{{ details['details']|length }}">{{ detail['employeeName'] }}</td>
                            {% endif %}
                            <td>{{ recordCount }}</td>
                            <td>{{ detail['agentName']|default('') }}</td>
                            <td>{{ detail['agentAddress']|default('') }}</td>
                            <td>{{ detail['customerName']|default('') }}</td>
                            <td>{{ detail['customerMobile']|default('') }}</td>
                            <td>{{ detail['totalBirds']|default(0) }}</td>
                            <td>{{ detail['ageWeek']|default('') }}</td>
                            <td>{{ detail['ageGroup']|default('') }}</td>
                            <td>{{ detail['birdWeightAchieved']|default(0) }}</td>
                            <td>{{ detail['birdWeightTarget']|default(0) }}</td>
                            <td>{{ detail['feedIntakePerBird']|default(0) }}</td>
                            <td>{{ detail['feedTarget']|default(0) }}</td>
                            <td>{{ detail['eggProductionAchieved']|default(0) }}</td>
                            <td>{{ detail['eggProductionTarget']|default(0) }}</td>
                            <td>{{ detail['eggWeightAchieved']|default(0) }}</td>
                            <td>{{ detail['eggWeightStand']|default(0) }}</td>
                            <td>{{ detail['feedType'].name|default('') }}</td>
                            <td>{{ detail['productionDate']|date('d-m-Y') }}</td>
                            <td>{{ detail['batchNo']|default('') }}</td>
                            <td>{{ detail['feedMillName']|default('') }}</td>
                            <td>{{ detail['hatcheryName']|default('') }}</td>
                            <td>{{ detail['breedName']|default('') }}</td>
                            <td>{{ detail['colorName']|default('') }}</td>
                            <td>{{ detail['disease']|default('') }}</td>
                            <td>{{ detail['remarks']|default('') }}</td>
                        </tr>
                        {% set regionRecordCount=regionRecordCount+1 %}
                        {% set recordCount=recordCount+1 %}
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endfor %}
        {% endif %}
    {% endfor %}
{% endif %}

    </tbody>
</table>