<table class="table table-striped table-bordered table-hover fcrReportDetails download-excel" id="fcrReportDetails">
    <thead class="thead-dark" style="background-color: #dbdee3">
    <tr>
        <th data-b-a-s="thin" data-b-a-c="#000000" colspan="2" class="border" style="border-color: #b5b5b5!important">No of Farms</th>
        <th data-b-a-s="thin" data-b-a-c="#000000" class="text-right border"
            style="border-color: #b5b5b5!important">{{ entities['totalRecord'] is defined?entities['totalRecord']:'' }}</th>
        <th data-b-a-s="thin" data-b-a-c="#000000" class="text-right border" style="border-color: #b5b5b5!important">%</th>
        <th colspan="25" class="border-0" data-a-h="center"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
    </tr>
    <tr>
        <th data-b-a-s="thin" data-b-a-c="#000000" colspan="2" class="border" style="border-color: #b5b5b5!important">Body Wt > Stad.</th>
        <th data-b-a-s="thin" data-b-a-c="#000000" class="text-right border"
            style="border-color: #b5b5b5!important">{{ entities['bodyWtGatterThanStandard'] is defined?entities['bodyWtGatterThanStandard']:'' }}</th>
        <th data-b-a-s="thin" data-b-a-c="#000000" class="text-right border"
            style="border-color: #b5b5b5!important">{{ entities['bodyWtGatterThanStandard'] is defined and entities['totalRecord'] is defined and entities['totalRecord']>0?((entities['bodyWtGatterThanStandard']*100)/entities['totalRecord'])|number_format(0):'' }}</th>
        <th colspan="25" class="border-0" data-a-h="center"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
    </tr>

    <tr>
        <th data-b-a-s="thin" data-b-a-c="#000000" colspan="2" class="border" style="border-color: #b5b5b5!important">Body Wt < Stad.</th>
        <th data-b-a-s="thin" data-b-a-c="#000000" class="text-right border"
            style="border-color: #b5b5b5!important">{{ entities['bodyWtLessThanStandard'] is defined?entities['bodyWtLessThanStandard']:'' }}</th>
        <th data-b-a-s="thin" data-b-a-c="#000000" class="text-right border"
            style="border-color: #b5b5b5!important">{{ entities['bodyWtLessThanStandard'] is defined and entities['totalRecord'] is defined and entities['totalRecord']>0?((entities['bodyWtLessThanStandard']*100)/entities['totalRecord'])|number_format(0):'' }}</th>
        <th colspan="25" class="border-0 text-center"
            data-a-h="center"><h6>{{ report.name|default('') }} {{ filterBy['startDate']?filterBy['startDate']:'' }} {{ filterBy['startDate']?' to '~filterBy['endDate']:'' }}</h6> </th>
    </tr>
    <tr>
        <th colspan="29" class="border-0"></th>
    </tr>

    <tr style="position: sticky; top: -1px; background-color: #dbdee3" class="data-header">
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Region</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Name Of CSO</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Name Of Agent</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">District</th>
{#        <th style="width: 150px;" scope="col" rowspan="2">Address</th>#}
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Name Of Farmer</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Address</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Mobile</th>
        <th class="text-center" style="width: 105px" scope="col" rowspan="2">Hatching date</th>
        <th class="text-center" scope="col" rowspan="2">Total Birds</th>
        <th class="text-center" scope="col" rowspan="2">Age (Day)</th>
        <th class="text-center" scope="col" colspan="2">Mortality</th>
        <th class="text-center" scope="col" colspan="3">Weight (gm)</th>
        <th class="text-center" scope="col" colspan="3">Feed Consumption</th>
        <th class="text-center" scope="col" colspan="3">FCR</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Hatchery</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Breed</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">Feed</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">FeedMill</th>
        <th class="text-center" style="width: 150px;" scope="col" rowspan="2">FeedType</th>
        <th class="text-center" style="width: 150px;" style="width: 105px" scope="col" rowspan="2">Pro. Date</th>
        <th class="text-center" style="width: 200px;" scope="col" rowspan="2">Batch No.</th>
        <th class="text-center" style="width: 300px;" scope="col" rowspan="2">Remarks</th>
    </tr>
    <tr style="position: sticky; top: 28px; background-color: #dbdee3" class="data-header">

        <th class="text-center" scope="col">Pcs</th>
        <th class="text-center" scope="col">%</th>

        <th class="text-center" scope="col">Achieve</th>
        <th class="text-center" scope="col">Standard</th>
        <th class="text-center" scope="col">Difference</th>

        <th class="text-center" scope="col">Total (kg)</th>
        <th class="text-center" scope="col">Per bird (gm)</th>
        <th class="text-center" scope="col">Standard</th>

        <th class="text-center" scope="col">Without  M</th>
        <th class="text-center" scope="col">With M</th>
        <th class="text-center" scope="col">Standard</th>

    </tr>
    </thead>
    <tbody>


    {% if entities is not empty %}

        {% for monthYear, regionFcrDetails in entities %}
            {% if monthYear is not same as 'totalRecord' and monthYear is not same as 'fcrBoilerStandard' and monthYear is not same as 'bodyWtGatterThanStandard' and monthYear is not same as 'bodyWtLessThanStandard' %}
            <tr>
                <td colspan="25">{{ monthYear }}</td>
            </tr>

                {% for regionId, employeesFcrDetails in regionFcrDetails %}
                    {% if regionId is not same as 'monthRecordCount' %}
                        {% set recordCount=1 %}
                        {% for employeeId, fcrDetails in employeesFcrDetails %}
                            {% if employeeId is not same as 'recordCount' %}
                                {% for fcrDetail in fcrDetails['details'] %}
                                    <tr class="added_item">
                                        {% if recordCount==1 %}
                                            <td data-a-v="middle" valign="middle"
                                                rowspan="{{ employeesFcrDetails['recordCount']|length }}">{{ fcrDetail['regionName'] }}</td>
                                        {% endif %}

                                        {% if loop.first %}

                                            <td data-a-v="middle" valign="middle"
                                                rowspan="{{ fcrDetails['details']|length }}">{{ fcrDetail['employeeName'] }}</td>
                                        {% endif %}

                                        <td>{{ fcrDetail['agentName']|default('') }}</td>
                                        <td>{{ fcrDetail['agentDistrictName']|default('') }}</td>
                                        {#                        <td>{{ fcrDetail['agentAddress']|default('') }}</td>#}
                                        <td>{{ fcrDetail['customerName']|default('') }}</td>
                                        <td>{{ fcrDetail['customerAddress']|default('') }}</td>
                                        <td data-t="s">{{ fcrDetail['customerMobile']|default('') }}</td>
                                        <td data-t="s">{{ fcrDetail['hatchingDate']|date('d-m-Y') }}</td>
                                        <td data-t="n">{{ fcrDetail['totalBirds'] }}</td>
                                        <td data-t="n">{{ fcrDetail['ageDay'] }}</td>
                                        <td data-t="n">{{ fcrDetail['mortalityPes'] }}</td>
                                        <td data-t="n">{{ fcrDetail['mortalityPercent']|number_format(2,'.','') }}</td>
                                        <td data-t="n">{{ fcrDetail['weight']|number_format(2,'.','') }}</td>
                                        <td data-t="n">{{ fcrDetail['weightStandard'] }}</td>
                                        <td data-t="n">{{ (fcrDetail['weight']-fcrDetail['weightStandard'])|number_format(2,'.','') }}</td>
                                        <td data-t="n">{{ fcrDetail['feedConsumptionTotalKg']|number_format(2,'.','') }}</td>
                                        <td data-t="n">{{ fcrDetail['feedConsumptionPerBird']|number_format(2,'.','') }}</td>
                                        <td data-t="n">{{ fcrDetail['feedConsumptionStandard'] }}</td>
                                        <td data-t="n">{{ fcrDetail['fcrWithoutMortality']|number_format(2,'.','') }}</td>
                                        <td data-t="n">{{ fcrDetail['fcrWithMortality']|number_format(2,'.','') }}</td>
                                        <td data-t="n">{{ entities['fcrBoilerStandard'] is defined and entities['fcrBoilerStandard'][fcrDetail['ageDay']] is defined and entities['fcrBoilerStandard'][fcrDetail['ageDay']]['targetBodyWeight']>0?(entities['fcrBoilerStandard'][fcrDetail['ageDay']]['targetFeedConsumption']/entities['fcrBoilerStandard'][fcrDetail['ageDay']]['targetBodyWeight'])|number_format(3,'.',''):'' }}</td>
                                        <td>{{ fcrDetail['hatcheryName']|default('') }}</td>
                                        <td>{{ fcrDetail['breedBame']|default('') }}</td>
                                        <td>{{ fcrDetail['feedName']|default('') }}</td>
                                        <td>{{ fcrDetail['feedMillName']|default('') }}</td>
                                        <td>{{ fcrDetail['feedTypeName']|default('') }}</td>
                                        <td data-t="s">{{ fcrDetail['proDate']|date('d-m-Y') }}</td>
                                        <td>{{ fcrDetail['batchNo'] }}</td>
                                        <td>{{ fcrDetail['remarks'] }}</td>
                                    </tr>
                                    {% set recordCount=recordCount+1 %}
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endfor %}
    {% endif %}
    </tbody>
</table>