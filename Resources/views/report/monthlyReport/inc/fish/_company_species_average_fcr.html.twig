{% for year, entity in entities %}
    {% for month, details in entity %}
        {% for userId, item in details %}
            <table width="100%">
                <thead class="thead-dark">
                <tr>
                    <th colspan="15"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                </tr>
                <tr>
                    <th colspan="15"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                </tr>
                <tr>
                    <td colspan="15" align="center"><h6>{{ report.name|default('') }}</h6></td>
                </tr>
                </thead>

            </table>
            <table width="100%" class="table table-striped table-bordered table-hover">
                <thead class="thead-dark">
                <tr>
                    <th>{{ 'Employee ID' }}: {{ item.employee.userId }}</th>
                    <th>{{ 'Name Of CSO' }}: {{ item.employee.name }}</th>
                    <th>{{ 'Designation' }}: {{ item.employee.designation }}</th>
                    <th>{{ 'Month' }}: {{ month|split('-')[1] ~ '-' ~ year|split('-')[1] }}</th>
                </tr>
                </thead>

            </table>

            <table class="table table-striped table-bordered table-hover">
                <thead class="thead-dark">
                <tr>
                    <th scope="col">S/L</th>
                    <th scope="col">Company Name</th>
                    <th scope="col">Feed Type</th>
                    {% if species and species['Floating'] is defined %}
                        {% for item in species['Floating'] %}
                            <th scope="col">{{ item.name }}</th>
                        {% endfor %}
                    {% endif %}
                    <th scope="col">Feed Type</th>
                    {% if species and species['Sinking'] is defined %}
                        {% for item in species['Sinking'] %}
                            <th scope="col">{{ item.name }}</th>
                        {% endfor %}
                    {% endif %}
                </tr>

                </thead>
                <tbody>
                {% for company, value in item['data'] %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ company }}</td>
                        <td>Floating</td>

                        {% if value['Floating'] is defined %}
                            {% if species and species['Floating'] is defined %}
                                {% for item in species['Floating'] %}
                                    <td>
                                        {{ value['Floating'][item.id] is defined ? value['Floating'][item.id].avgQuantity|number_format(2) : 0 }}
                                    </td>
                                {% endfor %}
                            {% endif %}
                        {% else %}
                            {% if species and species['Floating'] is defined %}
                                {% for item in species['Floating'] %}
                                    <td>0</td>
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                        <td>Sinking</td>

                        {% if value['Sinking'] is defined %}
                            {% if species and species['Sinking'] is defined %}
                                {% for item in species['Sinking'] %}
                                    <td>
                                        {{ value['Sinking'][item.id] is defined ? value['Sinking'][item.id].avgQuantity|number_format(2) : 0 }}
                                    </td>
                                {% endfor %}
                            {% endif %}
                        {% else %}
                            {% if species and species['Sinking'] is defined %}
                                {% for item in species['Sinking'] %}
                                    <td>0</td>
                                {% endfor %}
                            {% endif %}
                        {% endif %}

                    </tr>

                {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    {% endfor %}
{% endfor %}
