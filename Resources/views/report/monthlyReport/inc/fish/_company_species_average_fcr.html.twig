<table class="table table-striped table-bordered table-hover download-excel" width="100%">
    {% if entities is defined and entities['records'] is defined and entities['records'] is not empty %}
        <thead class="thead-dark" style="background-color: #dbdee3">
        <tr>
            <th data-a-h="center"
                colspan="{{ ((species['Floating'] is defined ? species['Floating']|length : 0) + 4)|number_format(0) }}"
                class="border-0"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
        </tr>
        <tr>
            <th data-a-h="center"
                colspan="{{ ((species['Floating'] is defined ? species['Floating']|length : 0) + 4)|number_format(0) }}"
                class="border-0"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
        </tr>
        <tr>
            <th data-a-h="center"
                colspan="{{ ((species['Floating'] is defined ? species['Floating']|length : 0) + 4)|number_format(0) }}"
                class="border-0"><h6 class="text-center">{{ report.name|default('') }}</h6></th>
        </tr>
        </thead>
        {% for employeeId, employeeRecords in entities['records'] %}
            <thead class="thead-dark" style="background-color: #dbdee3">

            <tr>
                <th colspan="{{ (((species['Floating'] is defined ? species['Floating']|length : 0)+5) / 3)|number_format(0) }}"
                    class="border-0">{{ 'Employee ID' }}: {{ entities['employeeInfo'] is defined? entities['employeeInfo'][employeeId]['userId']:'' }}</th>
                <th colspan="{{ (((species['Floating'] is defined ? species['Floating']|length : 0)+5) / 3)|number_format(0) }}"
                    class="border-0">{{ 'Name Of CSO' }}: {{ entities['employeeInfo'] is defined? entities['employeeInfo'][employeeId]['name']:'' }}</th>
                <th colspan="{{ (((species['Floating'] is defined ? species['Floating']|length : 0)+5) / 3)|number_format(0) }}"
                    class="border-0">{{ 'Designation' }}: {{ entities['employeeInfo'] is defined? entities['employeeInfo'][employeeId]['designation']:'' }}</th>
            </tr>

            </thead>
            {% for monthYear, monthlyRecords in employeeRecords %}

                <tbody>

                <tr>
                    <th data-t="s" colspan="3">{{ monthYear|split('-')[1] ~ '-' ~ monthYear|split('-')[2]}}</th>
                </tr>

                {% if entities['feedTypeInfo'][employeeId][monthYear] is defined %}

                    {% for feedTypeId, feedType in entities['feedTypeInfo'][employeeId][monthYear] %}
                        <tr>
                            <th colspan="{{ species[feedType]|length+4 }}">{{ feedType }}</th>
                        </tr>
                        <tr>
                            <th scope="col">S/L</th>
                            <th scope="col">Reporting Date</th>
                            <th scope="col">Created Date</th>
                            <th scope="col">Company Name</th>
                            {% if species and species[feedType] is defined %}
                                {% for item in species[feedType] %}
                                    <th scope="col">{{ item.name }}</th>
                                {% endfor %}
                            {% endif %}
                        </tr>

                        {% if monthlyRecords[feedTypeId] is defined %}

                            {% for fcrId, fcrRecords in monthlyRecords[feedTypeId] %}
{#                                {{ dump(fcrRecords) }}#}
                                <tr>
                                    <td data-t="n">{{ loop.index }}</td>
                                    <td>{{ entities['fcrInfo'][employeeId][monthYear][feedTypeId][fcrId]['reportingMonth']|default('') }}</td>
                                    <td>{{ entities['fcrInfo'][employeeId][monthYear][feedTypeId][fcrId]['createdAt']|default('') }}</td>
                                    <td>{{ entities['fcrInfo'][employeeId][monthYear][feedTypeId][fcrId]['feedName']|default('') }}</td>

                                    {% if species and species[feedType] is defined %}
                                        {% for item in species[feedType] %}
                                            <th data-t="n" scope="col">{{ fcrRecords[item.id] is defined? fcrRecords[item.id]['quantity']|number_format(2,'.',''):'0.00' }}</th>
                                        {% endfor %}
                                    {% endif %}
                                </tr>

                            {% endfor %}

                        {% endif %}

                    {% endfor %}

                {% endif %}

                </tbody>
            {% endfor %}
            <tfoot style="display: none">
            <tr>
                <td></td>
            </tr>
            <tr>
                <td></td>
            </tr>
            <tr>
                <td></td>
            </tr>
            </tfoot>
        {% endfor %}
    {% endif %}
</table>

