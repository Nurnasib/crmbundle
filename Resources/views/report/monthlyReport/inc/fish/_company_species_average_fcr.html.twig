            <table class="table table-striped table-bordered table-hover download-excel" width="100%">
                {% for year, entity in entities %}
                    {% for month, details in entity %}
                        {% for userId, item in details %}
                <thead class="thead-dark" style="background-color: #dbdee3">
                {% if loop.parent.loop.first %}
                    <tr>
                        <th data-a-h="center" colspan="{{ (species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5 }}" class="border-0"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                    </tr>
                    <tr>
                        <th data-a-h="center" colspan="{{ (species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5 }}" class="border-0"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                    </tr>
                    <tr>
                        <th data-a-h="center" colspan="{{ (species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5 }}" class="border-0"><h6 class="text-center">{{ report.name|default('') }}</h6></th>
                    </tr>
                {% endif %}
                <tr>
                    <th colspan="{{ ((species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5) / 4 }}" class="border-0">{{ 'Employee ID' }}: {{ item.employee.userId }}</th>
                    <th colspan="{{ ((species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5) / 4 }}" class="border-0">{{ 'Name Of CSO' }}: {{ item.employee.name }}</th>
                    <th colspan="{{ ((species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5) / 4 }}" class="border-0">{{ 'Designation' }}: {{ item.employee.designation }}</th>
                    <th colspan="{{ ((species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5) / 4 }}" class="border-0">{{ 'Month' }}: {{ month|split('-')[1] ~ '-' ~ year }}</th>
                </tr>
                <tr class="data-header">
                    <th scope="col">S/L</th>
                    <th scope="col">Created At</th>
                    <th scope="col">Company Name</th>
                    <th scope="col">Feed Type</th>
                    {% if species and species['Floating'] is defined %}
                        {% for item in species['Floating'] %}
                            <th scope="col">{{ item.name }}</th>
                        {% endfor %}
                    {% endif %}
                    <th scope="col">Feed Type</th>
                    {% if species and species['Sinking'] is defined %}
                        {% for item in species['Sinking'] %}
                            <th scope="col">{{ item.name }}</th>
                        {% endfor %}
                    {% endif %}
                </tr>

                </thead>
                <tbody>
                {% for company, value in item['data'] %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        {% if value['Floating'] is defined %}
                            {% if species and species['Floating'] is defined %}
                                {% for item in species['Floating'] %}
                                    {% if loop.first %}
                                        <td data-t="n">
                                            {{ value['Floating'][item.id] is defined ? value['Floating'][item.id].createdAt|date('d-m-Y') : '' }}
                                        </td>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}

                        {% elseif value['Sinking'] is defined %}
                            {% if species and species['Sinking'] is defined %}
                                {% for item in species['Sinking'] %}
                                    {% if loop.first %}
                                        <td data-t="n">
                                            {{ value['Sinking'][item.id] is defined ? value['Sinking'][item.id].createdAt|date('d-m-Y') : '' }}
                                        </td>
                                    {% endif %}
                                {% endfor %}
                            {% endif %}
                        {% endif %}

                        <td>{{ company }}</td>
                        <td>Floating</td>

                        {% if value['Floating'] is defined %}
                            {% if species and species['Floating'] is defined %}
                                {% for item in species['Floating'] %}
                                    <td data-t="n">
                                        {{ value['Floating'][item.id] is defined ? value['Floating'][item.id].avgQuantity|number_format(2) : 0 }}
                                    </td>
                                {% endfor %}
                            {% endif %}
                        {% else %}
                            {% if species and species['Floating'] is defined %}
                                {% for item in species['Floating'] %}
                                    <td data-t="n">0</td>
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                        <td>Sinking</td>

                        {% if value['Sinking'] is defined %}
                            {% if species and species['Sinking'] is defined %}
                                {% for item in species['Sinking'] %}
                                    <td data-t="n">
                                        {{ value['Sinking'][item.id] is defined ? value['Sinking'][item.id].avgQuantity|number_format(2) : 0 }}
                                    </td>
                                {% endfor %}
                            {% endif %}
                        {% else %}
                            {% if species and species['Sinking'] is defined %}
                                {% for item in species['Sinking'] %}
                                    <td data-t="n">0</td>
                                {% endfor %}
                            {% endif %}
                        {% endif %}

                    </tr>

                {% endfor %}
                <tr>
                    <td colspan="{{ (species['Floating'] is defined ? species['Floating']|length : 0) + (species['Sinking'] is defined ? species['Sinking']|length : 0) + 5 }}"></td>
                </tr>
                </tbody>
                        {% endfor %}
                    {% endfor %}
                {% endfor %}
            </table>

