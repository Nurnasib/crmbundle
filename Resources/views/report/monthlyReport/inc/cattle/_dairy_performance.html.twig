{% for year, entity in entities %}
    {% for employeeId, details in entity %}
        {% for month, data in details['data'] %}
            <table width="100%">
                <tr>
                    <th colspan="26"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                </tr>
                <tr>
                    <th colspan="26"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                </tr>
                <tr>
                    <td colspan="26" align="center"><h6>{{ report.name|default('') }}</h6></td>
                </tr>
            </table>
            <table width="100%" class="table table-striped table-bordered table-hover">
                <thead class="thead-dark">
                <tr>
                    <th colspan="6">{{ 'ID' }}: {{ details['employeeDetails'].userId }}</th>
                    <th colspan="6">{{ 'Name of CSO' }}: {{ details['employeeDetails'].name }}</th>
                    <th colspan="6">{{ 'Designation' }}: {{ details['employeeDetails'].designation }}</th>
                    <th colspan="6">{{ 'Month' }}: {{ month|split('-')[1] ~ '-' ~ year }}</th>
                </tr>
                </thead>
            </table>

            <table class="table table-striped table-bordered table-hover" id="datatable">
                <thead class="thead-dark">
                <tr>
                    <th rowspan="2">S/L</th>
                    <th rowspan="2">Created At</th>
                    <th rowspan="2">Name of Agent</th>
                    <th colspan="3" style="text-align: center">Farmer</th>
                    <th rowspan="2">Breed Type</th>
                    <th rowspan="2">Age of Cow(Month)</th>
                    <th rowspan="2">Present Body Weight(Kg)</th>
                    <th rowspan="2">Lactation No</th>
                    <th rowspan="2">Age of Lactation(Week)</th>
                    <th rowspan="2">Av. Milk Yield Per Day (L)</th>
                    <th rowspan="2">Av. Milk Yield Per Kg Con. Feed (L)</th>
                    <th rowspan="2">Av. Milk Yield Per Kg DM (L)</th>
                    <th rowspan="2">Milk Fat %</th>
                    <th colspan="3">Con. Feed Intake (Kg)</th>
                    <th colspan="2">Fodder (Kg)</th>
                    <th colspan="2">DM of Fodder (Kg)</th>
                    <th rowspan="2">Total DM (Kg)</th>
                    <th rowspan="2">DM Requirement (Kg)</th>
                    <th rowspan="2">Name of Ready Feed</th>
                    <th rowspan="2">Remarks</th>
                </tr>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Mobile</th>
                    <th>Ready Feed</th>
                    <th>Conventional</th>
                    <th>Total</th>
                    <th>Gr. Grass</th>
                    <th>Straw</th>
                    <th>Gr. Grass</th>
                    <th>Straw</th>
                </tr>

                </thead>
                <tbody>
                {% for item in data %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ item.createdAt|date('d-m-Y') }}</td>
                        <td>{{ item.agentName }}</td>
                        <td>{{ item.farmerName }}</td>
                        <td>{{ item.farmerAddress }}</td>
                        <td>{{ item.farmerMobile }}</td>
                        <td>{{ item.breedTypeName }}</td>
                        <td>{{ item.ageOfCattleMonth|number_format(2) }}</td>
                        <td>{{ item.presentBodyWeight|number_format(2) }}</td>
                        <td>{{ item.lactationNo|number_format(0) }}</td>
                        <td>{{ item.ageOfLactation|number_format(0) }}</td>
                        <td>{{ item.averageWeightPerDay|number_format(2) }}</td>
                        <td>{{ item.averageWeightPerKgConsumptionFeed|number_format(2) }}</td>
                        <td>{{ item.averageWeightPerKgDm|number_format(2) }}</td>
                        <td>{{ item.milkFatPercentage|number_format(2) }}</td>
                        <td>{{ item.consumptionFeedIntakeReadyFeed|number_format(2) }}</td>
                        <td>{{ item.consumptionFeedIntakeConventional|number_format(2) }}</td>
                        <td>{{ item.consumptionFeedIntakeTotal|number_format(2) }}</td>
                        <td>{{ item.fodderGreenGrassKg|number_format(2) }}</td>
                        <td>{{ item.fodderStrawKg|number_format(2) }}</td>
                        <td>{{ item.dmOfFodderGreenGrassKg|number_format(2) }}</td>
                        <td>{{ item.dmOfFodderStrawKg|number_format(2) }}</td>
                        <td>{{ item.totalDmKg|number_format(2) }}</td>
                        <td>{{ item.dmRequirementByBwtKg|number_format(2) }}</td>
                        <td>{{ item.feedTypeName }}</td>
                        <td>{{ item.remarks }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% endfor %}
    {% endfor %}
{% endfor %}
