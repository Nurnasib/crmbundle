{% if entities is not empty %}
    {% for employeeId, employeesDetails in entities %}

        <table width="100%">
            <tr>
                <th colspan="15"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
            </tr>
            <tr>
                <th colspan="15"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
            </tr>
            <tr>
                <td colspan="15" align="center"><h6>{{ report.name|default('') }}</h6></td>
            </tr>
        </table>
        <table width="100%">
            <tr>
                <th colspan="7"><h5>{{ 'Name Of CSO' }}: {{ entities[employeeId]['name'] }}</h5></th>
                <th colspan="8" class="text-center"><h5>{{ 'Designation' }}
                        : {{ entities[employeeId]['employeeDesignationName'] }}</h5></th>
                {#                <th colspan="8" class="text-right"><h5>{{ 'Month' }}: {{ monthYear }}</h5></th>#}
            </tr>
        </table>

        <table class="table table-striped table-bordered table-hover" id="datatable">
            <thead class="thead-dark">
            <tr>
                <th scope="col" rowspan="2" class="text-center">Month</th>
                <th scope="col" rowspan="2" class="text-center">SL No.</th>
                <th scope="col" rowspan="2" class="text-center">Name Of Farmers</th>
                <th scope="col" rowspan="2" class="text-center">Address</th>
                <th scope="col" rowspan="2" class="text-center">Mobile</th>
                <th scope="col" colspan="{{ entities[employeeId]['species'] is defined?entities[employeeId]['species']|length:'0' }}" class="text-center">Capacity</th>
                <th scope="col" colspan="3" class="text-center">Present Agent Information</th>
                <th scope="col" colspan="3" class="text-center">Previous Agent Information</th>
                <th scope="col" rowspan="2" class="text-center">Remarks</th>
            </tr>
            <tr>

                {% if entities[employeeId]['species'] is defined %}
                    {% for specie in entities[employeeId]['species'] %}
                        <th class="text-center" scope="col">{{ specie.name }}</th>
                    {% endfor %}
                {% endif %}

                <th scope="col">Name Of Agent</th>
                <th scope="col">Address</th>
                <th scope="col">Name Of Feed</th>

                <th scope="col">Name Of Previous Agent</th>
                <th scope="col">Address</th>
                <th scope="col">Name Of Previous Feed</th>

            </tr>

            </thead>
            <tbody>
            {% for monthYear,details in employeesDetails['details'] %}
                {% for detail in details %}
                    {% set cultureSpeciesItemAndQty = detail['cultureSpeciesItemAndQty']|json_decode %}
                    <tr>
                        {% if loop.first %}
                            <td valign="middle"
                                rowspan="{{ details|length }}">{{ monthYear }}</td>
                        {% endif %}
                        {#                        <td>{{ monthYear }}</td>#}
                        <td>{{ loop.index }}</td>

                        <td>{{ detail['customerName']|default('') }}</td>
                        <td>{{ detail['customerAddress']|default('') }}</td>
                        <td>{{ detail['customerMobile']|default('') }}</td>

                        {% if entities[employeeId]['species'] is defined %}
                            {% for specie in entities[employeeId]['species'] %}
                                <td class="text-center" scope="col">{{ cultureSpeciesItemAndQty[specie.id]|default('') }}</td>
                            {% endfor %}
                        {% endif %}

                        <td>{{ detail['agentName']|default('') }}</td>
                        <td>{{ detail['agentAddress']|default('') }}</td>
                        <td>{{ detail['feedName']|default('') }}</td>

                        <td>{{ detail['otherAgentName']?detail['otherAgentName']:detail['subAgentName']|default('') }}</td>
                        <td>{{ detail['otherAgentAddress']?detail['otherAgentAddress']:detail['subAgentAddress']|default('') }}</td>
                        <td>{{ detail['otherFeedName']|default('') }}</td>
                        <td>{{ detail['remarks']|default('') }}</td>


                    </tr>
                {% endfor %}

            {% endfor %}
            </tbody>
        </table>

    {% endfor %}
{% endif %}