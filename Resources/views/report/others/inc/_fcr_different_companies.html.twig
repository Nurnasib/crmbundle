{% for monthYear, entity in entities %}

<table width="100%">
    <tr>
        <th colspan="14"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
    </tr>
    <tr>
        <th colspan="14"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
    </tr>

    <tr>
        <td colspan="14" align="center"><h6>{{ 'FCR Different Companies (Poultry)'|upper }}</h6></td>
    </tr>
</table>
<table width="100%" class="table table-bordered">
    <thead class="thead-dark">
    <tr>
        <th>Officer's ID: {{ employee ? employee.userId : '' }}</th>
        <th>Officer's Name: {{ employee ? employee.name : '' }}</th>
        <th>Designation: {{ employee and employee.designation ? employee.designation.name : '' }}</th>
        <th>Region: {{ employee and employee.regional ? employee.regional.name : '' }}</th>
        <th>Month: {{ monthYear|split('-')[2] ~ '-' ~ monthYear|split('-')[0] }}</th>

    </tr>
    </thead>
</table>
<table class="table table-striped table-bordered table-hover">
    <thead class="thead-dark">
    <tr>
        <th scope="col">Company</th>
        {% for month in 1..12 %}
            {% set date = '01-' ~ month ~ '-2021' %}
            <th scope="col" style="text-align: center">{{ date|date('F') }}</th>
        {% endfor %}
        <th scope="col" style="text-align: center">Total</th>
    </tr>
    </thead>
    <tbody>
    {% for data in entity %}
        {% set yearTotal = 0 %}
        <tr>
            <td>{{ data.companyName }}</td>
            {% for month in 1..12 %}
                {% set date = '01-' ~ month ~ '-2021' %}
                {% set monthName = date|date('F')|lower %}
                {% set value =  data[monthName]|default(0) %}
                {% set yearTotal = yearTotal + value %}
                <td align="center">{{ value }}</td>
            {% endfor %}
            <td align="right">{{ yearTotal }}</td>
        </tr>
    {% endfor %}
{#    <tr>#}
{#        <td colspan="14"></td>#}
{#    </tr>#}
    </tbody>
</table>
{% endfor %}
