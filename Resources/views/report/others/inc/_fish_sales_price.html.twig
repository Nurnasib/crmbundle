{% for year, entity in entities %}
    {% for employeeId, details in entity %}
        <table width="100%">
            <tr>
                <th colspan="15"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
            </tr>
            <tr>
                <th colspan="15"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
            </tr>
            <tr>
                <td colspan="15" align="center"><h6>Average Fish Sale Price (Farmer Price) {{ year }}</h6></td>
            </tr>
        </table>

        <table width="100%" class="table table-striped table-bordered table-hover">
            <thead class="thead-dark">
            <tr>
                <th>{{ 'ID' }}: {{ details['userId'] }}</th>
                <th>{{ 'Name of CSO' }}: {{ details['employeeName'] }}</th>
                <th>{{ 'Designation' }}: {{ details['employeeDesignationName'] }}</th>
            </tr>
            </thead>
        </table>

        <table class="table table-striped table-bordered table-hover" id="datatable">
            <thead>
            <tr>
                <th rowspan="2">{{ 'Month'|trans }}</th>
                {% if speciesTypes is not empty%}
                    {% for speciesType in speciesTypes %}
                        <th class="text-center" colspan="{{ fishSizes[speciesType.id] is defined?fishSizes[speciesType.id]|length:'' }}">{{ speciesType.name }}</th>
                    {% endfor %}

                {% endif %}
            </tr>
            <tr>
                {% if speciesTypes is not empty%}
                    {% for speciesType in speciesTypes %}
                        {% if fishSizes[speciesType.id] is defined %}
                            {% for fishSize in fishSizes[speciesType.id] %}
                                <th>{{ fishSize.name }}</th>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}

                {% endif %}
            </tr>
            </thead>
            <tbody>
            {% for month in arrayMonth %}
                <tr>
                    <td>{{month}}</td>
                    {% if speciesTypes is not empty%}
                        {% for speciesType in speciesTypes %}
                            {% if fishSizes[speciesType.id] is defined %}
                                {% for fishSize in fishSizes[speciesType.id] %}
                                    <td>
                                        {{ details['details'][month][fishSize.id].price|default(0) }}
                                    </td>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}

                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endfor %}
{% endfor %}
