
<table class="table table-striped table-bordered table-hover download-excel">
    {% if entities is defined %}
        <thead>
        <tr>
            <th data-a-h="center" class="border-0" colspan="15"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
        </tr>
        <tr>
            <th data-a-h="center" class="border-0" colspan="15"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
        </tr>

        <tr>
            <td data-a-h="center" class="border-0" colspan="15" align="center"><h6>{{ 'Meat & Egg Price Monthly Report' |upper }}</h6></td>
        </tr>
        </thead>
        {% for year, entity in entities %}
            <thead>
            <tr>
                <th data-a-h="center" class="border-0" scope="col" colspan="15" style="text-align: center">{{ year }}</th>
            </tr>
            </thead>
            {% for chickType, data in entity %}
                <thead class="thead-dark">
                <tr>
                    <th scope="col" colspan="15">{{ chickType }}</th>
                </tr>
                <tr>
                    <th scope="col">Employee ID</th>
                    <th scope="col">Name</th>
                    {% for month in 1..12 %}
                        {% set date = '01-' ~ month ~ '-2022' %}
                        <th scope="col" style="text-align: center">{{ date|date('F') }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% for employee, details in data %}
                    <tr>
                        <td>{{ employee|split('~')[0] }}</td>
                        <td>{{ employee|split('~')[1] }}</td>
                        {% for month in 1..12 %}
                            {% set date = '01-' ~ month ~ '-2022' %}
                            <td data-t="n" align="center">
                                {% if details[date|date('m-F')] is defined %}
                                    {{ details[date|date('m-F')]|number_format(2) }}
                                {% else %}
                                    0
                                {% endif %}
                            </td>
                        {% endfor %}

                    </tr>
                {% endfor %}
                </tbody>
            {% endfor %}

        {% endfor %}
    {% endif %}
</table>
