<table width="100%">
    <tr>
        <th colspan="15"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
    </tr>
    <tr>
        <th colspan="15"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
    </tr>

    <tr>
        <td colspan="15" align="center"><h6>{{ filterBy['otherReport']|replace({'-': ' '}) |upper }}</h6></td>
    </tr>
</table>


{% if entities is defined %}
    {% for year, entity in entities %}
        <table class="table table-striped table-bordered table-hover mb-0">
            <thead>
            <tr>
                <th scope="col" colspan="15" style="text-align: center">{{ year }}</th>
            </tr>
            </thead>
        </table>
        {% for chickType, data in entity %}
            <table class="table table-striped table-bordered table-hover">
                <thead class="thead-dark">
                <tr>
                    <th scope="col" colspan="15">{{ chickType }}</th>
                </tr>
                <tr>
                    <th scope="col">Employee ID</th>
                    <th scope="col">Name</th>
                    {% for month in 1..12 %}
                        {% set date = '01-' ~ month ~ '-2022' %}
                        <th scope="col" style="text-align: center">{{ date|date('F') }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% for employee, details in data %}
                    <tr>
                        <td>{{ employee|split('~')[0] }}</td>
                        <td>{{ employee|split('~')[1] }}</td>
                        {% for month in 1..12 %}
                            {% set date = '01-' ~ month ~ '-2022' %}
                            <td align="center">
                                {% if details[date|date('m-F')] is defined %}
                                    {{ details[date|date('m-F')]|number_format(2) }}
                                {% else %}
                                    0
                                {% endif %}
                            </td>
                        {% endfor %}

                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    {% endfor %}
{% endif %}