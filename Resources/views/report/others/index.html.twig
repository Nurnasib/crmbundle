{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="javascript:void(0)">  {{ 'Others Report'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Others Report'|trans }}</h5>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <table class="table ">
                    <thead class="thead-dark">
                    {{ form_start(form) }}
                    <tr>
                        <th style="min-width: 200px">
                            {{ form_label(form.otherReport, 'Report:') }}
                            {{ form_widget(form.otherReport) }}
                        </th>
                        <th style="min-width: 200px">
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                        </th>
                        <th>
                            {{ form_label(form.startDate, 'Start Date:') }}
                            {{ form_widget(form.startDate,{'id':'start-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                        </th>
                        <th>
                            {{ form_label(form.endDate, 'End Date:') }}
                            {{ form_widget(form.endDate,{'id':'end-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                        </th>
                        <th>
                            {{ form_label(form.lab, 'Lab:') }}
                            {{ form_widget(form.lab) }}
                        </th>
                    </tr>
                    <tr>
                        <th>
                            {{ form_label(form.region, 'Region:') }}
                            {{ form_widget(form.region) }}
                        </th>
                        <th>
                            {{ form_label(form.zone, 'Zone:') }}
                            {{ form_widget(form.zone) }}
                        </th>
                        <th>
                            {{ form_label(form.feedMill, 'Mill:') }}
                            {{ form_widget(form.feedMill) }}
                        </th>
                        <th>
                            {{ form_label(form.breed, 'Breed:') }}
                            {{ form_widget(form.breed) }}
                        </th>
                        <th style="text-align: right">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('others_report_index') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
{#                                    <a target="_blank" href="{{ path('life_cycle_pdf', {filterBy: filterBy}) }}" class="btn blue-bg btn-sm white-font"><i class="fa fa-download" aria-hidden="true"></i> {{ 'PDF'|trans }}</a>#}
{#                                    <a target="_blank" href="{{ path('life_cycle_excel', {filterBy: filterBy}) }}" class="btn blue-bg btn-sm white-font"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</a>#}
                                {% endif %}
                            </div>
                        </th>
                    </tr>
                    </form>
                    </thead>
                </table>
            </div>
        </div>
        {% if entities is defined and entities is not empty %}
            <div class="row">
                <div class="card" style="overflow-x: scroll">
                    <div class="card-block">
                        {% if filterBy['otherReport'] is same as 'farmer-survey-poultry' %}
                            {% include '@TerminalbdCrm/report/others/inc/_farmer_survey.html.twig'%}

                        {% elseif filterBy['otherReport'] is same as 'lab-service-poultry' %}
                            {% include '@TerminalbdCrm/report/others/inc/_lab_service.html.twig'%}

                        {% elseif filterBy['otherReport'] is same as 'fcr-different-companies-poultry' %}
                            {% include '@TerminalbdCrm/report/others/inc/_fcr_different_companies.html.twig'%}

                        {% elseif filterBy['otherReport'] in ['company-wise-feed-sale-poultry','company-wise-feed-sale-cattle','company-wise-feed-sale-fish'] %}
                            {% include '@TerminalbdCrm/report/others/inc/_company_wise_feed_sale.html.twig'%}

                        {% elseif filterBy['otherReport'] in ['farmer-training-poultry','farmer-training-cattle','farmer-training-fish'] %}
                            {% include '@TerminalbdCrm/report/others/inc/_farmer_training.html.twig'%}

                        {% endif %}

                    </div>
                </div>
            </div>
        {% endif %}

        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
        .select2-results__group {
            color: #343a40;
            font-weight: bold;
            background: #c7c9cb;
        }
    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script>
        $("#search_filter_form_employee").on('change', function () {
            var employeeId = $(this).val();
            $.ajax({
                url: Routing.generate('get_farmer_by_employee_location',{'id':employeeId}),
                type: 'post',
                dataType: 'json',
                success: function (res) {
                    console.log(res)
                    $("#search_filter_form_employeeWiseFarmer").find('option').remove();
                    $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:'', text:'Select Farmer'}));
                    $.each(res, function (id, name) {
                        $("#search_filter_form_employeeWiseFarmer").append($('<option>', {value:id, text:name}))
                    })
                }
            })
        })

        $('#start-date, #end-date').datepicker(
            {
                changeMonth: true,
                changeYear: true,
                yearRange: "2020:" + new Date().getFullYear(),
                dateFormat: 'dd-mm-yy'
            }
        );
    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}