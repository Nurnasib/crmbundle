{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        {#<li class="breadcrumb-item"> <a href="{{ path('crm_chick') }}">  {{ 'Chick Life Cycle'|trans }}</a></li>#}
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Fish Life Cycle'|trans }}</h5>
                    {% if entities is defined and entities is not empty %}
                        <div class="btn-group btn-group-sm float-right" role="group" aria-label="Button group with nested dropdown">
                            <a target="_blank" href="{{ path('crm_chick_report_pdf',{'filterBy': filterBy}) }}" class="btn blue-bg white-font btn-sm"><i class="fa fa-file-pdf"></i> PDF</a>
                            <a target="_blank" href="{{ path('chick_excel',{'filterBy': filterBy}) }}" class="btn btn-sm bg-primary white-font"><i class="fa fa-file-excel"></i> Excel</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8 offset-2">
                <table class="table ">
                    <thead class="thead-dark">
                    {{ form_start(form) }}
{#                    <form action="{{ path('crm_fish_life_cycle') }}" method="GET">#}
                        <tr>
                            <th>
                                {{ form_label(form.month, 'Month:') }}
                                {{ form_widget(form.month) }}
                            </th>
                            <th>
                                {{ form_label(form.year, 'Year:') }}
                                {{ form_widget(form.year) }}
                            </th>
                            <th>
                                {{ form_label(form.employee, 'Employee:') }}
                                {{ form_widget(form.employee) }}
                            </th>
                            <th rowspan="2">
                                {{ form_widget(form.filter,{'attr': {'style': 'margin-top: 18px'}}) }}
                            </th>
                        </tr>
{#                    </form>#}
                    </thead>
                </table>
            </div>
        </div>
            <div class="row">
                <div class="card" style="overflow-x: scroll">
                    <div class="card-block">
                        <h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3>
                        <h5 class="text-center">UTTARA, DHAKA.</h5>
                        <h6 class="text-center">FISH LIFE CYCLE REPORT</h6>

                    </div>
                </div>
            </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}
