                                    </tr>
                                    <tr>
                                        <td>{{ '2'|trans}}</td>
                                        <td class="text-left">{{ 'Total Feed (Kg)'|trans }}</td>
                                        <td class="text-right">{{ entity.totalFeedUsedKg|number_format(2,'.','') }}</td>
                                        <td class="text-left">{{ 'Feed Price (Kg)'|trans }}</td>
                                        <td class="text-right">{{ entity.feedPricePerKg|number_format(2,'.','') }}</td>
                                        <td class="text-left">{{ 'Electricity'|trans }}</td>
