                                        <td>{{ 'Breed'|trans }}: {{ entity.breed.name|default('') }}</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <table class="table table-bordered">
                                    <thead>
                                    <tr>
                                        <th>{{'SL NO'|trans }}</th>
                                        <th>{{'Particulars'|trans}}</th>
                                        <th>{{'Quantity'|trans }}</th>
                                        <th>{{'Particulars'|trans}}</th>
                                        <th>{{'Quantity'|trans }}</th>
                                        <th>{{'Particulars'|trans}}</th>
