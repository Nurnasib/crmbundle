                                    </tr>
                                    <tr>
                                        <td>{{ '3'|trans}}</td>
                                        <td class="text-left">{{ 'Total Broiler Wt (Kg)'|trans }}</td>
                                        <td class="text-right">{{ entity.totalBroilerWeightKg|number_format(2,'.','') }}</td>
