{% extends 'admin/layout.html.twig' %}

{% block body %}

    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="row">
            <div class="col-md-12">
                <div class="page-header">
                    <div class="page-block">
                        <div class="row align-items-center">
                            <ul class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Cost Benefit Analysis for Less Costing Farm (Fish)'|trans }}</h5>
{#                    {% if entities is not empty %}#}
                        <div class="btn-group btn-group-sm float-right" role="group" aria-label="Button group with nested dropdown">
                            <a target="_blank" href="#" class="btn blue-bg white-font btn-sm"><i class="fa fa-file-pdf"></i> PDF</a>
                            <a target="_blank" href="#" class="btn btn-sm bg-primary white-font"><i class="fa fa-file-excel"></i> Excel</a>
                        </div>
{#                    {% endif %}#}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col">
                {{ form_start(searchForm) }}
                <table class="table table-borderd">
                    <thead class="thead-dark">
                    <tr>
                        <th>
                            {{ form_label(searchForm.startDate, 'Beginning of Month:') }}
                            {{ form_widget(searchForm.startDate, {'id':'start-date'}) }}
                        </th>
                        <th>
                            {{ form_label(searchForm.endDate, 'End of Month:') }}
                            {{ form_widget(searchForm.endDate, {'id':'end-date'}) }}
                        </th>
                        <th>
                            {{ form_label(searchForm.farmer, 'Select Farmer:',{'required':''}) }}
                            {{ form_widget(searchForm.farmer) }}
                        </th>
                        <th>
                            {{ form_label(searchForm.employee, 'Select Employee:') }}
                            {{ form_widget(searchForm.employee) }}
                        </th>
                        <th>
                            {{ form_widget(searchForm.filter,{'attr':{'style': 'margin-top:18px'}}) }}
                        </th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
        {% if entities is not empty %}
            <div class="card">
                <div class="card-block" style="overflow-x: scroll">
                    <h3 class="text-center">{{ 'NOURISH POULTRY AND HATCHERY LTD'|trans }}</h3>
                    <h5 class="text-center">{{ 'UTTARA, DHAKA.'|trans }}</h5>
                    <h6 class="text-center">{{ 'Farmer Touch Report'|trans }}</h6>
                    <div class="row">
                        <div class="col-md-12">
                            <table class="table">
                                <thead class="thead-dark">
                                <tr>
                                    <th>{{ 'Name of CSO'|trans }}: {{ filterBy.employee.name|default('') }}</th>
                                    <th>{{ 'Designation'|trans }}: {{ filterBy.employee.designation.name|default('') }}</th>
                                    <th>{{ 'Region'|trans }}: {{ filterBy.employee.regional.name|default('') }}</th>
                                </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                    {% for entity in entities %}
                        <table class="table table-bordered table-striped">
                            <thead class="thead-dark">
                            <tr>
                                <th scope="col" rowspan="2" style="text-align: center">{{ 'Month'|trans }}</th>
                                <th scope="col" rowspan="2" style="text-align: center">{{ 'SL No.'|trans }}</th>
                                <th scope="col" colspan="3" style="text-align: center">{{ 'Agent Information'|trans }}</th>
                                <th scope="col" colspan="3" style="text-align: center">{{ 'Farmer Information'|trans }}</th>
                                <th scope="col" colspan="3" style="text-align: center">{{ 'DOC Information'|trans }}</th>
                                <th scope="col" colspan="6" style="text-align: center">{{ 'Flock Details'|trans }}</th>
                                <th scope="col" colspan="3" style="text-align: center">{{ 'Price Details'|trans }}</th>
                                <th scope="col" colspan="8" style="text-align: center">{{ 'Cost Details'|trans }}</th>
                                <th scope="col" colspan="3" style="text-align: center">{{ 'Production Cost'|trans }}</th>
                                <th scope="col" colspan="3" style="text-align: center">{{ 'Selling Price'|trans }}</th>
                                <th scope="col" colspan="3" style="text-align: center">{{ 'Net Profit'|trans }}</th>
                            </tr>
                            <tr>
                                <th scope="col">{{ 'Agent Name'|trans }}</th>
                                <th scope="col">{{ 'Address'|trans }}</th>
                                <th scope="col">{{ 'Mobile'|trans }}</th>
                                <th scope="col">{{ 'Farmer Name'|trans }}</th>
                                <th scope="col">{{ 'Address'|trans }}</th>
                                <th scope="col">{{ 'Mobile'|trans }}</th>
                                <th scope="col">{{ 'Hatch Date'|trans }}</th>
                                <th scope="col">{{ 'Hatchery'|trans }}</th>
                                <th scope="col">{{ 'Breed'|trans }}</th>
                                <th scope="col">{{ 'Total Chicks (Pcs)'|trans }}</th>
                                <th scope="col">{{ 'Total Feed(kg)'|trans }}</th>
                                <th scope="col">{{ 'Total Broiler Wt(kg)'|trans }}</th>
                                <th scope="col">{{ 'Mortality (Pcs)'|trans }}</th>
                                <th scope="col">{{ 'Age (Days)'|trans }}</th>
                                <th scope="col">{{ 'FCR'|trans }}</th>
                                <th scope="col">{{ 'Chick Price (Pcs)'|trans }}</th>
                                <th scope="col">{{ 'Feed Price (kg)'|trans }}</th>
                                <th scope="col">{{ 'Broiler Price (kg)'|trans }}</th>
                                <th scope="col">{{ 'Chick Cost (Total)'|trans }}</th>
                                <th scope="col">{{ 'Feed Cost (Total)'|trans }}</th>
                                <th scope="col">{{ 'Medicine Cost (Total)'|trans }}</th>
                                <th scope="col">{{ 'Vaccine Cost (Total)'|trans }}</th>
                                <th scope="col">{{ 'Litter Cost'|trans }}</th>
                                <th scope="col">{{ 'Electricity Cost'|trans }}</th>
                                <th scope="col">{{ 'Labour Cost'|trans }}</th>
                                <th scope="col">{{ 'Transport Cost'|trans }}</th>
                                <th scope="col">{{ 'Total Costing'|trans }}</th>
                                <th scope="col">{{ 'Costing/Unit'|trans }}</th>
                                <th scope="col">{{ 'Costing/kg'|trans }}</th>
                                <th scope="col">{{ 'Total Broiler Price'|trans }}</th>
                                <th scope="col">{{ 'Broiler Price/Unit'|trans }}</th>
                                <th scope="col">{{ 'Broiler Price/kg'|trans }}</th>
                                <th scope="col">{{ 'Total Profit'|trans }}</th>
                                <th scope="col">{{ 'Profit/Unit'|trans }}</th>
                                <th scope="col">{{ 'Profit/kg'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{ dump(entity) }}
                            {% set chickCostTotal = entity.totalStockedChicksPcs * entity.itemPricePerPcs %}
                            {% set feedCostTotal = entity.totalFeedUsedKg * entity.feedPricePerKg %}
                            {% set totalCosting = chickCostTotal + entity.transportCost %}
                            {% set costingPerUnit = totalCosting / entity.totalStockedChicksPcs %}
                            {% set costingPerKg = totalCosting / entity.totalBroilerWeightKg %}
                            {% set totalBroilerPrice = entity.broilerOrFishPricePerKg / entity.totalBroilerWeightKg %}
                            {% if entity is iterable %}
                                <tr>
                                    <td>{{ entity.reportingMonth|date('F-Y')|default('') }}</td>
                                    <td>{{ loop.index }}</td>
                                    <td>{{ entity.agentName|default('') }}</td>
                                    <td>{{ entity.agentAddress|default('') }}</td>
                                    <td>{{ entity.agentMobile|default('') }}</td>
                                    <td>{{ entity.farmerName|default('') }}</td>
                                    <td>{{ entity.farmerAddress|default('') }}</td>
                                    <td>{{ entity.farmerMobile|default('') }}</td>
                                    <td>{{ entity.hatchingDate|date('d-m-Y') }}</td>
                                    <td>{{ entity.hatcheryName|default('') }}</td>
                                    <td>{{ entity.breedName|default('') }}</td>
                                    <td>{{ entity.totalStockedChicksPcs|default('') }}</td>
                                    <td>{{ entity.totalFeedUsedKg|default('') }}</td>
                                    <td>{{ entity.totalBroilerWeightKg|default('') }}</td>
                                    <td>{{ entity.mortality|default('') }}</td>
                                    <td>{{ entity.ageDays|default('') }}</td>
                                    <td>{{ entity.fcr|default('') }}</td>
                                    <td>{{ entity.itemPricePerPcs|default('') }}</td>
                                    <td>{{ entity.feedPricePerKg|default('') }}</td>
                                    <td>{{ entity.broilerOrFishPricePerKg|default('') }}</td>
                                    <td>{{ chickCostTotal|default('') }}</td>
                                    <td>{{ feedCostTotal|default('') }}</td>
                                    <td>{{ entity.totalMedicineCost|default('') }}</td>
                                    <td>{{ entity.totalVaccineCost|default('') }}</td>
                                    <td>{{ entity.litterOrPondRentCost|default('') }}</td>
                                    <td>{{ entity.electricityAndFuelCost|default('') }}</td>
                                    <td>{{ entity.labourCost|default('') }}</td>
                                    <td>{{ entity.transportCost|default('') }}</td>
                                    <td>{{ totalCosting|default('') }}</td>
                                    <td>{{ costingPerUnit|default('') }}</td>
                                    <td>{{ costingPerKg|default('') }}</td>
                                    <td>{{ totalBroilerPrice|default('') }}</td>
                                </tr>
                            {% endif %}
                            </tbody>
                        </table>
{#                        <div class="row">
                            <div class="col-md-12">
                                <table class="table table-bordered">
