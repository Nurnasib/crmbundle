{% extends 'admin/layout.html.twig' %}

{# Employee ID + Name + Line Manager ID + Name + Year + Month, then one column per species of every farm type (poultry, cattle, fish) #}
{% set speciesCount = filterableSpeciesType|length %}
{# an invalid range (end before start) is rejected in the controller, so never build rows for it #}
{% set hasMonthRange = filterBy.start_month is defined and filterBy.end_month is defined
    and filterBy.start_month and filterBy.end_month
    and filterBy.end_month >= filterBy.start_month %}
{% set totalColumns = 6 + speciesCount %}

{% block body %}
    <div class="pcoded-inner-content">

        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col p-0">
                {{ form_start(form) }}
                <table class="table ">
                    <thead class="thead-dark">
                    <tr>
                        <th colspan="6" class="border-0 p-0">{{ form_errors(form) }}</th>
                    </tr>
                    <tr>
                        <th style="min-width: 200px">
                            {{ form_label(form.line_managers, 'Line Manager:') }}
                            {{ form_widget(form.line_managers) }}
                            {{ form_errors(form.line_managers) }}
                        </th>
                        <th style="min-width: 200px">
                            {{ form_label(form.employees, 'Employee') }}
                            {{ form_widget(form.employees) }}
                            {{ form_errors(form.employees) }}
                        </th>
                        <th>
                            {{ form_label(form.start_month, 'Start Month') }}
                            {{ form_widget(form.start_month) }}
                            {{ form_errors(form.start_month) }}
                        </th>
                        <th>
                            {{ form_label(form.end_month, 'End Month') }}
                            {{ form_widget(form.end_month) }}
                            {{ form_errors(form.end_month) }}
                        </th>
                        <th>
                            {{ form_label(form.year, 'Year') }}
                            {{ form_widget(form.year) }}
                            {{ form_errors(form.year) }}
                        </th>

                        <th colspan="1">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('convert_farmer_capacity_employee_report') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if hasMonthRange %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                                {% endif %}
                            </div>
                        </th>
                    </tr>
                    </thead>
                </table>
                {{ form_widget(form._token) }}
</form>
            </div>
        </div>
        <div class="row">
            <div class="card" style="overflow-x: scroll; max-height: 90vh">
                <div id="data-load" class="card-body p-0">
                    <table class="table table-striped table-bordered table-hover download-excel" id="datatable">
                        <thead>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>
                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center"><h6>{{ 'Convert Farmer Capacity - Employee Wise Report'|upper }}</h6></td>
                        </tr>
                        {% if filterBy.startDate is defined and filterBy.endDate is defined %}
                            <tr>
                                <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center">
                                    {{ filterBy.startDate }} {{ 'to'|trans }} {{ filterBy.endDate }}
                                </td>
                            </tr>
                        {% endif %}
                        </thead>
                        <thead class="thead-dark">
                        <tr>
                            <th scope="col">{{ 'Employee ID'|trans }}</th>
                            <th scope="col">{{ 'Employee Name'|trans }}</th>
                            <th scope="col">{{ 'Line Manager ID'|trans }}</th>
                            <th scope="col">{{ 'Line Manager Name'|trans }}</th>
                            <th scope="col">{{ 'Year'|trans }}</th>
                            <th scope="col">{{ 'Month'|trans }}</th>
                            {% for speciesType in filterableSpeciesType %}
                                <th data-a-h="center" class="text-center" scope="col">{{ speciesType.name }}</th>
                            {% endfor %}
                        </tr>
                        </thead>

                        <tbody>
                        {% if hasMonthRange and speciesCount > 0 %}
                            {% for employee in capacityByEmployee %}
                                {% for m in filterBy.start_month..filterBy.end_month %}
                                    {% set monthQty = employee.byMonth[m] is defined ? employee.byMonth[m] : {} %}
                                    <tr>
                                        {# the block already carries one row per month, so the employee is named once and merged down #}
                                        {% if loop.first %}
                                            <td data-a-v="middle" rowspan="{{ loop.length }}">{{ employee.userId|default('') }}</td>
                                            <td data-a-v="middle" rowspan="{{ loop.length }}">{{ employee.name|default('') }}</td>
                                            <td data-a-v="middle" rowspan="{{ loop.length }}">{{ employee.lineManagerUserId|default('') }}</td>
                                            <td data-a-v="middle" rowspan="{{ loop.length }}">{{ employee.lineManagerName|default('') }}</td>
                                        {% endif %}
                                        <td data-t="n" class="text-right">{{ filterBy.year }}</td>
                                        <td>{{ date(filterBy.year ~ '-' ~ m ~ '-01')|date('M') }}</td>
                                        {% for speciesType in filterableSpeciesType %}
                                            {% set qty = monthQty[speciesType.id] is defined ? monthQty[speciesType.id] : 0 %}
                                            <td data-t="n" class="text-right">{{ qty ?: '' }}</td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}

                                {# every farmer sits in exactly one month bucket, so this employee's months add up #}
                                <tr class="font-weight-bold">
                                    <td data-a-h="right" class="text-right" colspan="6">{{ 'Total'|trans }}</td>
                                    {% for speciesType in filterableSpeciesType %}
                                        {% set qty = employee.totals[speciesType.id] is defined ? employee.totals[speciesType.id] : 0 %}
                                        <td data-t="n" class="text-right">{{ qty ?: '' }}</td>
                                    {% endfor %}
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="{{ totalColumns }}" align="center">{{ 'No record has been found!'|trans }}</td>
                                </tr>
                            {% endfor %}

                            {# each farmer is counted once, so the employees add up here #}
                            {% if capacityByEmployee is not empty %}
                                <tr class="font-weight-bold thead-dark">
                                    <td data-a-h="right" class="text-right" colspan="6">{{ 'Grand Total'|trans }}</td>
                                    {% for speciesType in filterableSpeciesType %}
                                        {% set qty = grandTotals[speciesType.id] is defined ? grandTotals[speciesType.id] : 0 %}
                                        <td data-t="n" class="text-right">{{ qty ?: '' }}</td>
                                    {% endfor %}
                                </tr>
                            {% endif %}
                        {% endif %}
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">

    <style>

        table thead tr.data-header th{
            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }

    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>

        let button = document.querySelector("#button-excel");

        // Check if the button exists before adding the event listener
        if (button) {
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "convert_farmer_capacity_employee_report.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }

        // Employee dropdown follows the Line Manager: with a manager chosen it lists only that
        // manager's CRM chain (plus the manager), with none chosen it lists every employee again.
        (function () {
            const $lineManager = $('#{{ form.line_managers.vars.id }}');
            const $employee = $('#{{ form.employees.vars.id }}');
            // the route requires a numeric id, so generate it with 0 and swap the last segment at call time
            const employeesUrl = '{{ path('convert_farmer_capacity_line_manager_employees', {'id': 0}) }}'.replace(/\/0$/, '/');
            const allEmployeeOptions = $employee.find('option').clone();

            function fillEmployees(options, selected) {
                $employee.empty();
                options.forEach(function (option) {
                    $employee.append(new Option(option.text, option.id, false, String(option.id) === String(selected)));
                });
                $employee.trigger('change');
            }

            function refreshEmployees(selected) {
                const lineManagerId = $lineManager.val();
                if (!lineManagerId) {
                    $employee.empty().append(allEmployeeOptions.clone()).val(selected || '').trigger('change');
                    return;
                }
                $.getJSON(employeesUrl + lineManagerId, function (employees) {
                    // keep the placeholder as the first, empty option so select2 still shows it
                    fillEmployees([{id: '', text: '{{ form.employees.vars.placeholder|e('js') }}'}].concat(employees), selected);
                });
            }

            $lineManager.on('change', function () {
                refreshEmployees('');
            });

            // after a search the page comes back with both values set: narrow the list but keep the choice
            if ($lineManager.val()) {
                refreshEmployees($employee.val());
            }
        })();

    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}
