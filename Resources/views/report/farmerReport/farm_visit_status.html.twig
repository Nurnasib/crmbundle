{% extends 'admin/layout.html.twig' %}
{% import '@TerminalbdCrm/macros/column_count.html.twig' as report %}
    {% set totalColumns = report.dayColumns(filterBy, 7) %}

{% block body %}
    <div class="pcoded-inner-content">

        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col p-0">
                {{ form_start(form) }}
                <table class="table ">
                    <thead class="thead-dark">

                    <tr>
                        <input type="hidden" name="visit" value="yes">
{#                        <input type="hidden" name="status" value="closed">#}
                        <th style="min-width: 200px">
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                        </th>
                        <th>
                            {{ form_label(form.region, 'Region:') }}
                            {{ form_widget(form.region) }}
                        </th>
                        <th>
                            {{ form_label(form.startDate, 'Start Date:') }}
                            {{ form_widget(form.startDate,{'id':'start-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                        </th>
                        <th>
                            {{ form_label(form.endDate, 'End Date:') }}
                            {{ form_widget(form.endDate,{'id':'end-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}
                        </th>
{#                        <th>#}
{#                            {{ form_label(form.type, 'Type') }}#}
{#                            {{ form_widget(form.type) }}#}
{#                        </th>#}

                        <th colspan="1">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('farm_visit_status_report',{'visit': 'yes'}) }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                                {% endif %}
                            </div>
                        </th>
                    </tr>


                    </thead>
                </table>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="card" style="overflow-x: scroll; max-height: 90vh">
                <div id="data-load" class="card-body p-0">
                    <table class="table table-striped table-bordered table-hover download-excel" id="datatable">
                        <thead>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>

                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center"><h6>{{ 'Farmer Details Report'|upper }} </h6></td>
                        </tr>
                        </thead>
                        <thead class="thead-dark">

                        <tr>
                            <th scope="col">Sl.</th>
                            <th scope="col">Employee ID</th>
                            <th scope="col">Employee Name</th>
                            <th scope="col">Farmer ID</th>
                            <th scope="col">Farmer Name</th>
                            <th scope="col">Area</th>
                            <th scope="col">Capacity</th>
                            <th scope="col">Farm On</th>
                            {% if filterBy.startDate is defined and filterBy.endDate is defined %}
                                {% for d in filterBy.startDate|date('j')..filterBy.endDate|date('j') %}
                                    <th scope="col">
                                        {{ d }}
                                    </th>
                                {% endfor %}
                            {% endif %}
                        </tr>
                        </thead>

                        <tbody>

                        {% if entities is not empty %}
                            {% set regionIndex = 1 %}
                            {% for employeeId, employeeData in entities %}
                                {% set loopCount = 1 %}
                                {% set monthlyTotals = {} %}
                                {% set totalTeamMembers = employeeData.teamMembers|length %}
                                {% if totalTeamMembers > 0 %}

                                    {% for teamMember in employeeData.teamMembers %}

                                        {% if teamMember|length > 0 %}
                                            {% for customerId,customer in teamMember %}
{#                                                {{ dump(customer) }}#}
                                                <tr>
                                                    {#                                            first loop index#}
                                                    {% if loopCount ==1  %}
                                                    {% endif %}

                                                    {% if loop.index ==1 %}

                                                    {% endif %}

                                                    <td data-t="n">{{ regionIndex }}</td>
                                                    <td data-t="n">{{ customer.employeeUserId }}</td>
                                                    <td data-t="n">{{ customer.employeeName }}</td>
                                                    <td data-t="n">{{ customerId }}</td>
                                                    <td data-t="n">{{ customer.name }}</td>
                                                    <td data-t="n">{{ customer.area }}</td>
                                                    <td data-t="n">{{ customer.capacity }}</td>
                                                    <td data-t="n">
                                                        {% if speciesTypes is not empty %}
                                                            {% for speciesType in speciesTypes %}
                                                                {% if customer.decodedCultureSpeciesItemAndQty[speciesType.id] is defined %}
                                                                    {{ speciesType.name }},
                                                                {% endif %}
                                                            {% endfor %}
                                                        {% endif %}
                                                    </td>
                                                    {% if filterBy.startDate is defined and filterBy.endDate is defined %}
                                                        {% for d in filterBy.startDate|date('j')..filterBy.endDate|date('j') %}
                                                            <td data-t="n" style="font-weight: 700;">{{ customer[d] ?? '' }}</td>
                                                        {% endfor %}
                                                    {% endif %}


                                                </tr>
{#                                                {% set loopCount = loopCount + 1 %}#}
                                                {% set regionIndex = regionIndex + 1 %}
                                            {% endfor %}

                                        {% endif %}


                                    {% endfor %}
                                {% endif %}


                            {% endfor %}
                        {% else %}
                            {#                            <tr>#}
                            {#                                <td colspan="11" class="text-center">No data found</td>#}
                            {#                            </tr>#}
                        {% endif %}


                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">

    <style>

        table thead tr.data-header th{
            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }

    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>

        $('#start-date, #end-date').datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: "2020:" + new Date().getFullYear(),
            dateFormat: 'dd-mm-yy'
        });

        function parseDateDMY(val) {
            return $.datepicker.parseDate('dd-mm-yy', val);
        }

        $('#start-date').on('change', function () {
            const val = $(this).val();
            if (!val) return;

            const startDate = parseDateDMY(val);

            const firstDay = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
            const lastDay = new Date(startDate.getFullYear(), startDate.getMonth() + 1, 0);

            $('#end-date')
                .datepicker('option', 'minDate', startDate)
                .datepicker('option', 'maxDate', lastDay);

            const endVal = $('#end-date').val();
            if (endVal) {
                const endDate = parseDateDMY(endVal);
                if (endDate < startDate || endDate > lastDay) {
                    $('#end-date').val('');
                }
            }
        });

        $('#end-date').on('change', function () {
            const startVal = $('#start-date').val();
            const endVal = $(this).val();

            if (!startVal || !endVal) return;

            const startDate = parseDateDMY(startVal);
            const endDate = parseDateDMY(endVal);

            if (
                startDate.getFullYear() !== endDate.getFullYear() ||
                startDate.getMonth() !== endDate.getMonth()
            ) {
                alert('Start Date and End Date must be in the same month.');
                $(this).val('');
            }
        });

        let button = document.querySelector("#button-excel");

        // Check if the button exists before adding the event listener
        if (button) {
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "closed_farmer_info_report.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }


    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}