{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">

        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col p-0">
                {{ form_start(form) }}
                <table class="table ">
                    <thead class="thead-dark">

                    <tr>
                        <th style="min-width: 200px">
                            {{ form_label(form.line_managers, 'Line Manager:') }}
                            {{ form_widget(form.line_managers) }}
                        </th>

                        <th>
                            {{ form_label(form.region, 'Region:') }}
                            {{ form_widget(form.region) }}
                        </th>
{#                        <th>#}
{#                            {{ form_label(form.startDate, 'Start Date:') }}#}
{#                            {{ form_widget(form.startDate,{'id':'start-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}#}
{#                        </th>#}
{#                        <th>#}
{#                            {{ form_label(form.endDate, 'End Date:') }}#}
{#                            {{ form_widget(form.endDate,{'id':'end-date', 'attr':{'placeholder': 'dd-mm-YYYY'}}) }}#}
{#                        </th>#}
                        <th>
                            {{ form_label(form.month, 'Month') }}
                            {{ form_widget(form.month) }}
                            {{ form_errors(form.month) }}
                        </th>
                        <th>
                            {{ form_label(form.year, 'Year') }}
                            {{ form_widget(form.year) }}
                            {{ form_errors(form.year) }}
                        </th>
                        <th>
                            {{ form_label(form.type, 'Type') }}
                            {{ form_widget(form.type) }}
                        </th>


                        <th colspan="1">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('farmer_region_report') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                                {% endif %}
                            </div>
                        </th>
                    </tr>


                    </thead>
                </table>
                {{ form_widget(form._token) }}
</form>
            </div>
        </div>
        <div class="row">
            <div class="card" style="overflow-x: scroll; max-height: 90vh">
                <div id="data-load" class="card-body p-0">
                    <table class="table table-striped table-bordered table-hover download-excel" id="datatable">
                        <thead>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ 12 }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ 12 }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>

                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ 12 }}" align="center"><h6>{{ 'Farmer Summary Report'|upper }} </h6></td>
                        </tr>
                        </thead>
                        <thead class="thead-dark">

                        <tr>
                            <th scope="col">Sl.</th>
{#                            <th scope="col">Month</th>#}
                            <th scope="col">Region</th>
                            <th scope="col">Line Manager ID</th>
                            <th scope="col">Line Manager Name</th>
                            <th scope="col">Employee ID</th>
                            <th scope="col">Employee Name</th>
                            <th scope="col">Service Mode</th>
                            <th scope="col">No Of Farm Added</th>
                            <th scope="col">Capacity</th>
                            <th scope="col">New</th>
                            <th scope="col">Convert</th>
                            <th scope="col">Closed</th>
                        </tr>
                        </thead>

                        <tbody>

                        {% if entities is not empty %}
                        {% set regionIndex = 1 %}
                            {% for employeeId, employeeData in entities %}
                                {% set loopCount = 1 %}
                                {% set totalTeamMembers = employeeData.teamMembers|length %}
                                {% if totalTeamMembers > 0 %}

                                    {# initialize totals #}
                                    {% set totalEmployees = 0 %}
                                    {% set totalFarms = 0 %}
                                    {% set totalCapacity = 0 %}
                                    {% set totalNew = 0 %}
                                    {% set totalConvert = 0 %}
                                    {% set totalClosed = 0 %}

                                    {% for teamMember in employeeData.teamMembers %}

                                        {% set totalEmployees = totalEmployees + 1 %}
                                        {% set totalFarms = totalFarms + teamMember.noOfCustomer %}
                                        {% set totalCapacity = totalCapacity + teamMember.customerTotalCapacity %}
                                        {% set totalNew = totalNew + teamMember.noOfCustomer %}
                                        {% set totalConvert = totalConvert + teamMember.noOfCustomerintroduceBy %}
                                        {% set totalClosed = totalClosed+ teamMember.noOfCustomerClosed %}

                                        <tr>
                                            {% if loopCount == 1 %}
                                                <td data-a-v="middle" data-t="n" rowspan="{{ totalTeamMembers }}">{{ regionIndex }}</td>
                                                <td data-a-v="middle" rowspan="{{ totalTeamMembers }}">{{ employeeData.regionName }}</td>
                                                <td data-a-v="middle" rowspan="{{ totalTeamMembers }}">{{ employeeData.userId }}</td>
                                                <td data-a-v="middle" rowspan="{{ totalTeamMembers }}">{{ employeeData.name }}</td>
                                            {% endif %}

                                            <td>{{ teamMember.userId }}</td>
                                            <td>{{ teamMember.name }}</td>
                                            <td>{{ teamMember.serviceModeName }}</td>
                                            <td data-t="n">{{ teamMember.noOfCustomer }}</td>
                                            <td data-t="n">{{ teamMember.customerTotalCapacity }}</td>
                                            <td data-t="n">{{ teamMember.noOfCustomer }}</td>
                                            <td data-t="n">{{ teamMember.noOfCustomerintroduceBy }}</td>
                                            <td data-t="n">{{ teamMember.noOfCustomerClosed }}</td>
                                        </tr>

                                        {% set loopCount = loopCount + 1 %}

                                    {% endfor %}

                                    <tr class="bg-light font-weight-bold">
                                        <td colspan="4" class="text-right">
                                            TOTAL ({{ employeeData.name }})
                                        </td>
                                        <td colspan="2">
                                            Employees: {{ totalEmployees }}
                                        </td>
                                        <td></td>
                                        <td data-t="n">{{ totalFarms }}</td>
                                        <td data-t="n">{{ totalCapacity }}</td>
                                        <td data-t="n">{{ totalNew }}</td>
                                        <td data-t="n">{{ totalConvert }}</td>
                                        <td data-t="n">{{ totalClosed }}</td>
                                    </tr>
                                {% else %}
{#                                    <tr>#}
{#                                        <td colspan="11" class="text-center">No data found</td>#}
{#                                    </tr>#}
                                {% endif %}
                                {% set regionIndex = regionIndex + 1 %}

                            {% endfor %}
                        {% else %}
{#                            <tr>#}
{#                                <td colspan="11" class="text-center">No data found</td>#}
{#                            </tr>#}
                        {% endif %}


                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">

    <style>

        table thead tr.data-header th{
            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }

    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>

        $('#start-date, #end-date').datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: "2020:" + new Date().getFullYear(),
            dateFormat: 'dd-mm-yy'
        });

        let startDate = null;
        let endDate = null;

        function parseDateDMY(val) {
            const parts = val.split('-'); // dd-mm-yy
            return new Date(parts[2], parts[1] - 1, parts[0]);
        }

        // when START changes → limit END
        $('#start-date').on('change', function () {
            const val = $(this).val();
            if (!val) return;

            startDate = parseDateDMY(val);

            let maxEnd = new Date(startDate);
            maxEnd.setMonth(maxEnd.getMonth() + 6);

            $('#end-date')
                .datepicker('option', 'minDate', startDate)
                .datepicker('option', 'maxDate', maxEnd);
        });

        // when END changes → limit START
        $('#end-date').on('change', function () {
            const val = $(this).val();
            if (!val) return;

            endDate = parseDateDMY(val);

            let minStart = new Date(endDate);
            minStart.setMonth(minStart.getMonth() - 6);

            $('#start-date')
                .datepicker('option', 'maxDate', endDate)
                .datepicker('option', 'minDate', minStart);
        });

        let button = document.querySelector("#button-excel");

        // Check if the button exists before adding the event listener
        if (button) {
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "region_wise_farmer_report.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }


    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}