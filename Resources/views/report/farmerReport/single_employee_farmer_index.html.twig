{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">

        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col p-0">
                {{ form_start(form) }}
                <table class="table ">
                    <thead class="thead-dark">

                    <tr>
                        <th style="min-width: 200px">
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                        </th>
{#                        <th>#}
{#                            {{ form_label(form.region, 'Region:') }}#}
{#                            {{ form_widget(form.region) }}#}
{#                        </th>#}
                        <th>
                            {{ form_label(form.month, 'Month') }}
                            {{ form_widget(form.month) }}
                        </th>
                        <th>
                            {{ form_label(form.year, 'Year') }}
                            {{ form_widget(form.year) }}
                        </th>
                        <th>
                            {{ form_label(form.type, 'Type') }}
                            {{ form_widget(form.type) }}
                        </th>

                        <th colspan="1">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('single_employee_farmer_report') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                                {% endif %}
                            </div>
                        </th>
                    </tr>


                    </thead>
                </table>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="card" style="overflow-x: scroll; max-height: 90vh">
                <div id="data-load" class="card-body p-0">
                    <table class="table table-striped table-bordered table-hover download-excel" id="datatable">
                        <thead>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ 12 }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ 12 }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>

                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ 12 }}" align="center"><h6>{{ 'Farmer Details Report'|upper }} </h6></td>
                        </tr>
                        </thead>
                        <thead class="thead-dark">

                        <tr>
                            <th scope="col">Sl.</th>
                            <th scope="col">Employee ID</th>
                            <th scope="col">Employee Name</th>
                            <th scope="col">Designation</th>
                            <th scope="col">Line Manager ID</th>
                            <th scope="col">Line Manager Name</th>
                            <th scope="col">Sl.</th>
                            <th scope="col">Farmer Name</th>
                            <th scope="col">Address</th>
                            <th scope="col">Mobile</th>
                            <th scope="col">Total Capacity</th>
                            {% if filterableSpeciesType is not empty %}
                                {% for speciesType in filterableSpeciesType %}
                                    <th scope="col">{{ speciesType.name }}</th>
                                {% endfor %}
                            {% endif %}

{#                            <th scope="col">Poultry</th>#}
{#                            <th scope="col">Cattle</th>#}
{#                            <th scope="col">Fish</th>#}
                            {#                            <th scope="col">Convert</th>#}
                        </tr>
                        </thead>

                        <tbody>

                        {% if entities is not empty %}
                            {% set regionIndex = 0 %}
                            {% for employeeId, employeeData in entities %}
                                {% set loopCount = 1 %}
                                {% set totalTeamMembers = employeeData.teamMembers|length %}
                                {% if totalTeamMembers > 0 %}
                                    {% set grandTotalTeamMembers = employeeData.teamMembers|arraySumColWise('noOfCustomer')  %}

                                    {% for teamMember in employeeData.teamMembers %}

                                        {% if teamMember.customers|length > 0 %}
                                            {% for customer in teamMember.customers %}
                                                <tr>
                                                    {% if loop.index ==1 %}

                                                        <td rowspan="{{ teamMember.noOfCustomer }}">{{ regionIndex }}</td>
                                                        <td rowspan="{{ teamMember.noOfCustomer }}">{{ teamMember.userId }}</td>
                                                        <td rowspan="{{ teamMember.noOfCustomer }}">{{ teamMember.name }}</td>
                                                        <td rowspan="{{ teamMember.noOfCustomer }}">{{ teamMember.designationName }}</td>
                                                        <td rowspan="{{ teamMember.noOfCustomer }}">{{ teamMember.lineManagerUserId }}</td>
                                                        <td rowspan="{{ teamMember.noOfCustomer }}">{{ teamMember.lineManagerName }}</td>

                                                    {% endif %}

                                                    <td data-t="n">{{ loop.index }}</td>
                                                    <td data-t="n">{{ customer.name }}</td>
                                                    <td data-t="n">{{ customer.address }}</td>
                                                    <td data-t="n">{{ customer.mobile }}</td>
                                                    <td data-t="n">{{ customer.cultureSpeciesItemAndQtySum }}</td>

                                                    {% if filterableSpeciesType is not empty %}
                                                        {% for speciesType in filterableSpeciesType %}
                                                            <td data-t="n">
{#                                                                {% if customer.farmerTypeSlug == 'poultry-breed' %}#}
{#                                                                                                                                        check in array decodedCultureSpeciesItemAndQty#}
                                                                    {% if customer.decodedCultureSpeciesItemAndQty[speciesType.id] is defined %}
                                                                        {{ customer.decodedCultureSpeciesItemAndQty[speciesType.id] }}
                                                                    {% endif %}
{#                                                                {% endif %}#}
                                                            </td>
                                                        {% endfor %}
                                                    {% endif %}

{#                                                    <td data-t="n">{{ customer.farmerTypeSlug == 'poultry-breed' ? customer.cultureSpeciesItemAndQtySum : '' }}</td>#}
{#                                                    <td data-t="n">{{ customer.farmerTypeSlug == 'cattle-breed' ? customer.cultureSpeciesItemAndQtySum : '' }}</td>#}
{#                                                    <td data-t="n">{{ customer.farmerTypeSlug == 'fish-breed' ? customer.cultureSpeciesItemAndQtySum : '' }}</td>#}

                                                    {#                                                    <td data-t="n">{{ teamMember.noOfCustomerintroduceBy }}</td>#}

                                                </tr>
                                                {% set loopCount = loopCount + 1 %}

                                            {% endfor %}

                                        {% endif %}

                                        {% set regionIndex = regionIndex + 1 %}
                                    {% endfor %}
                                {% endif %}


                            {% endfor %}
                        {% else %}
{#                            <tr>#}
{#                                <td colspan="11" class="text-center">No data found</td>#}
{#                            </tr>#}
                        {% endif %}


                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">

    <style>

        table thead tr.data-header th{
            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }

    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>

        $('#start-date, #end-date').datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: "2020:" + new Date().getFullYear(),
            dateFormat: 'dd-mm-yy'
        });

        let startDate = null;
        let endDate = null;

        function parseDateDMY(val) {
            const parts = val.split('-'); // dd-mm-yy
            return new Date(parts[2], parts[1] - 1, parts[0]);
        }

        // when START changes → limit END
        $('#start-date').on('change', function () {
            const val = $(this).val();
            if (!val) return;

            startDate = parseDateDMY(val);

            let maxEnd = new Date(startDate);
            maxEnd.setMonth(maxEnd.getMonth() + 2);

            $('#end-date')
                .datepicker('option', 'minDate', startDate)
                .datepicker('option', 'maxDate', maxEnd);
        });

        // when END changes → limit START
        $('#end-date').on('change', function () {
            const val = $(this).val();
            if (!val) return;

            endDate = parseDateDMY(val);

            let minStart = new Date(endDate);
            minStart.setMonth(minStart.getMonth() - 2);

            $('#start-date')
                .datepicker('option', 'maxDate', endDate)
                .datepicker('option', 'minDate', minStart);
        });

        let button = document.querySelector("#button-excel");

        // Check if the button exists before adding the event listener
        if (button) {
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "employee_farmer_report.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }


    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}