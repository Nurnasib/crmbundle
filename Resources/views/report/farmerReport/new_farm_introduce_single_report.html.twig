{% extends 'admin/layout.html.twig' %}
{% import '@TerminalbdCrm/macros/column_count.html.twig' as report %}
    {% if filterableSpeciesType is defined and filterableSpeciesType is not empty %}
        {% set dynamicColumn = filterableSpeciesType|length %}
    {% else %}
        {% set dynamicColumn = filterableSpeciesType|length %}
    {% endif %}
    {% set totalColumns = dynamicColumn + 13 %}
{% block body %}
    <div class="pcoded-inner-content">

        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col p-0">
                {{ form_start(form) }}
                <table class="table ">
                    <thead class="thead-dark">
                    <tr>
                        <input type="hidden" name="intro_focus" value="yes">
                        <th style="min-width: 200px">
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                            {{ form_errors(form.employee) }}
                        </th>
                        <th>
                            {{ form_label(form.start_month, 'Start Month') }}
                            {{ form_widget(form.start_month) }}
                            {{ form_errors(form.start_month) }}
                        </th>
                        <th>
                            {{ form_label(form.end_month, 'End Month') }}
                            {{ form_widget(form.end_month) }}
                            {{ form_errors(form.end_month) }}
                        </th>
                        <th>
                            {{ form_label(form.year, 'Year') }}
                            {{ form_widget(form.year) }}
                            {{ form_errors(form.year) }}
                        </th>
                        <th>
                            {{ form_label(form.farm_type, 'Type') }}
                            {{ form_widget(form.farm_type) }}
                            {{ form_errors(form.farm_type) }}
                        </th>

                        <th colspan="1">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('new_farm_introduce_single_report') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                                {% endif %}
                            </div>
                        </th>
                    </tr>


                    </thead>
                </table>
                {{ form_widget(form._token) }}
</form>
            </div>
        </div>
        <div class="row">
            <div class="card" style="overflow-x: scroll; max-height: 90vh">
                <div id="data-load" class="card-body p-0">
                    <table class="table table-striped table-bordered table-hover download-excel" id="datatable">
                        <thead>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>

                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center"><h6>{{ 'New Farmer Introduce Report (Single)'|upper }} </h6></td>
                        </tr>
                        {% if filterBy.startDate is defined and filterBy.endDate is defined %}
                            <tr>
                                <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center">
                                    {{ filterBy.startDate }} {{ 'to'|trans }} {{ filterBy.endDate }}
                                </td>
                            </tr>
                        {% endif %}
                        </thead>
                        <thead class="thead-dark">
                        <tr>
                            <th scope="col" rowspan="2">Region</th>
                            <th scope="col" rowspan="2">Employee</th>
                            <th scope="col" rowspan="2">SL No.</th>
                            <th scope="col" rowspan="2">Farmer Name</th>
                            <th scope="col" rowspan="2">Mobile</th>
                            <th scope="col" rowspan="2">Address</th>

                            <th class="text-center" data-a-h="center" colspan="{{ filterableSpeciesType|length }}" scope="col">
                                {{ 'Capacity'|trans }}
                            </th>
                            <th class="text-center" data-a-h="center" colspan="3" scope="col">
                                {{ 'Present Agent Info'|trans }}
                            </th>
                            <th class="text-center" data-a-h="center" colspan="3" scope="col">
                                {{ 'Previous Agent Info'|trans }}
                            </th>
                            <th scope="col" rowspan="2">Remarks</th>
                        </tr>
                        <tr>
                            {% for speciesType in filterableSpeciesType %}
                                <th data-a-h="center" class="text-center" style="width: 4%" scope="col">
                                    {{ speciesType.name }}
                                </th>
                            {% endfor %}

                            <th data-a-h="center" class="text-center" style="width: 4%" scope="col">Name</th>
                            <th data-a-h="center" class="text-center" style="width: 4%" scope="col">Address</th>
                            <th data-a-h="center" class="text-center" style="width: 4%" scope="col">Feed</th>

                            <th data-a-h="center" class="text-center" style="width: 4%" scope="col">Name</th>
                            <th data-a-h="center" class="text-center" style="width: 4%" scope="col">Address</th>
                            <th data-a-h="center" class="text-center" style="width: 4%" scope="col">Feed</th>

                        </tr>
                        </thead>

                        <tbody>

                        {% if entities is not empty %}
                            {% set regionIndex = 1 %}
                            {% for employeeId, employeeData in entities %}
                                {% set loopCount = 1 %}
                                {% set totalTeamMembers = employeeData.teamMembers|length %}
                                {% if totalTeamMembers > 0 %}
                                    {% set grandTotalTeamMembers = employeeData.teamMembers|arraySumColWise('noOfCustomer')  %}

                                    {% for teamMember in employeeData.teamMembers %}

                                        {% if teamMember.customers|length > 0 %}
                                            {% for customer in teamMember.customers %}
                                                <tr>
                                                    {% if loopCount ==1  %}
                                                        <td data-a-v="middle" rowspan="{{ grandTotalTeamMembers }}">{{ employeeData.regionName }}</td>
                                                        <td data-a-v="middle" rowspan="{{ grandTotalTeamMembers }}">{{ employeeData.name }}</td>
                                                    {% endif %}
                                                    <td data-t="n">{{ loop.index }}</td>
                                                    <td data-t="n">{{ customer.name }}</td>
                                                    <td data-t="n">{{ customer.mobile }}</td>
                                                    <td data-t="n">{{ customer.address }}</td>
                                                    {% if filterableSpeciesType is not empty %}
                                                        {% for speciesType in filterableSpeciesType %}
                                                            <td data-t="n" class="text-right">
                                                                {{ customer.decodedCultureSpeciesItemAndQty[speciesType.id] is defined
                                                                ? customer.decodedCultureSpeciesItemAndQty[speciesType.id]
                                                                : 0 }}
                                                            </td>
                                                        {% endfor %}
                                                    {% endif %}
                                                    <td data-t="n" class="text-right">{{ customer.agentName??'' }}</td>
                                                    <td data-t="n" class="text-right">{{ customer.agentLocation??'' }}</td>
                                                    <td data-t="n" class="text-right">{{ customer.feedName??'' }}</td>

                                                    <td data-t="n" class="text-right">{{ customer.otherAgentName??'' }}</td>
                                                    <td data-t="n" class="text-right">{{ customer.otherAgentLocation??'' }}</td>
                                                    <td data-t="n" class="text-right">{{ customer.otherFeedName??'' }}</td>

                                                    <td data-t="n" >{{ customer.remarks??'' }}</td>

                                                </tr>
                                                {% set loopCount = loopCount + 1 %}
                                                {% set regionIndex = regionIndex + 1 %}
                                            {% endfor %}

                                        {% endif %}


                                    {% endfor %}
                                {% endif %}


                            {% endfor %}
                        {% endif %}


                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">

    <style>

        table thead tr.data-header th{
            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }

    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>

        let button = document.querySelector("#button-excel");

        // Check if the button exists before adding the event listener
        if (button) {
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "new_farm_introduce_single_report.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }


    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}
