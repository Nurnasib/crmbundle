{% extends 'admin/layout.html.twig' %}

{# SL + ID + Employee + Species + Total, then one column per day of the selected month #}
{% set speciesCount = filterableSpeciesType|length %}
{% set daysInMonth = filterBy.daysInMonth is defined ? filterBy.daysInMonth : 0 %}
{% set totalColumns = 5 + daysInMonth %}

{% block body %}
    <div class="pcoded-inner-content">

        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col p-0">
                {{ form_start(form) }}
                <table class="table ">
                    <thead class="thead-dark">
                    <tr>
                        <th colspan="6" class="border-0 p-0">{{ form_errors(form) }}</th>
                    </tr>
                    <tr>
                        <th style="min-width: 200px">
                            {{ form_label(form.line_managers, 'Line Manager:') }}
                            {{ form_widget(form.line_managers) }}
                            {{ form_errors(form.line_managers) }}
                        </th>
                        <th>
                            {{ form_label(form.month, 'Month') }}
                            {{ form_widget(form.month) }}
                            {{ form_errors(form.month) }}
                        </th>
                        <th>
                            {{ form_label(form.year, 'Year') }}
                            {{ form_widget(form.year) }}
                            {{ form_errors(form.year) }}
                        </th>
                        <th>
                            {{ form_label(form.farm_type, 'Farm Type') }}
                            {{ form_widget(form.farm_type) }}
                            {{ form_errors(form.farm_type) }}
                        </th>

                        <th colspan="1">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('convert_farmer_capacity_daily_report') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if entities is defined and entities is not empty %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                                {% endif %}
                            </div>
                        </th>
                    </tr>
                    </thead>
                </table>
                {{ form_widget(form._token) }}
</form>
            </div>
        </div>
        <div class="row">
            <div class="card" style="overflow-x: scroll; max-height: 90vh">
                <div id="data-load" class="card-body p-0">
                    <table class="table table-striped table-bordered table-hover download-excel" id="datatable">
                        <thead>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>
                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center"><h6>{{ 'Convert Farmer Capacity - Daily Report'|upper }}</h6></td>
                        </tr>
                        {% if filterBy.startDate is defined and filterBy.endDate is defined %}
                            <tr>
                                <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center">
                                    {{ filterBy.startDate }} {{ 'to'|trans }} {{ filterBy.endDate }}
                                </td>
                            </tr>
                        {% endif %}
                        </thead>
                        <thead class="thead-dark">
                        <tr>
                            <th scope="col">SL</th>
                            <th scope="col">ID</th>
                            <th scope="col" style="min-width: 180px">{{ 'Employee'|trans }}</th>
                            <th scope="col">{{ filterBy.farm_type is defined and filterBy.farm_type ? filterBy.farm_type|replace({'-breed': ''})|capitalize : 'Type' }}</th>
                            <th data-a-h="center" class="text-center" scope="col">{{ 'Total'|trans }}</th>
                            {% if daysInMonth > 0 %}
                                {% for d in 1..daysInMonth %}
                                    <th data-a-h="center" class="text-center" scope="col">{{ d }}</th>
                                {% endfor %}
                            {% endif %}
                        </tr>
                        </thead>

                        <tbody>
                        {% if entities is not empty and speciesCount > 0 %}
                            {% for lineManagerId, lineManagerData in entities %}

                                {# the group header carries the whole group's totals. Skipped when a single
                                   line manager is filtered: the manager already shows up as an ordinary
                                   employee row below and the Total footer carries the same subtree total.
                                   Kept when several groups are listed, otherwise nothing separates them. #}
                                {% if lineManager is null %}
                                    {% for speciesType in filterableSpeciesType %}
                                        {# every bucket in the map is a day of the selected month, so the whole map is the row total #}
                                        {% set dailyQty = lineManagerData.speciesTotals[speciesType.id] is defined ? lineManagerData.speciesTotals[speciesType.id] : {} %}
                                        <tr class="font-weight-bold">
                                            {% if loop.first %}
                                                <td data-a-v="middle" rowspan="{{ speciesCount }}"></td>
                                                <td data-a-v="middle" rowspan="{{ speciesCount }}">{{ lineManagerData.userId }}</td>
                                                <td data-a-v="middle" rowspan="{{ speciesCount }}">
                                                    {{ lineManagerData.name }}
                                                    <small class="d-block text-muted">{{ 'Line Manager'|trans }}</small>
                                                </td>
                                            {% endif %}
                                            <td>{{ speciesType.name }}</td>
                                            <td data-t="n" class="text-right">{{ dailyQty|reduce((carry, qty) => carry + qty, 0) ?: '' }}</td>
                                            {% if daysInMonth > 0 %}
                                                {% for d in 1..daysInMonth %}
                                                    {% set qty = dailyQty[d] is defined ? dailyQty[d] : 0 %}
                                                    <td data-t="n" class="text-right">{{ qty ?: '' }}</td>
                                                {% endfor %}
                                            {% endif %}
                                        </tr>
                                    {% endfor %}
                                {% endif %}

                                {# then one block per employee under that line manager, totals only #}
                                {% for employee in lineManagerData.employees %}
                                    {% for speciesType in filterableSpeciesType %}
                                        {% set dailyQty = employee.speciesTotals[speciesType.id] is defined ? employee.speciesTotals[speciesType.id] : {} %}
                                        <tr>
                                            {% if loop.first %}
                                                <td data-a-v="middle" rowspan="{{ speciesCount }}">{{ loop.parent.loop.index }}</td>
                                                <td data-a-v="middle" rowspan="{{ speciesCount }}">{{ employee.userId }}</td>
                                                <td data-a-v="middle" rowspan="{{ speciesCount }}">{{ employee.name }}</td>
                                            {% endif %}
                                            <td>{{ speciesType.name }}</td>
                                            <td data-t="n" class="text-right font-weight-bold">{{ dailyQty|reduce((carry, qty) => carry + qty, 0) ?: '' }}</td>
                                            {% if daysInMonth > 0 %}
                                                {% for d in 1..daysInMonth %}
                                                    {% set qty = dailyQty[d] is defined ? dailyQty[d] : 0 %}
                                                    <td data-t="n" class="text-right">{{ qty ?: '' }}</td>
                                                {% endfor %}
                                            {% endif %}
                                        </tr>
                                    {% endfor %}
                                {% endfor %}

                            {% endfor %}

                            {# counted once per farmer in the repository: nested line managers share
                               farmers, so adding the group rows up here would double count them #}
                            {% for speciesType in filterableSpeciesType %}
                                {% set totalQty = grandTotals[speciesType.id] is defined ? grandTotals[speciesType.id] : {} %}
                                <tr class="font-weight-bold thead-dark">
                                    {% if loop.first %}
                                        <td data-a-v="middle" data-a-h="right" class="text-right" colspan="3" rowspan="{{ speciesCount }}">{{ 'Total'|trans }}</td>
                                    {% endif %}
                                    <td>{{ speciesType.name }}</td>
                                    <td data-t="n" class="text-right">{{ totalQty|reduce((carry, qty) => carry + qty, 0) ?: '' }}</td>
                                    {% if daysInMonth > 0 %}
                                        {% for d in 1..daysInMonth %}
                                            {% set qty = totalQty[d] is defined ? totalQty[d] : 0 %}
                                            <td data-t="n" class="text-right">{{ qty ?: '' }}</td>
                                        {% endfor %}
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        {% endif %}
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">

    <style>

        table thead tr.data-header th{
            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }

    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>

        let button = document.querySelector("#button-excel");

        // Check if the button exists before adding the event listener
        if (button) {
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "convert_farmer_capacity_daily_report.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }

    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
{% endblock %}
