<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Daily Visit Report</title>
    <style>
        body {
            font-size: 12px;
        }
    </style>
</head>
<body>
<div style="text-align: center">
    <h3 class="text-center" style="margin: 0px;">{{ 'NOURISH POULTRY AND HATCHERY LTD'|trans }}</h3>
    <h5 class="text-center" style="margin: 0px;">{{ 'UTTARA, DHAKA.'|trans }}</h5>
    {% if entities is defined and entities is not empty %}
        <h6 class="text-center" style="margin: 0 0 10px;">
            {{ 'VISIT REPORT'|trans }} :
            {% if entities.visitCreatedDate.begin|date('d-m-Y') is not empty %}
                {{ entities.visitCreatedDate.begin|date('d-m-Y') }} - {{ entities.visitCreatedDate.end|date('d-m-Y') }}
            {% endif %}
        </h6>
    {% endif %}
</div>
{% if entities is defined and entities is not empty %}
    {% for employeeId, employee in entities %}
        {% if employeeId is not same as 'visitCreatedDate' %}
            <table width="100%" style="background-color: #CCCCCC; margin-top: 20px">
                <thead>
                <tr>
                    <th>{{ 'Employee ID'|trans }}: {{ employeeId }}</th>
                    <th>{{ 'Employee Name'|trans }}: {{ entities[employeeId]['employeeName']|default }}</th>
                    <th>
                        {{ 'Date'|trans }}:
                        {% if entities.visitCreatedDate.begin|date('d-m-Y') is not empty %}
                            {{ entities.visitCreatedDate.begin|date('d-m-Y') }} - {{ entities.visitCreatedDate.end|date('d-m-Y') }}
                        {% else %}
                            {{ entities.visitCreatedDate.begin|date('d-m-Y') }}
                        {% endif %}
                    </th>
                </tr>
                </thead>
            </table>
            {# Farmer Section#}
        {% if employee['farmer'] is defined and employee['farmer'] is iterable %}
            <div style="border: 2px solid green; padding: 5px; margin-bottom: 20px" title="Farmer Section">
            <h3 style="text-align: center; background-color: green; color: #fff; padding: 5px 0">Farmer Section</h3>
            <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
            <thead style="background-color: #CCCCCC">
            <tr>
                <th width="10">S/N</th>
                <th>Visited Date</th>
                <th>Visited Time</th>
                <th>{{ 'Visited Farmers\' Name'|trans }}</th>
                <th>{{ 'Address'|trans }}</th>
                <th>{{ 'Phone'|trans }}</th>
                <th>{{ 'Purpose'|trans }}</th>
                <th>{{ 'Farm Capacity'|trans }}</th>
                <th>{{ 'Comments'|trans }}</th>
            </tr>
            </thead>
            <tbody>
                {% for dateMonthYear, entity in employee['farmer'] %}
                    <tr>
                        <th colspan="9">{{ dateMonthYear }}</th>
                    </tr>
                    {% if entity is not empty %}
                        {% for data in entity %}
                            <tr>
                                <td align="center">{{ loop.index }}</td>
                                <td>{{ data.visitDate|date('d-m-Y') }}</td>
                                <td>{{ data.visitTime|default('') }}</td>
                                <td>{{ data.farmerName }}</td>
                                <td>{{ data.farmerAddress }}</td>
                                <td>{{ data.farmerMobile }}</td>
                                <td>
                                    {% if data.purposeMultiple is not empty %}
                                        {% set purposes=data.purposeMultiple|json_decode %}
                                        <ol>
                                            {% for purpose in purposes %}
                                                <li>{{ purpose }}</li>
                                            {% endfor %}
                                        </ol>
                                    {% else %}
                                        {{ data.purposeName }}
                                    {% endif %}
                                </td>
                                <td>{{ data.farmCapacity }}</td>
                                <td>{{ data.comments }}</td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </tbody>
            </table>
            </div>
            {% if employee['agent'] is defined and employee['agent'] is iterable %}
                <div style="page-break-after: always"></div>
            {% endif %}
        {% endif %}
            {# Agent Section#}
{#            {% for key, entity in employee %}#}
                {% if employee['agent'] is defined and employee['agent'] is iterable %}
                    <div style="border: 2px solid red; padding: 5px; margin-bottom: 20px" title="Agent Section">
                        <h3 style="text-align: center; background-color: red; color: #fff; padding: 5px 0">Agent Section</h3>
                        <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                            <thead style="background-color: #CCCCCC">
                            <tr>
                                <th width="10">S/N</th>
                                <th>Visited Date</th>
                                <th>Visited Time</th>
                                <th>{{ 'Agent Id'|trans }}</th>
                                <th>{{ 'Agent Name (Nourish)'|trans }}</th>
                                <th>{{ 'Address'|trans }}</th>
                                <th>{{ 'Phone'|trans }}</th>
                                <th>{{ 'Purpose'|trans }}</th>
                                <th>{{ 'Report Description'|trans }}</th>
                                <th>{{ 'Comments'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for dateMonthYear, entity in employee['agent'] %}
                                <tr>
                                    <th colspan="10">{{ dateMonthYear }}</th>
                                </tr>
                                {% if entity is not empty %}
                                    {% for data in entity %}
                                        <tr>
                                            <td align="center">{{ loop.index }}</td>
                                            <td>{{ data.visitDate|date('d-m-Y') }}</td>
                                            <td>{{ data.visitTime|default('') }}</td>
                                            <td>{{ data.agentId|default('') }}</td>
                                            <td>{{ data.agentName }}</td>
                                            <td>{{ data.agentAddress }}</td>
                                            <td>{{ data.agentMobile }}</td>
                                            <td>
                                                {% if data.purposeMultiple is not empty %}
                                                    {% set purposes=data.purposeMultiple|json_decode %}
                                                    <ol>
                                                        {% for purpose in purposes %}
                                                            <li>{{ purpose }}</li>
                                                        {% endfor %}
                                                    </ol>
                                                {% else %}
                                                    {{ data.purposeName }}
                                                {% endif %}
                                            </td>
                                            <td>{{ data.reportDesc }}</td>
                                            <td>{{ data.comments }}</td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if employee['other-agent'] is defined and employee['other-agent'] is iterable %}
                        <div style="page-break-after: always"></div>
                    {% endif %}
                {% endif %}
{#            {% endfor %}#}
            {# Other Agent Section#}
            {#{% for key, entity in employee %}#}
                {% if employee['other-agent'] is defined and employee['other-agent'] is iterable %}
                    <div style="border: 1px solid blue; padding: 5px; margin-bottom: 20px" title="Other Agent Section">
                        <h3 style="text-align: center; background-color: blue; color: #fff; padding: 5px 0">Other Agent Section</h3>
                        <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                            <thead style="background-color: #CCCCCC">
                            <tr>
                                <th width="10">S/N</th>
                                <th>Visited Date</th>
                                <th>Visited Time</th>
                                <th>{{ 'Visited Agent Name(Other Agent)'|trans }}</th>
                                <th>{{ 'Address'|trans }}</th>
                                <th>{{ 'Name Agent'|trans }}</th>
                                <th>{{ 'Phone'|trans }}</th>
                                <th>{{ 'Purpose'|trans }}</th>
                                <th>{{ 'Report Description'|trans }}</th>
                                <th>{{ 'Comments'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for dateMonthYear, entity in employee['other-agent'] %}
                                <tr>
                                    <th colspan="10">{{ dateMonthYear }}</th>
                                </tr>
                                {% if entity is not empty %}
                                    {% for data in entity %}
                                        <tr>
                                            <td align="center">{{ loop.index }}</td>
                                            <td>{{ data.visitDate|date('d-m-Y') }}</td>
                                            <td>{{ data.visitTime|default('') }}</td>
                                            <td>{{ data.agentName }}</td>
                                            <td>{{ data.agentAddress }}</td>
                                            <td>{{ data.nourishAgentName }}</td>
                                            <td>{{ data.agentMobile }}</td>
                                            <td>
                                                {% if data.purposeMultiple is not empty %}
                                                    {% set purposes=data.purposeMultiple|json_decode %}
                                                    <ol>
                                                        {% for purpose in purposes %}
                                                            <li>{{ purpose }}</li>
                                                        {% endfor %}
                                                    </ol>
                                                {% else %}
                                                    {{ data.purposeName }}
                                                {% endif %}
                                            </td>
                                            <td>{{ data.reportDesc }}</td>
                                            <td>{{ data.comments }}</td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if employee['sub-agent'] is defined and employee['sub-agent'] is iterable %}
                        <div style="page-break-after: always"></div>
                    {% endif %}
                {% endif %}
{#            {% endfor %}#}
            {#            Sub Agent Section#}
{#            {% for key, entity in employee %}#}
                {% if employee['sub-agent'] is defined and employee['sub-agent'] is iterable %}
                    <div style="border: 1px solid purple; padding: 5px; margin-bottom: 20px" title="Sub Agent Section">
                        <h3 style="text-align: center; background-color: purple; color: #fff; padding: 5px 0">Sub Agent Section</h3>
                        <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                            <thead style="background-color: #CCCCCC">

                            <tr>
                                <th width="10">S/N</th>
                                <th>Visited Date</th>
                                <th>Visited Time</th>
                                <th>{{ 'Visited Agent Name(Sub Agent)'|trans }}</th>
                                <th>{{ 'Address'|trans }}</th>
                                <th>{{ 'Phone'|trans }}</th>
                                <th>{{ 'Purpose'|trans }}</th>
                                <th>{{ 'Report Description'|trans }}</th>
                                <th>{{ 'Comments'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for dateMonthYear, entity in employee['sub-agent'] %}
                                <tr>
                                    <th colspan="9">{{ dateMonthYear }}</th>
                                </tr>
                                {% if entity is not empty %}
                                    {% for data in entity %}
                                        <tr>
                                            <td align="center">{{ loop.index }}</td>
                                            <td>{{ data.visitDate|date('d-m-Y') }}</td>
                                            <td>{{ data.visitTime|default('') }}</td>
                                            <td>{{ data.agentName }}</td>
                                            <td>{{ data.agentAddress }}</td>
                                            <td>{{ data.agentMobile }}</td>
                                            <td>
                                                {% if data.purposeMultiple is not empty %}
                                                    {% set purposes=data.purposeMultiple|json_decode %}
                                                    <ol>
                                                        {% for purpose in purposes %}
                                                            <li>{{ purpose }}</li>
                                                        {% endfor %}
                                                    </ol>
                                                {% else %}
                                                    {{ data.purposeName }}
                                                {% endif %}
                                            </td>
                                            <td>{{ data.reportDesc }}</td>
                                            <td>{{ data.comments }}</td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                {% endif %}
{#            {% endfor %}#}
        {% endif %}
    {% endfor %}

{% else %}
    <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
        <thead>
        <tr>
            <th width="50">Details Not Found!</th>
        </tr>
        </thead>
    </table>
{% endif %}
</body>
</html>