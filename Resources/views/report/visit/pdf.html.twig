<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Daily Visit Report</title>
    <style>
        body{
            font-size: 12px;
        }
    </style>
</head>
<body>
{% if entities is defined and entities is not empty %}
    <div style="text-align: center">
        <h3 class="text-center" style="margin: 0px;">{{ 'NOURISH POULTRY AND HATCHERY LTD'|trans }}</h3>
        <h5 class="text-center" style="margin: 0px;">{{ 'UTTARA, DHAKA.'|trans }}</h5>
        <h6 class="text-center" style="margin: 0 0 10px;">
            {{ 'VISIT REPORT'|trans }} :
            {% if entities.employee.visitDate.begin|date('d-m-Y') is not same as entities.employee.visitDate.end|date('d-m-Y') %}
                {{ entities.employee.visitDate.begin|date('d-m-Y') }} - {{ entities.employee.visitDate.end|date('d-m-Y') }}
            {% else%}
                {{ entities.employee.visitDate.begin|date('d-m-Y') }}
            {% endif %}
        </h6>
    </div>
    <table width="100%" style="background-color: #CCCCCC">
        <thead>
        <tr>
            <th>{{ 'Officer ID'|trans }}: {{ entities.employee.userId }}</th>
            <th>{{ 'Name of Officer'|trans }}: {{ entities.employee.employeeName }}</th>
            <th>
                {{ 'Date'|trans }}:
                {% if entities.employee.visitDate.begin|date('d-m-Y') is not same as entities.employee.visitDate.end|date('d-m-Y') %}
                    {{ entities.employee.visitDate.begin|date('d-m-Y') }} - {{ entities.employee.visitDate.end|date('d-m-Y') }}
                {% else%}
                    {{ entities.employee.visitDate.begin|date('d-m-Y') }}
                {% endif %}
            </th>
        </tr>
        </thead>
    </table>
    {% for key, entity in entities %}
        {% if key is not same as 'employee' %}
            {% if key is same as 'farmer' %}
                <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                    <thead style="background-color: #CCCCCC">
                    <tr>
                        <th width="50">S/N</th>
                        <th>{{ 'Visited Farmers\' Name'|trans }}</th>
                        <th>{{ 'Address'|trans }}</th>
                        <th>{{ 'Phone'|trans }}</th>
                        <th>{{ 'Purpose'|trans }}</th>
                        <th>{{ 'Farm Capacity'|trans }}</th>
                        <th>{{ 'Comments'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for data in entity %}
                        <tr>
                            <td align="center">{{ loop.index }}</td>
                            <td>{{ data.farmerName }}</td>
                            <td>{{ data.farmerAddress }}</td>
                            <td>{{ data.farmerMobile }}</td>
                            <td>
                                {% if data.purposeMultiple is not empty %}
                                {% set purposes=data.purposeMultiple|json_decode  %}
                                <ol>
                                    {% for purpose in purposes %}
                                        <li>{{ purpose }}</li>
                                    {% endfor %}
                                </ol>
                                {% else %}
                                {{ data.purposeName }}
                                {% endif %}
                            </td>
                            <td>{{ data.farmCapacity }}</td>
                            <td>{{ data.comments }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% elseif key is same as 'agent' %}
                    <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                        <thead style="background-color: #CCCCCC">
                        <tr>
                            <th width="50">S/N</th>
                            <th>{{ 'Visited Agent Name(Nourish)'|trans }}</th>
                            <th>{{ 'Address'|trans }}</th>
                            <th>{{ 'Phone'|trans }}</th>
                            <th>{{ 'Purpose'|trans }}</th>
                            <th>{{ 'Comments'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for data in entity %}
                            <tr>
                                <td align="center">{{ loop.index }}</td>
                                <td>{{ data.agentName }}</td>
                                <td>{{ data.agentAddress }}</td>
                                <td>{{ data.agentMobile }}</td>
                                <td>{{ data.purposeName }}</td>
                                <td>{{ data.comments }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% elseif key is same as 'other-agent' %}
                    <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                        <thead style="background-color: #CCCCCC">
                        <tr>
                            <th width="50">S/N</th>
                            <th>{{ 'Visited Agent Name(Other Agent)'|trans }}</th>
                            <th>{{ 'Address'|trans }}</th>
                            <th>{{ 'Name Agent'|trans }}</th>
                            <th>{{ 'Phone'|trans }}</th>
                            <th>{{ 'Purpose'|trans }}</th>
                            <th>{{ 'Comments'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for data in entity %}
                            <tr>
                                <td align="center">{{ loop.index }}</td>
                                <td>{{ data.agentName }}</td>
                                <td>{{ data.agentAddress }}</td>
                                <td>{{ data.nourishAgentName }}</td>
                                <td>{{ data.agentMobile }}</td>
                                <td>{{ data.purposeName }}</td>
                                <td>{{ data.comments }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                {% elseif key is same as 'sub-agent' %}
                    <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                        <thead style="background-color: #CCCCCC">
                        <tr>
                            <th width="50">S/N</th>
                            <th>{{ 'Visited Agent Name(Sub Agent)'|trans }}</th>
                            <th>{{ 'Address'|trans }}</th>
                            <th>{{ 'Phone'|trans }}</th>
                            <th>{{ 'Purpose'|trans }}</th>
                            <th>{{ 'Comments'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for data in entity %}
                            <tr>
                                <td align="center">{{ loop.index }}</td>
                                <td>{{ data.agentName }}</td>
                                <td>{{ data.agentAddress }}</td>
                                <td>{{ data.agentMobile }}</td>
                                <td>{{ data.purposeName }}</td>
                                <td>{{ data.comments }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
            {% endif %}
        {% endif %}
    {% endfor %}

{% endif %}
</body>
</html>