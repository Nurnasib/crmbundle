<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Daily Visit Report</title>
    <style>
        body {
            font-size: 12px;
        }
    </style>
</head>
<body>
<div style="text-align: center">
    <h3 class="text-center" style="margin: 0px;">{{ 'NOURISH POULTRY AND HATCHERY LTD'|trans }}</h3>
    <h5 class="text-center" style="margin: 0px;">{{ 'UTTARA, DHAKA.'|trans }}</h5>
    {% if entities is defined and entities is not empty %}
        <h6 class="text-center" style="margin: 0 0 10px;">
            {{ 'VISIT REPORT'|trans }} :
            {% if entities.visitDate.begin|date('d-m-Y') is not empty %}
                {{ entities.visitDate.begin|date('d-m-Y') }} - {{ entities.visitDate.end|date('d-m-Y') }}
            {% endif %}
        </h6>
    {% endif %}
</div>
{% if entities is defined and entities is not empty %}
    {% for employeeId, employee in entities %}
        {% if employeeId is not same as 'visitDate' %}
            <table width="100%" style="background-color: #CCCCCC; margin-top: 20px">
                <thead>
                <tr>
                    <th>{{ 'Officer ID'|trans }}: {{ employeeId }}</th>
                    <th>{{ 'Name of Officer'|trans }}: {{ entities[employeeId]['employeeName']|default }}</th>
                    <th>
                        {{ 'Date'|trans }}:
                        {% if entities.visitDate.begin|date('d-m-Y') is not empty %}
                            {{ entities.visitDate.begin|date('d-m-Y') }} - {{ entities.visitDate.end|date('d-m-Y') }}
                        {% else %}
                            {{ entities.visitDate.begin|date('d-m-Y') }}
                        {% endif %}
                    </th>
                </tr>
                </thead>
            </table>
            {# Agent Section#}
            {% for key, entity in employee %}
                {% if key is same as 'farmer' %}
                    <div style="border: 2px solid green; padding: 0 10px; margin-bottom: 20px" title="Agent Section">
                        <h3 style="text-align: center; background-color: green; color: #fff; padding: 5px 0">Farmer Section</h3>
                        <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                            <thead style="background-color: #CCCCCC">
                            <tr>
                                <th width="50">S/N</th>
                                <th>{{ 'Visited Farmers\' Name'|trans }}</th>
                                <th>{{ 'Address'|trans }}</th>
                                <th>{{ 'Phone'|trans }}</th>
                                <th>{{ 'Purpose'|trans }}</th>
                                <th>{{ 'Farm Capacity'|trans }}</th>
                                <th>{{ 'Comments'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for dateMonthYear, dateWiseRecord in entity %}
                                <tr>
                                    <th colspan="7">{{ dateMonthYear }}</th>
                                </tr>
                                {% for data in dateWiseRecord %}
                                    <tr>

                                        <td align="center">{{ loop.index }}</td>
                                        <td>{{ data.farmerName }}</td>
                                        <td>{{ data.farmerAddress }}</td>
                                        <td>{{ data.farmerMobile }}</td>
                                        <td>
                                            {% if data.purposeMultiple is not empty %}
                                                {% set purposes=data.purposeMultiple|json_decode %}
                                                <ol>
                                                    {% for purpose in purposes %}
                                                        <li>{{ purpose }}</li>
                                                    {% endfor %}
                                                </ol>
                                            {% else %}
                                                {{ data.purposeName }}
                                            {% endif %}
                                        </td>
                                        <td>{{ data.farmCapacity }}</td>
                                        <td>{{ data.comments }}</td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div style="page-break-after: always"></div>
                {% endif %}
            {% endfor %}
            {# Agent Section#}
            {% for key, entity in employee %}
                {% if key is same as 'agent' %}
                    <div style="border: 2px solid red; padding: 10px; margin-bottom: 20px" title="Agent Section">
                        <h3 style="text-align: center; background-color: red; color: #fff; padding: 5px 0">Agent Section</h3>
                        <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                            <thead style="background-color: #CCCCCC">
                            <tr>
                                <th width="50">S/N</th>
                                <th>{{ 'Visited Agent Name(Nourish)'|trans }}</th>
                                <th>{{ 'Address'|trans }}</th>
                                <th>{{ 'Phone'|trans }}</th>
                                <th>{{ 'Purpose'|trans }}</th>
                                <th>{{ 'Report Description'|trans }}</th>
                                <th>{{ 'Comments'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for dateMonthYear, dateWiseRecord in entity %}
                                <tr>
                                    <th colspan="7">{{ dateMonthYear }}</th>
                                </tr>
                                {% for data in dateWiseRecord %}
                                    <tr>
                                        <td align="center">{{ loop.index }}</td>
                                        <td>{{ data.agentName }} ({{ data.agentId|default('') }})</td>
                                        <td>{{ data.agentAddress }}</td>
                                        <td>{{ data.agentMobile }}</td>
                                        <td>
                                            {% if data.purposeMultiple is not empty %}
                                                {% set purposes=data.purposeMultiple|json_decode %}
                                                <ol>
                                                    {% for purpose in purposes %}
                                                        <li>{{ purpose }}</li>
                                                    {% endfor %}
                                                </ol>
                                            {% else %}
                                                {{ data.purposeName }}
                                            {% endif %}
                                        </td>
                                        <td>{{ data.reportDesc }}</td>
                                        <td>{{ data.comments }}</td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div style="page-break-after: always"></div>
                {% endif %}
            {% endfor %}
            {# Other Agent Section#}
            {% for key, entity in employee %}
                {% if key is same as 'other-agent' %}
                    <div style="border: 1px solid blue; padding: 10px; margin-bottom: 20px" title="Other Agent Section">
                        <h3 style="text-align: center; background-color: blue; color: #fff; padding: 5px 0">Other Agent Section</h3>
                        <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                            <thead style="background-color: #CCCCCC">
                            <tr>
                                <th width="50">S/N</th>
                                <th>{{ 'Visited Agent Name(Other Agent)'|trans }}</th>
                                <th>{{ 'Address'|trans }}</th>
                                <th>{{ 'Name Agent'|trans }}</th>
                                <th>{{ 'Phone'|trans }}</th>
                                <th>{{ 'Purpose'|trans }}</th>
                                <th>{{ 'Report Description'|trans }}</th>
                                <th>{{ 'Comments'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for dateMonthYear, dateWiseRecord in entity %}
                                <tr>
                                    <th colspan="8">{{ dateMonthYear }}</th>
                                </tr>
                                {% for data in dateWiseRecord %}
                                    <tr>
                                        <td align="center">{{ loop.index }}</td>
                                        <td>{{ data.agentName }}</td>
                                        <td>{{ data.agentAddress }}</td>
                                        <td>{{ data.nourishAgentName }}</td>
                                        <td>{{ data.agentMobile }}</td>
                                        <td>
                                            {% if data.purposeMultiple is not empty %}
                                                {% set purposes=data.purposeMultiple|json_decode %}
                                                <ol>
                                                    {% for purpose in purposes %}
                                                        <li>{{ purpose }}</li>
                                                    {% endfor %}
                                                </ol>
                                            {% else %}
                                                {{ data.purposeName }}
                                            {% endif %}
                                        </td>
                                        <td>{{ data.reportDesc }}</td>
                                        <td>{{ data.comments }}</td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div style="page-break-after: always"></div>
                {% endif %}
            {% endfor %}
            {#            Sub Agent Section#}
            {% for key, entity in employee %}
                {% if key is same as 'sub-agent' %}
                    <div style="border: 1px solid purple; padding: 5px 10px; margin-bottom: 20px" title="Sub Agent Section">
                        <h3 style="text-align: center; background-color: purple; color: #fff; padding: 5px 0">Sub Agent Section</h3>
                        <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
                            <thead style="background-color: #CCCCCC">

                            <tr>
                                <th width="50">S/N</th>
                                <th>{{ 'Visited Agent Name(Sub Agent)'|trans }}</th>
                                <th>{{ 'Address'|trans }}</th>
                                <th>{{ 'Phone'|trans }}</th>
                                <th>{{ 'Purpose'|trans }}</th>
                                <th>{{ 'Report Description'|trans }}</th>
                                <th>{{ 'Comments'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for dateMonthYear, dateWiseRecord in entity %}
                                <tr>
                                    <th colspan="7">{{ dateMonthYear }}</th>
                                </tr>
                                {% for data in dateWiseRecord %}
                                    <tr>
                                        <td align="center">{{ loop.index }}</td>
                                        <td>{{ data.agentName }}</td>
                                        <td>{{ data.agentAddress }}</td>
                                        <td>{{ data.agentMobile }}</td>
                                        <td>
                                            {% if data.purposeMultiple is not empty %}
                                                {% set purposes=data.purposeMultiple|json_decode %}
                                                <ol>
                                                    {% for purpose in purposes %}
                                                        <li>{{ purpose }}</li>
                                                    {% endfor %}
                                                </ol>
                                            {% else %}
                                                {{ data.purposeName }}
                                            {% endif %}
                                        </td>
                                        <td>{{ data.reportDesc }}</td>
                                        <td>{{ data.comments }}</td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div style="page-break-after: always"></div>
                {% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}

{% else %}
    <table border="1" cellspacing="0" cellpadding="5" width="100%" style="margin-top: 10px">
        <thead>
        <tr>
            <th width="50">Details Not Found!</th>
        </tr>
        </thead>
    </table>
{% endif %}
</body>
</html>