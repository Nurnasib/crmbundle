{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <div class="row">
            <div class="col p-0">
                <table class="table table-striped table-bordered table-hover">
                    <thead class="thead-dark">
                    {{ form_start(form) }}
                    <tr>
                        <th>
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                        </th>

                        <th>
                            {{ form_label(form.agentType, 'Agent Type:') }}
                            {{ form_widget(form.agentType) }}
                        </th>

                        <th>
                            {{ form_label(form.startDate, 'Start Date:') }}
                            {{ form_widget(form.startDate,{'id':'start-date', 'attr':{'placeholder':'dd-mm-YYYY'}}) }}
                        </th>
                        <th>
                            {{ form_label(form.endDate, 'End Date:') }}
                            {{ form_widget(form.endDate,{'id':'end-date', 'attr':{'placeholder':'dd-mm-YYYY'}}) }}
                        </th>
                        <th rowspan="2">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search"
                                        value="search"><i class="fa fa-search" aria-hidden="true"></i></button>

                                <button type="button" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>

                            </div>
                        </th>
                    </tr>
                    </form>

                    </thead>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped table-bordered table-hover details-table download-excel" width="100%">
                        <thead class="thead-dark">
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="9"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="9"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>

                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ 9 }}" align="center"><h5 class="text-center">Date Wise Visit Status Report {% if agentType is defined and agentType != 'all' %}({{ agentType|replace({'-': ' '})|title }}){% endif %}</h5></td>
                        </tr>
                        {% if selectedEmployee is defined and selectedEmployee is not empty %}

                            <tr>
                                <td colspan="2">ID: {{ selectedEmployee.userId }}</td>
                                <td colspan="4">Name: {{ selectedEmployee.name }}</td>
                                <td colspan="3">Designation: {{ selectedEmployee.designation.name|default('') }}</td>
                            </tr>

                        {% endif %}
                        <tr>
                            <th>S/L</th>
                            <th width="5%">Date</th>
                            <th>Day</th>
                            <th>Name</th>
                            <th>Upozila</th>
                            <th>District</th>
                            <th>Agent ID</th>
                            <th>Total (agents)</th>
{#                            <th>Frequency</th>#}
                        </tr>
                        </thead>
                        <tbody>

                        {% set i = 1 %}
                        {% set totalCount = 0 %}
                        {% if records['agent_info'] is defined and records['agent_info'] is not empty %}
                            {% set totalVisitingDate = records['agent_info'] is defined and records['agent_info'] is not empty ? records['agent_info']|length : 0 %}

                        {% for date in allDates %}
                            <tr>
                                <td>{{ i }}</td>
                                <td>{{ date.date }}</td>
                                <td>{{ date.day }}</td>
                                <td>
                                    {#{% if records['agent_info'] is not empty %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if (key == date.date) %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                                                        {{ agent.agentName|default('') }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}#}
                                    {% if records['agent_info'] is not empty %}
                                        {% set shownAgents = [] %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if key == date.date and agent.agentName is not empty and agent.agentName not in shownAgents %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                    {{ agent.agentName }}
                </span>
                                                    {% set shownAgents = shownAgents|merge([agent.agentName]) %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}

                                </td>

                                <td>
                                    {#{% if records['agent_info'] is not empty %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if (key == date.date) %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                                                        {{ agent.agentUpozilaName|default('') }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}#}
                                    {% if records['agent_info'] is not empty %}
                                        {% set shownUpozilas = [] %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if key == date.date and agent.agentUpozilaName is not empty and agent.agentUpozilaName not in shownUpozilas %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                    {{ agent.agentUpozilaName }}
                </span>
                                                    {% set shownUpozilas = shownUpozilas | merge([agent.agentUpozilaName]) %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}

                                </td>

                                <td>
                                    {#{% if records['agent_info'] is not empty %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if (key == date.date) %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                                                        {{ agent.agentDistrictName|default('') }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}#}
                                    {% if records['agent_info'] is not empty %}
                                        {% set shownDistricts = [] %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if key == date.date and agent.agentDistrictName is not empty and agent.agentDistrictName not in shownDistricts %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                    {{ agent.agentDistrictName }}
                </span>
                                                    {% set shownDistricts = shownDistricts | merge([agent.agentDistrictName]) %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}

                                </td>

                                <td>
                                    {#{% if records['agent_info'] is not empty %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if (key == date.date) %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                                                        {{ agent.agentId|default('') }}
                                                    </span>
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}#}
                                    {% if records['agent_info'] is not empty %}
                                        {% set shownAgentIds = [] %}
                                        {% for key, agents in records['agent_info'] %}
                                            {% for agent in agents %}
                                                {% if key == date.date and agent.agentId is not empty and agent.agentId not in shownAgentIds %}
                                                    <span style="display: inline-block; margin-right: 2px; margin-bottom: 2px; padding: 2px 4px; border: 1px solid grey; border-radius: 5px">
                    {{ agent.agentId }}
                </span>
                                                    {% set shownAgentIds = shownAgentIds | merge([agent.agentId]) %}
                                                    {% set totalCount = shownAgentIds|length %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    {% endif %}
                                </td>

                                <td style="text-align: center">
                                    {% if records['visitCount'] is not empty %}
                                        {% for key, visitCount in records['visitCount'] %}
                                                {% if (key == date.date) %}
{#                                                    {{ visitCount|default('') }}#}
                                                    {{ totalCount }}
                                                {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                {#<td>
                                    {% if records['visitCount'] is not empty %}
                                        {% for key, visitCount in records['visitCount'] %}
                                            {% if (key == date.date) %}
#}{#                                                {{ totalVisitingDate > 0 ? ((visitCount/totalVisitingDate)*100)|number_format(2):0 }}%#}{#
                                                {{ totalVisitingDate > 0 ? ((totalCount/totalVisitingDate)*100)|number_format(2):0 }}%
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}

                                </td>#}
                            </tr>
                            {% set i = i + 1 %}
                        {% endfor %}
                        {% endif %}

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
     <style>
         /*table.details-table thead {
             position: sticky;
             top: -2px;
             background-color: #dbdee3 !important;
             border-bottom-color: #4C9EE7 !important;
             z-index: 99;
         }*/

     </style>
 {% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>
        $('.element').tooltip('show')
        let button = document.querySelector("#button-excel");

        if(button){
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "{{ 'agent_visit_monitor'}}.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }
    </script>
{% endblock %}
{% block documentready %}
    {{ parent() }}

    {#    <script>#}
    $('#start-date, #end-date').datepicker(
    {
    dateFormat: 'dd-mm-yy',
    changeMonth: true,
    changeYear: true
    }
    );
    {#    Append Employee details#}
    jQuery("#detailsModal").on("show.bs.modal", function(e) {
    var url = jQuery(e.relatedTarget).data('action');

    jQuery.get( url, function( data ) {
    jQuery(".modal-body").html(data.html);
    });

    });

    $('#datatable').DataTable( {
    pageLength: 25,
    });
{% endblock %}