{% extends 'admin/layout.html.twig' %}

{# The working-mode keys below mirror $flagKeys in
   CrmVisitRepository::getEmployeeMonthlyActivity(). They are the slugs of the ten
   crm_setting rows of setting_type WORKING_MODE; add a mode there and it needs a
   label plus a symbol here, otherwise its row renders without either. #}
{% set parameterLabels = {
    'agent': 'Agents Visit Number',
    'sub-agent': 'S Agents No.',
    'farmer': 'Farmers No.',
    'other-agent': 'Others Agents No.',
    'leave': 'Leave',
    'office-work': 'Office Work',
    'holiday': 'Holiday',
    'meeting': 'Meeting',
    'training': 'Training',
    'workshop': 'Workshop',
    'conference': 'Conference',
    'traveling': 'Traveling',
    'other-1': 'Other',
    'working': 'Working'
} %}
{% set parameterOrder = [
    'agent', 'sub-agent', 'farmer', 'other-agent',
    'leave', 'office-work', 'holiday',
    'meeting', 'training', 'workshop', 'conference', 'traveling', 'other-1', 'working'
] %}
{# Flag rows render a letter on the days they apply and stay blank otherwise. #}
{% set flagSymbols = {
    'leave': 'L',
    'office-work': 'OW',
    'holiday': 'H',
    'meeting': 'M',
    'training': 'T',
    'workshop': 'WS',
    'conference': 'C',
    'traveling': 'TR',
    'other-1': 'O',
    'working': 'W'
} %}
{% set totalColumns = 34 %}

{% block body %}
    <div class="pcoded-inner-content">

        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col p-0">
                {{ form_start(form) }}
                <table class="table">
                    <thead class="thead-dark">
                    <tr>
                        <th>
                            {{ form_label(form.reportType, 'Report Type:') }}
                            {{ form_widget(form.reportType) }}
                        </th>
                        <th id="monthly-activity-employee-filter" style="min-width: 200px">
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                        </th>
                        <th id="monthly-activity-line-manager-filter" style="min-width: 200px">
                            {{ form_label(form.lineManager, 'Line Manager:') }}
                            {{ form_widget(form.lineManager) }}
                        </th>
                        <th>
                            {{ form_label(form.startMonth, 'Start Month:') }}
                            {{ form_widget(form.startMonth) }}
                            {{ form_errors(form.startMonth) }}
                        </th>
                        <th id="monthly-activity-end-month-filter">
                            {{ form_label(form.endMonth, 'End Month:') }}
                            {{ form_widget(form.endMonth) }}
                            {{ form_errors(form.endMonth) }}
                        </th>
                        <th>
                            {{ form_label(form.year, 'Year:') }}
                            {{ form_widget(form.year) }}
                            {{ form_errors(form.year) }}
                        </th>
                        <th colspan="1">
                            <div class="btn-group" style="margin-top: 25px">
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('employee_monthly_activity_report') }}" class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                {% if employeeBlocks is not empty %}
                                    <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                                {% endif %}
                            </div>
                        </th>
                    </tr>
                    </thead>
                </table>
                {{ form_widget(form._token) }}
                </form>
            </div>
        </div>

        <div class="row">
            <div class="card" style="overflow-x: scroll; max-height: 90vh">
                <div id="data-load" class="card-body p-0">
                    <table class="table table-striped table-bordered table-hover download-excel" id="datatable">
                        <thead>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
                        </tr>
                        <tr>
                            <th data-a-h="center" class="border-0" colspan="{{ totalColumns }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
                        </tr>
                        <tr>
                            <td data-a-h="center" class="border-0" colspan="{{ totalColumns }}" align="center"><h6>{{ 'Employee Monthly Activity Report'|upper }}</h6></td>
                        </tr>
                        {% if reportType == 'line_manager' and selectedLineManager %}
                            <tr>
                                <td class="border-0" colspan="{{ totalColumns }}">
                                    <strong>Line Manager ID:</strong> {{ selectedLineManager.userId }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>Line Manager Name:</strong> {{ selectedLineManager.name }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>Month:</strong> {{ startMonth }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>Year:</strong> {{ year }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>Employees:</strong> {{ employeeBlocks|length }}
                                </td>
                            </tr>
                        {% elseif selectedEmployee %}
                            <tr>
                                <td class="border-0" colspan="{{ totalColumns }}">
                                    <strong>Emp ID:</strong> {{ selectedEmployee.userId }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>Emp Name:</strong> {{ selectedEmployee.name }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>Start Month:</strong> {{ startMonth }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>End Month:</strong> {{ endMonth }}
                                    &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <strong>Year:</strong> {{ year }}
                                </td>
                            </tr>
                        {% endif %}
                        </thead>

                        <thead class="thead-dark">
                        <tr class="data-header">
                            <th scope="col">Year</th>
                            <th scope="col">Month</th>
                            <th scope="col" style="min-width: 160px">Parameter</th>
                            {% for d in 1..31 %}
                                <th scope="col">{{ d }}</th>
                            {% endfor %}
                        </tr>
                        </thead>

                        <tbody>
                        {% if employeeBlocks is not empty %}
                            {% for employeeId, entry in employeeBlocks %}
                                {% if reportType == 'line_manager' %}
                                    <tr>
                                        <td colspan="{{ totalColumns }}" style="background-color: #f4f4f4;">
                                            <strong>Emp ID:</strong> {{ entry.employee.userId }}
                                            &nbsp;&nbsp;|&nbsp;&nbsp;
                                            <strong>Emp Name:</strong> {{ entry.employee.name }}
                                            &nbsp;&nbsp;|&nbsp;&nbsp;
                                            <strong>Designation:</strong> {{ entry.employee.designation.name|default('') }}
                                        </td>
                                    </tr>
                                {% endif %}
                                {% if entry.blocks is not empty %}
                                    {% for block in entry.blocks %}
                                        {% for parameter in parameterOrder %}
                                            <tr>
                                                {% if loop.first %}
                                                    <td data-t="n" rowspan="{{ parameterOrder|length }}">{{ block.year }}</td>
                                                    <td rowspan="{{ parameterOrder|length }}">{{ block.label }}</td>
                                                {% endif %}
                                                <td>{{ parameterLabels[parameter] }}</td>
                                                {% for d in 1..31 %}
                                                    {% if d > block.daysInMonth %}
                                                        <td style="background-color: #e9ecef;"></td>
                                                    {% else %}
                                                        {% set value = block.rows[parameter][d] %}
                                                        {% if flagSymbols[parameter] is defined %}
                                                            <td class="text-center">{{ value ? flagSymbols[parameter] : '' }}</td>
                                                        {% else %}
                                                            {# Blank is the single "no visits" marker - a zero count and a day
                                                               with nothing filed both render empty. Swap to
                                                               `value is null ? '' : value` to show explicit zeros instead. #}
                                                            <td data-t="n">{{ value ? value : '' }}</td>
                                                        {% endif %}
                                                    {% endif %}
                                                {% endfor %}
                                            </tr>
                                        {% endfor %}
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="{{ totalColumns }}" class="text-center">No data found</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="{{ totalColumns }}" class="text-center">
                                    {% if submitted and reportType == 'line_manager' and not selectedLineManager %}
                                        Please select a line manager.
                                    {% elseif submitted and reportType == 'line_manager' and selectedLineManager %}
                                        No employees found under this line manager.
                                    {% elseif submitted and reportType == 'employee' and not selectedEmployee %}
                                        Please select an employee.
                                    {% else %}
                                        No data found
                                    {% endif %}
                                </td>
                            </tr>
                        {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
        table thead tr.data-header th{
            border: 2px solid #b5b5b5 !important;
            border-bottom-color: #b5b5b5 !important;
        }
        #datatable td, #datatable th {
            white-space: nowrap;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('assets/js/tableToExcel.js') }}"></script>
    <script>

        {# Symfony already renders an id on this widget - a second 'id' in the field's
           'attr' would render as a duplicate id="" attribute, which the HTML parser
           resolves by keeping only the first (auto-generated) one, so a hardcoded
           selector for a custom id would silently never match. Read the real id back
           from the form view instead. #}
        let monthlyActivityReportType = document.getElementById('{{ form.reportType.vars.id }}');

        function syncMonthlyActivityReportType() {
            if (!monthlyActivityReportType) {
                return;
            }
            let isLineManager = monthlyActivityReportType.value === 'line_manager';
            document.querySelector('#monthly-activity-employee-filter').style.display = isLineManager ? 'none' : '';
            document.querySelector('#monthly-activity-line-manager-filter').style.display = isLineManager ? '' : 'none';
            document.querySelector('#monthly-activity-end-month-filter').style.display = isLineManager ? 'none' : '';
        }

        syncMonthlyActivityReportType();
        if (monthlyActivityReportType) {
            monthlyActivityReportType.addEventListener('change', syncMonthlyActivityReportType);
        }

        let button = document.querySelector("#button-excel");

        if (button) {
            button.addEventListener("click", e => {
                e.preventDefault();
                let table = document.querySelector(".download-excel");
                TableToExcel.convert(table, {
                    name: "employee_monthly_activity_report.xlsx",
                    sheet: {
                        name: "Sheet 1"
                    }
                });
            });
        }

    </script>
{% endblock %}
