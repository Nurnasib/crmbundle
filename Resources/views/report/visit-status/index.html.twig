{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <div class="row">
            <div class="col p-0">
                <table class="table table-striped table-bordered table-hover">
                    <thead class="thead-dark">
                    {{ form_start(form) }}
                    <tr>
                        <th>
                            {{ form_label(form.employee, 'Employee:', { 'label_attr': {'class': 'col-md-3 text-right'}}) }}
                            <div class="col-md-9 p-0">
                                {{ form_widget(form.employee) }}
                            </div>
                        </th>
                        <th>
                            {{ form_label(form.month, 'Month:', { 'label_attr': {'class': 'col-md-3 text-right'}}) }}
                            <div class="col-md-9 p-0">
                                {{ form_widget(form.month) }}
                            </div>
                        </th>
                        <th>
                            {{ form_label(form.year, 'Year:', { 'label_attr': {'class': 'col-md-3 text-right'}}) }}
                            <div class="col-md-9 p-0">
                                {{ form_widget(form.year) }}
                            </div>
                        </th>
                        <th rowspan="2">
                            <div class="btn-group">
                                <button type="submit" name="search" class="btn btn-primary btn-sm"
                                        title="Search"
                                        value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a href="{{ path('visit_status') }}" class="btn purple-bg btn-sm white-font"
                                   title="Reset" value="reset"><i class="fa fa-refresh" aria-hidden="true"></i></a>

                            </div>
                        </th>
                    </tr>
                    </form>

                    </thead>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-body p-0" style="overflow: auto; height: 64vh">
                    <table class="table table-striped table-bordered table-hover details-table" width="100%">
                        <thead class="thead-dark">
                        <tr>
                            <th rowspan="2">S/L</th>
                            <th rowspan="2">Employee ID</th>
                            <th rowspan="2">Name</th>
                            <th colspan="31" class="text-center">Days</th>
                        </tr>
                        <tr>
                            {% if lastDayOfMonth is defined and lastDayOfMonth is not null %}
                                {% for day in 1..lastDayOfMonth|date('d') %}
                                    <th class="text-center">{{ "%02d"|format(day) }}</th>
                                {% endfor %}
                            {% endif %}
                        </tr>
                        </thead>
                        <tbody>
                        {% if selectedEmployee is defined and selectedEmployee is not null %}
                            {% if visitStatus is defined and visitStatus is not null %}
                                <tr>
                                    <td>1</td>
                                    <td>{{ selectedEmployee.userId }}</td>
                                    <td>{{ selectedEmployee.name }}</td>

                                    {% if lastDayOfMonth is defined and lastDayOfMonth is not null %}
                                        {% for day in 1..lastDayOfMonth|date('d') %}
                                            <td align="center">
                                                {% if visitStatus[selectedEmployee.id]["%02d"|format(day)] is defined %}

                                                    <a style="text-decoration: underline;"
                                                       href="{{ path('visit_details_report', {'mode': 'pdf', 'visitDate': day ~ '-' ~ firstDayOfMonth|date('m-Y'), 'employeeId': selectedEmployee.id }) }}"
                                                       target="_blank"
                                                       title="View visit details">{{ visitStatus[selectedEmployee.id]["%02d"|format(day)]|length }}</i></a>
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    {% endif %}

                                </tr>
                            {% endif %}
                        {% else %}
                            {% if employees is defined and employees is not null %}
                                {% for employee in employees %}
                                    <tr>
                                        <td>{{ loop.index }}</td>
                                        <td>{{ employee.userId }}</td>
                                        <td>{{ employee.name }}</td>

                                        {% if lastDayOfMonth is defined and lastDayOfMonth is not null %}
                                            {% for day in 1..lastDayOfMonth|date('d') %}
                                                <td align="center">
                                                    {% if visitStatus[employee.id]["%02d"|format(day)] is defined %}
                                                        <a style="text-decoration: underline;"
                                                           href="{{ path('visit_details_report', {'mode': 'pdf', 'visitDate': day ~ '-' ~ firstDayOfMonth|date('m-Y'), 'employeeId': employee.id }) }}"
                                                           target="_blank">{{ visitStatus[employee.id]["%02d"|format(day)]|length }}</a>
                                                    {% else %}
                                                        -
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        {% endif %}

                                    </tr>
                                {% endfor %}
                            {% endif %}
                        {% endif %}
                        </tbody>
                        <tfoot>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
     <style>
         table.details-table thead {
             position: sticky;
             top: -2px;
             background-color: #dbdee3 !important;
             border-bottom-color: #4C9EE7 !important;
         }

         .ui-datepicker-calendar {
             display: none
         }
     </style>
 {% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock %}
{% block documentready %}
    {{ parent() }}

    {#    <script>#}

    {#    Append Employee details#}
    jQuery("#detailsModal").on("show.bs.modal", function(e) {
    var url = jQuery(e.relatedTarget).data('action');

    jQuery.get( url, function( data ) {
    jQuery(".modal-body").html(data.html);
    });

    });

    $('#datatable').DataTable( {
    pageLength: 25,
    });
{% endblock %}