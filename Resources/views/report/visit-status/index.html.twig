{% extends 'admin/layout.html.twig' %}
{% block body_id 'kpi_domain_new' %}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"><a
                                    href="{{ path('visit_status') }}">  {{ 'Visit Status'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card mb-1">
                <div class="card-header py-2">
{#                    {% if is_granted("ROLE_KPI_ADMIN") %}#}
{#                        <h5>{{ 'Monthly KPI Status (All Employee)' }}</h5>#}
{#                    {% else %}#}
{#                        <h5>{{ 'Monthly KPI Status (Team Members)' }}</h5>#}
{#                    {% endif %}#}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card mb-1">
                <div class="card-body p-1">
                    <div class="col-md-6 offset-3">
                        <form action="#" method="get">
                            <table class="table table-striped table-bordered table-hover">
                                <thead class="thead-dark">
                                <tr role="row" class="filter">
                                    <th colspan="2">
                                        <select class="form-control select2" name="lineManager">
                                            <option value="">Select Employee</option>

                                        </select>
                                    </th>
                                    <th colspan="2">
                                        <input type="text" name="startMonthYear" id="startMonthYearBottomTenFilter"
                                               value=""
                                               placeholder="Month,Year" class="inputMonth form-control"
                                               autocomplete="off">
                                    </th>

                                    <th colspan="1">
                                        <div class="btn-group">
                                            <button type="submit" title="search" class="btn btn-primary btn-sm"><i
                                                        class="fa fa-search" aria-hidden="true"></i></button>
                                            <button type="reset" title="Reset" class="btn purple-bg btn-sm white-font"><i
                                                        class="fa fa-refresh" aria-hidden="true"></i></button>
{#                                            <a href="{{ path('visit_status') }}"#}
{#                                               class="btn purple-bg btn-sm white-font" title="Reset" value="reset"><i#}
{#                                                        class="fa fa-refresh" aria-hidden="true"></i></a>#}
                                        </div>
                                    </th>
                                </tr>
                                </thead>
                            </table>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-header pt-0 pb-0">
                </div>
                <div class="card-body" style="padding: 0; margin: 10px; overflow: auto; height: 64vh">
                    <table class="table table-striped table-bordered table-hover details-table" width="100%">
                        <thead class="thead-dark">
                        <tr>
                            <th rowspan="2">S/L</th>
                            <th rowspan="2">Employee ID</th>
                            <th rowspan="2">Name</th>
                            <th colspan="31" class="text-center">Days</th>
                        </tr>
                        <tr>
                            {% for day in 1..31 %}
                                <th class="text-center">{{ day }}</th>
                            {% endfor %}
                        </tr>
                        </thead>
                        <tbody>

                        </tbody>
                        <tfoot>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>

    <!-- Modal -->
    <div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header" style="display: block">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                    <h4 class="modal-title" id="myModalLabel">Employee Details</h4>
                </div>

                <div class="modal-body">

                </div>


            </div>
        </div>
    </div>
    <style>
        .modal-lg {
            width: 65%;
            max-width: 65%;
            /*height: 100%;*/
            padding: 0;
        }

        .modal-content {
            height: auto;
            min-height: 100%;
            border-radius: 0;
        }
    </style>








{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
     <style>
         table.details-table thead {
             position: sticky;
             top: -2px;
             background-color: #dbdee3 !important;
             border-bottom-color: #4C9EE7!important;
         }
         .ui-datepicker-calendar {
             display: none
         }
     </style>
 {% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock %}
{% block documentready %}
    {{ parent() }}

{#    <script>#}

        {#    Append Employee details#}
        jQuery("#detailsModal").on("show.bs.modal", function(e) {
            var url = jQuery(e.relatedTarget).data('action');

            jQuery.get( url, function( data ) {
                jQuery(".modal-body").html(data.html);
            });

        });

        $('#datatable').DataTable( {
            pageLength: 25,
        });


    // Month Year Picker
    $('.inputMonth').datepicker({
        changeMonth: true,
        changeYear: true,
        dateFormat: 'MM,yy',
        yearRange: "2020:" + new Date().getFullYear(),

        onClose: function () {
            var iMonth = $("#ui-datepicker-div .ui-datepicker-month :selected").val();
            var iYear = $("#ui-datepicker-div .ui-datepicker-year :selected").val();
            $(this).datepicker('setDate', new Date(iYear, iMonth, 1));
        },

        beforeShow: function () {
            if ((selDate = $(this).val()).length > 0) {
                iYear = selDate.substring(selDate.length - 4, selDate.length);
                iMonth = jQuery.inArray(selDate.substring(0, selDate.length - 5), $(this).datepicker('option', 'monthNames'));
                $(this).datepicker('option', 'defaultDate', new Date(iYear, iMonth, 1));
                $(this).datepicker('setDate', new Date(iYear, iMonth, 1));
            }
        }
    });
{% endblock %}