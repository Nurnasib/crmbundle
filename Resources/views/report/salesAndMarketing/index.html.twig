{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
{#        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="javascript:void(0)">  {{ 'Monthly Report'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>#}
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->

        <div class="row">
            <div class="col p-0">
                <table class="table">
                    <thead class="thead-dark">
                    {{ form_start(form, { 'attr' : { 'class': 'sales_marketing_search_form' } }) }}
                    <tr>

                        {% if report=='company-wise-doc-price-daily' or report =='company-wise-doc-price-monthly' %}
                            <th>
                                {{ form_label(form.region, 'Region:') }}
                                {{ form_widget(form.region) }}
                            </th>
                            <th>
                                {{ form_label(form.hatchery, 'Company:') }}
                                {{ form_widget(form.hatchery) }}
                            </th>
                            <th>
                                {{ form_label(form.poultryFramType, 'Doc Type:') }}
                                {{ form_widget(form.poultryFramType) }}
                            </th>
                        {% else %}
                        <th>
                            {{ form_label(form.employee, 'Employee:') }}
                            {{ form_widget(form.employee) }}
                        </th>
                        {% endif %}
                        {% if report=='doc-price-daily' or report =='doc-price-monthly' %}
                        <th>
                            {{ form_label(form.region, 'Region:') }}
                            {{ form_widget(form.region) }}
                        </th>
                        <th>
                            {{ form_label(form.poultryFramType, 'Doc Type:') }}
                            {{ form_widget(form.poultryFramType) }}
                        </th>
                        {% endif %}
                        {% if report=='meat-egg-price-daily' or report=='meat-egg-price-monthly' %}
                        <th>
                            {{ form_label(form.region, 'Region:') }}
                            {{ form_widget(form.region) }}
                        </th>
                        <th>
                            {{ form_label(form.meatEggBreedType, 'Type:') }}
                            {{ form_widget(form.meatEggBreedType) }}
                        </th>
                        {% endif %}

                        {% if report =='doc-price-monthly' or report =='company-wise-doc-price-monthly' or report=='meat-egg-price-monthly' %}
                            <th>
                                {{ form_label(form.startMonth, 'Start Month:') }}
                                {{ form_widget(form.startMonth) }}
                            </th>
                            <th>
                                {{ form_label(form.endMonth, 'End Month:') }}
                                {{ form_widget(form.endMonth) }}
                            </th>
                        {% else %}

                            <th>
                                {{ form_label(form.startDate, 'Start Date:') }}
                                {{ form_widget(form.startDate) }}
                            </th>
                            <th>
                                {{ form_label(form.endDate, 'End Date:') }}
                                {{ form_widget(form.endDate) }}
                            </th>
                        {% endif %}

                        {% if report!="doc-price-daily" and report!="doc-price-monthly" and report!="company-wise-doc-price-daily" and report!="company-wise-doc-price-monthly" and report!="meat-egg-price-daily" and report!="meat-egg-price-monthly"  and report!="challenges-problem" and report!="challenges-idea" and report!="competitors-activity" and report!="doc-complain" and report!="feed-complain" %}
                        <th>
                            {{ form_label(form.year, 'Year:') }}
                            {{ form_widget(form.year) }}
                        </th>
                        <th>
                            {{ form_label(form.month, 'Month:') }}
                            {{ form_widget(form.month) }}
                        </th>
                        {% endif %}
                        <th style="vertical-align: bottom!important;">
                            <div class="btn-group float-right">
                                {{ form_widget(form._token) }}
                                <button type="submit" name="search" class="btn btn-primary btn-sm" title="Search" value="search"><i class="fa fa-search" aria-hidden="true"></i></button>
                                <a title="reset" href="{{ path('sales_marketing_report_index',{'report':reportSlug}) }}" name="reset" class="btn purple-bg btn-sm white-font"><i class="fa fa-refresh" aria-hidden="true"></i></a>
                                <button type="submit" name="excel" class="btn blue-bg btn-sm white-font" title="Excel" value="excel" id="button-excel"><i class="fa fa-file-excel" aria-hidden="true"></i> {{ 'Excel'|trans }}</button>
                            </div>
                        </th>
                    </tr>
                    <tr>


{#                        <th></th>#}
                    </tr>
                    </form>
                    </thead>
                </table>
            </div>
        </div>
        {% if entities is defined %}
            <div class="row">
                <div class="card" style="overflow-x: scroll; max-height: 75vh">
                    <div class="card-body p-0">
                        {% if reportSlug is same as 'challenges-problem' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/challenger/problems.twig'%}

                        {% elseif reportSlug is same as 'challenges-idea' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/challenger/ideas.twig'%}


                        {% elseif reportSlug is same as 'competitors-activity' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/challenger/competitors-activity.twig'%}

                        {% elseif reportSlug is same as 'doc-price-monthly' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/doc-price/_doc_price.html.twig'%}

                        {% elseif reportSlug is same as 'doc-price-daily' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/doc-price/_daily_doc_price.html.twig'%}

                        {% elseif reportSlug is same as 'company-wise-doc-price-monthly' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/doc-price/_doc_price_company_wise.html.twig'%}

                        {% elseif reportSlug is same as 'company-wise-doc-price-daily' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/doc-price/_daily_doc_price_company_wise.html.twig'%}

                        {% elseif reportSlug is same as 'meat-egg-price-monthly' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/meat-egg/_meat_egg_price.html.twig'%}

                        {% elseif reportSlug is same as 'meat-egg-price-daily' %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/meat-egg/_meat_egg_price_daily.html.twig'%}


                        {% elseif reportSlug in ['doc-complain'] %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/_doc_complain.html.twig'%}

                        {% elseif reportSlug in ['feed-complain'] %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/_feed_complain.html.twig'%}

                        {% elseif reportSlug in ['company-wise-feed-sale-poultry','company-wise-boiler-chick','company-wise-layer-chick','company-wise-feed-sale-cattle','company-wise-feed-sale-fish'] %}
                            {% include '@TerminalbdCrm/report/salesAndMarketing/inc/_company_wise_feed_sale.html.twig'%}

                        {% endif %}

                    </div>
                </div>
            </div>
        {% endif %}





        <!-- [ Main Content ] end -->
    </div>
{% endblock %}

{% block cssBlock %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
