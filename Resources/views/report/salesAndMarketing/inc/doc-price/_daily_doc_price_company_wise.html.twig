<table class="table table-striped table-bordered table-hover download-excel">
    <thead>
    <tr>
        <th data-a-h="center" class="border-0" colspan="{{ entities['dateRange'] is defined ? entities['dateRange']|length+2:0 }}"><h3 class="text-center">NOURISH POULTRY AND HATCHERY LTD</h3></th>
    </tr>
    <tr>
        <th data-a-h="center" class="border-0" colspan="{{ entities['dateRange'] is defined ? entities['dateRange']|length+2:0 }}"><h5 class="text-center">UTTARA, DHAKA.</h5></th>
    </tr>

    <tr>
        <td data-a-h="center" class="border-0" colspan="{{ entities['dateRange'] is defined ? entities['dateRange']|length+2:0 }}" align="center"><h6>DOC Price Daily (Company Wise)</h6></td>
    </tr>
    <tr>
        <td data-a-h="center" class="border-0" colspan="{{ entities['dateRange'] is defined ? entities['dateRange']|length+2:0 }}" align="center"><h6>{{ filterBy['startDate'] is defined? 'Date: '~ filterBy['startDate']:'' }} {{ filterBy['endDate'] is defined? ' To '~ filterBy['endDate']:'' }}</h6></td>
    </tr>
    </thead>
    {% if entities is defined and entities['records'] is defined and entities['records'] is not empty %}

        {% if entities['records'] is defined and entities['records'] is not empty %}
            {% for chickType, entity in entities['records'] %}
                <thead>
                <tr>
                    <th class="border-0" scope="col" colspan="{{ entities['dateRange']|length+2 }}" style="text-align: left; background-color: yellow; font-size: 20px">{{ chickType|replace({' (Pcs)': ''}) }} Doc</th>
                </tr>
                </thead>
                <thead class="thead-dark">

                <tr>
                    
                    <th scope="col">Company</th>
                    <th scope="col">Avg. Price</th>
                    {% if entities['dateRange'] is defined and entities['dateRange'] is not empty %}
                        {% for reportingDate in entities['dateRange'] %}
                            <th scope="col" style="text-align: center"><span style="transform: rotate(-30deg);text-align: center; min-width: 65px; padding: 0!important; display: block">{{ reportingDate }}</span></th>
                        {% endfor %}
                    {% endif %}
                </tr>
                </thead>
{#                {% for employeeId, data in entity %}#}

                    <tbody>
                    {% for company, details in entity %}
                        <tr>

                            <td>{{ entities['feedCompany'][chickType][company]|default('') }}</td>
                            <td data-t="n" >{{ details|length>0?((details|arraySum)/(details|length))|number_format(2,'.',''):'' }}</td>
                            {% if entities['dateRange'] is defined and entities['dateRange'] is not empty %}
                                {% for reportingDate in entities['dateRange'] %}
                                    <th data-t="n" align="center">
            {#                            {{ reportingDate }}#}
                                        {% if details[reportingDate] is defined %}
                                            {{ details[reportingDate]|number_format(2) }}
                                        {% else %}
                                            0
                                        {% endif %}
                                    </th>
                                {% endfor %}
                            {% endif %}

                        </tr>
                    {% endfor %}
                    </tbody>
{#                {% endfor %}#}

            {% endfor %}

        {% else %}
            <tbody>
                <tr>
                    <td colspan="{{ entities['dateRange'] is defined ? entities['dateRange']|length+2:0 }}">No record found</td>
                </tr>
            </tbody>
        {% endif %}
    {% endif %}
</table>
