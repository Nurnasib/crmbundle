<table class="table table-striped table-bordered table-hover download-excel" id="fcrReportDetails">
    <thead class="thead-dark" style="background-color: #dbdee3">
    <tr>
        <th>SL.</th>
        <th>Details</th>
    </tr>

    </thead>
    <tbody>
    {% if entities is not empty %}
        {% for entity in entities %}
        <tr>
            <td>{{ loop.index }}</td>
            <td>{{ entity.description }}</td>
        </tr>
        {% endfor %}

    {% endif %}
    </tbody>
</table>