
    <div class="row">
        <div class="card" style="overflow: scroll">
{#            <h4 class="bg-secondary text-center p-1">{{ monthYear[1]~'-'~monthYear[2] }}</h4>#}
            <table class="table table-striped table-bordered table-hover filter-result download-excel" width="100%">
                {% for month, entity in entities %}
                {% set monthYear = month|split('-') %}
                <thead class="thead-dark">
                <tr>
                    <td data-a-h="center" colspan="29" align="center"><h3>NOURISH POULTRY AND HATCHERY LTD</h3></td>
                </tr>
                <tr>
                    <td data-a-h="center" colspan="29" align="center"><h5>UTTARA, DHAKA.</h5></td>
                </tr>
                <tr>
                    <td data-a-h="center" colspan="29" align="center"><h6>{{ lifeCycleSlug=='fish-life-cycle-report'?'Fish Life Cycle (Culture) Report':'' }}</h6></td>
                </tr>
                <tr>
                    <th colspan="5">Officer's ID: {{ employee ? employee.userId : '' }}</th>
                    <th colspan="6">Officer's Name: {{ employee ? employee.name : '' }}</th>
                    <th colspan="6">Designation: {{ employee and employee.designation ? employee.designation.name : '' }}</th>
                    <th colspan="6">Region: {{ employee and employee.regional ? employee.regional.name : '' }}</th>
                    <th colspan="6">Month: {{ monthYear[1] }}</th>
                </tr>
                <tr>
                    <th data-a-h="center" scope="col" colspan="2" style="text-align: center">Farmer</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Feed Used Type</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Feed Company</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Feed Item Name</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Main Culture Species</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Culture area (m2) or decimal</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Hatchery Name</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Stocking date</th>
                    <th data-a-v="middle" scope="col" rowspan="2">No.of initial fish (pcs.)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Average initial weight (g)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Previous Sampling date</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Present Sampling date</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Culture days (During sampling)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Weight gain (g)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Weight gain (kg)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Current feed consumption (kg)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Current FCR</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Current ADG (g/fish/day)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">No.of Final fish (pcs.)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Final weight (g)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Final weight (kg)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Total DOC (Day Of Culture)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Total feed consumption (kg)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Final FCR</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Final ADG (g/fish/day)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">SR(%)</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Farmer Comments</th>
                    <th data-a-v="middle" scope="col" rowspan="2">Visitor's Comments</th>
                </tr>
                <tr>
                    <th scope="col">Farmer Name</th>
                    <th scope="col">Mobile No.</th>
                </tr>
                </thead>

                <tbody>
                {% for details in entity %}
                    <tr>
                        <td>{{ details.customer.name }}</td>
                        <td>{{ details.customer.mobile }}</td>
                        <td>{{ details.feedType }}</td>
                        <td>{{ details.feed.name|default('') }}</td>
                        <td>{{ details.feedItemName }}</td>
                        <td>{{ details.mainCultureSpecies }}</td>
                        <td>{{ details.cultureAreaDecimal|number_format(2,'.','') }}</td>
                        <td>{{ details.hatchery.name|default('') }}</td>
                        <td data-t="s">{{ details.stockingDate ? details.stockingDate|date('d-m-Y') : '' }}</td>
                        <td data-t="n">{{ details.noOfInitialFish|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.averageInitialWeight|number_format(2,'.','') }}</td>
                        <td data-t="s">{{ details.previousSamplingDate ? details.previousSamplingDate|date('d-m-Y') : '' }}</td>
                        <td data-t="s">{{ details.presentSamplingDate ? details.presentSamplingDate|date('d-m-Y') : '' }}</td>
                        <td data-t="n">{{ details.currentCultureDays|number_format(0) }}</td>
                        <td data-t="n">{{ details.weightGainGm|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.weightGainKg|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.currentFeedConsumptionKg|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.currentFcr|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.currentAdg|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.noOfFinalFish|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.finalWeightGm|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.finalWeightKg|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.totalDayOfCulture|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.totalFeedConsumptionKg|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.finalFcr|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.finalAdg|number_format(2,'.','') }}</td>
                        <td data-t="n">{{ details.srPercentage|number_format(2,'.','') }}</td>
                        <td>{{ details.farmerRemarks }}</td>
                        <td>{{ details.employeeRemarks }}</td>
                    </tr>
                {% endfor %}
                </tbody>

                    <tfoot style="display: none">
                    <tr>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                    </tr>
                    </tfoot>

                {% endfor %}
            </table>

        </div>
    </div>

