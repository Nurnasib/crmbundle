{% for month, entity in entities %}
    {% set monthYear = month|split('-') %}

    <table width="100%" style="border: 0">
        <tbody>
        <tr>
            <td colspan="26" align="center"><h3>NOURISH POULTRY AND HATCHERY LTD</h3></td>
        </tr>
        <tr>
            <td colspan="26" align="center"><h5>UTTARA, DHAKA.</h5></td>
        </tr>
        <tr>
            <td colspan="26" align="center"><h6>{{ lifeCycleSlug=='fish-life-cycle-after-sale-report'?'Fish Life Cycle (Harvest) Report':'' }}</h6></td>
        </tr>
        </tbody>
    </table>
    <div class="row">
        <div class="card" style="height: 550px; overflow: scroll">
            <table width="100" class="table table-bordered">
                <thead class="thead-dark">
                <tr>
                    <th>Officer's ID: {{ employee ? employee.userId : '' }}</th>
                    <th>Officer's Name: {{ employee ? employee.name : '' }}</th>
                    <th>Designation: {{ employee and employee.designation ? employee.designation.name : '' }}</th>
                    <th>Region: {{ employee and employee.regional ? employee.regional.name : '' }}</th>
                    <th>Month: {{ monthYear[1] }}</th>
                </tr>
                </thead>
            </table>
{#            <h4 class="bg-secondary text-center p-1">{{ monthYear[1]~'-'~monthYear[2] }}</h4>#}
            <table class="table table-striped table-bordered table-hover filter-result" width="100%">
                <thead class="thead-dark">
                <tr>
                    <th scope="col" colspan="2" style="text-align: center">Farmer</th>
                    <th scope="col" rowspan="2">Feed Used</th>
                    <th scope="col" rowspan="2">Species</th>
{#                    <th scope="col" rowspan="2">Feed Item Name</th>#}
                    <th scope="col" rowspan="2">Feed Company</th>
                    <th scope="col" rowspan="2">Hatchery Name</th>
                    <th scope="col" rowspan="2">Stocking date</th>
                    <th scope="col" rowspan="2">Harvest date</th>
                    <th scope="col" rowspan="2">Culture area (m2)</th>
                    <th scope="col" rowspan="2">No.of initial fish (pcs.)</th>
                    <th scope="col" rowspan="2">Total initial weight (kg)</th>
                    <th scope="col" rowspan="2">Average initial weight (g)</th>
                    <th scope="col" rowspan="2">No.of final fish (pcs.)</th>
                    <th scope="col" rowspan="2">No. of final (kg)</th>
                    <th scope="col" rowspan="2">Average final weight (g)</th>
                    <th scope="col" rowspan="2">Total feed consumption (kg)</th>
                    <th scope="col" rowspan="2">DOC</th>
                    <th scope="col" rowspan="2">ADG (g/fish/day)</th>
                    <th scope="col" rowspan="2">FCR</th>
                    <th scope="col" rowspan="2">SR(%)</th>
                    <th scope="col" rowspan="2">Total seed cost (Taka)</th>
                    <th scope="col" rowspan="2">Total feed cost (tk.)</th>
                    <th scope="col" rowspan="2">Feed Cost/kg fish (tk.)</th>
                    <th scope="col" rowspan="2">Total Others Cost (tk.)</th>
                    <th scope="col" rowspan="2">Total Cost  (tk.)</th>
                    <th scope="col" rowspan="2">Production Cost/Kg fish (tk.)</th>
                    <th scope="col" rowspan="2">Total income  (tk.)</th>
                    <th scope="col" rowspan="2">Profit/ Loss (tk.)</th>
                    <th scope="col" rowspan="2">ROI (Retune Over Investment) %</th>
                    <th scope="col" rowspan="2">Farmer Comments</th>
                    <th scope="col" rowspan="2">Visitor's Comments</th>
                </tr>
                <tr>
                    <th scope="col">Farmer Name</th>
                    <th scope="col">Mobile No.</th>
                </tr>
                </thead>

                <tbody>
                {% for details in entity %}
                    <tr>
                        <td>{{ details.customer.name }}</td>
                        <td>{{ details.customer.mobile }}</td>
                        <td>{{ details.feedType }}</td>
{#                        <td>{{ details.feedItemName }}</td>#}
                        <td>{{ details.mainCultureSpecies }}</td>
                        <td>{{ details.feed.name|default('') }}</td>
                        <td>{{ details.hatchery.name|default('') }}</td>
                        <td>{{ details.stockingDate ? details.stockingDate|date('d-m-Y') : '' }}</td>
                        <td>{{ details.harvestDate ? details.harvestDate|date('d-m-Y') : '' }}</td>
                        <td>{{ details.cultureAreaDecimal|number_format(2) }}</td>
                        <td>{{ details.noOfInitialFish|number_format(2) }}</td>
                        <td>{{ details.totalInitialWeight|number_format(2) }}</td>
                        <td>{{ details.averageInitialWeight|number_format(2) }}</td>
                        <td>{{ details.noOfFinalFish|number_format(2) }}</td>
                        <td>{{ details.finalWeightKg|number_format(2) }}</td>
                        <td>{{ details.finalWeightGm|number_format(2) }}</td>
                        <td>{{ details.totalFeedConsumptionKg|number_format(2) }}</td>
                        <td>{{ details.totalDayOfCulture|number_format(2) }}</td>
                        <td>{{ details.finalAdg|number_format(2) }}</td>
                        <td>{{ details.finalFcr|number_format(2) }}</td>
                        <td>{{ details.srPercentage|number_format(2) }}</td>
                        <td>{{ details.totalSeedCost|number_format(2) }}</td>
                        <td>{{ details.totalFeedCost|number_format(2) }}</td>
                        <td>{{ details.feedCostPerKgFish|number_format(2) }}</td>
                        <td>{{ details.totalOtherCost|number_format(2) }}</td>
                        <td>{{ details.totalCost|number_format(2) }}</td>
                        <td>{{ details.productionCostPerKgFish|number_format(2) }}</td>
                        <td>{{ details.totalIncome|number_format(2) }}</td>
                        <td>{{ details.netProfitOrLoss|number_format(2) }}</td>
                        <td>{{ details.retuneOverInvestment|number_format(2) }}</td>
                        <td>{{ details.farmerRemarks }}</td>
                        <td>{{ details.employeeRemarks }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

        </div>
    </div>
{% endfor %}

