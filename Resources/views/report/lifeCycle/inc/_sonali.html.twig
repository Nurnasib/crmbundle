<table width="100%" style="border: 0">
    <tbody>
    <tr>
        <td colspan="26" align="center"><h3>NOURISH POULTRY AND HATCHERY LTD</h3></td>
    </tr>
    <tr>
        <td colspan="26" align="center"><h5>UTTARA, DHAKA.</h5></td>
    </tr>
    <tr>
        <td colspan="26" align="center"><h6>{{ lifeCycleSlug|replace({'-': ' '})|upper }}</h6></td>
    </tr>
    </tbody>
</table>
<div class="row">
    <div class="card" style="height: 550px; overflow: scroll">
        <table width="100" class="table table-bordered">
            <thead class="thead-dark">
            <tr>
                <th>Officer's ID: {{ employee ? employee.userId : '' }}</th>
                <th>Officer's Name: {{ employee ? employee.name : '' }}</th>
                <th>Designation: {{ employee and employee.designation ? employee.designation.name : '' }}</th>
                <th>Region: {{ employee and employee.regional ? employee.regional.name : '' }}</th>
            </tr>
            </thead>
        </table>
        {% for month, entity in entities %}
            {% set monthYear = month|split('-') %}
            {#    <h4 class="bg-secondary text-center p-1">{{ monthYear[1]~'-'~monthYear[2] }}</h4>#}
            <table class="table table-striped table-bordered table-hover filter-result" width="100">
                <thead class="thead-dark">
                <tr>
                    <th colspan="26"><h4 class="bg-secondary text-center p-1">{{ monthYear[1]~'-'~monthYear[2] }}</h4>
                    </th>
                </tr>
                <tr>
                    <th scope="col" rowspan="2">Report Status</th>
                    <th scope="col" colspan="2" style="text-align: center">Agent</th>
                    <th scope="col" colspan="3" style="text-align: center">Farmer</th>
                    <th scope="col" rowspan="2">H.Date</th>
                    <th scope="col" rowspan="2">VisitingWeek</th>
                    <th scope="col" rowspan="2">Total Birds</th>
                    <th scope="col" rowspan="2">Age (Day)</th>
                    <th scope="col" colspan="2" style="text-align: center">Mortality</th>
                    <th scope="col" colspan="2" style="text-align: center">Weight (gm)</th>
                    <th scope="col" colspan="3" style="text-align: center">Feed Consumption</th>
                    <th scope="col" colspan="2" style="text-align: center">F.C.R</th>
                    <th scope="col" rowspan="2">Hatchery</th>
                    <th scope="col" rowspan="2">Breed</th>
                    <th scope="col" rowspan="2">Feed</th>
                    <th scope="col" rowspan="2">Feed Type</th>
                    <th scope="col" rowspan="2">Pro. Date</th>
                    <th scope="col" rowspan="2">Batch No.</th>
                    <th scope="col" rowspan="2">Remarks</th>
                </tr>

                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Address</th>
                    <th scope="col">Name</th>
                    <th scope="col">Address</th>
                    <th scope="col">Mobile</th>
                    <th scope="col">Pes</th>
                    <th scope="col">%</th>
                    <th scope="col">Standard</th>
                    <th scope="col">Achieved</th>
                    <th scope="col">Total (kg)</th>
                    <th scope="col">Per Bird (gm)</th>
                    <th scope="col">Standard</th>
                    <th scope="col">Without M</th>
                    <th scope="col">With M</th>
                </tr>
                </thead>

                <tbody>
                {% for lifeCycle in entity %}
                    {% for detail in lifeCycle.details %}
                        <tr>
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.lifeCycleState == 'COMPLETE' ? 'COMPLETE': 'IN PROGRESS' }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.agentName }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.agentAddress }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.customerName }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.customerAddress }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.customerMobile }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.hatchingDate|date('d-m-Y') }}</td>
                            {% endif %}
                            <td>{{ detail.visitingWeek|week|default('N/A') }}</td>
                            <td>{{ detail.totalBirds|default(0) }}</td>
                            <td>{{ detail.ageDays|default(0) }}</td>
                            <td>{{ detail.mortalityPes|number_format(2)|default(0) }}</td>
                            <td>{{ detail.mortalityPercent|number_format(2)|default(0) }}</td>
                            <td>{{ detail.weightStandard|number_format(2)|default(0) }}</td>
                            <td>{{ detail.weightAchieved|number_format(2)|default(0) }}</td>
                            <td>{{ detail.feedTotalKg|number_format(2)|default(0) }}</td>
                            <td>{{ detail.perBird|number_format(2)|default(0) }}</td>
                            <td>{{ detail.feedStandard|number_format(2)|default(0) }}</td>
                            <td>{{ detail.withoutMortality|number_format(2)|default(0) }}</td>
                            <td>{{ detail.withMortality|number_format(2)|default(0) }}</td>
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.hatcheryName }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.breedName }}</td>
                            {% endif %}
                            {% if loop.first %}
                                <td valign="middle"
                                    rowspan="{{ lifeCycle.details|length }}">{{ lifeCycle.parent.feedName }}</td>
                            {% endif %}

                            <td>{{ detail.feedTypeName }}</td>
                            <td>{{ detail.proDate|date('d-m-Y') }}</td>
                            <td>{{ detail.batchNo|default('N/A') }}</td>
                            <td>{{ detail.remarks|default('N/A') }}</td>
                        </tr>
                    {% endfor %}
                {% endfor %}
                </tbody>
            </table>
        {% endfor %}
    </div>
</div>
