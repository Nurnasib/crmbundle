<table class="table table-striped table-bordered table-hover filter-result download-excel" width="100%">
    <thead class="thead-dark">
    <tr>
        <th data-a-h="center" colspan="23" align="center" class="border-0 text-center"><h3>NOURISH POULTRY AND HATCHERY LTD</h3></th>
    </tr>
    <tr>
        <th data-a-h="center" colspan="23" align="center" class="border-0 text-center"><h5>UTTARA, DHAKA.</h5></th>
    </tr>
    <tr>
        <th data-a-h="center" colspan="23" align="center" class="border-0 text-center"><h6>{{ lifeCycleSlug|replace({'-': ' '})|upper }}</h6></th>
    </tr>
    <tr>
        <th class="border-0" colspan="5">Officer's ID: {{ employee ? employee.userId : '' }}</th>
        <th class="border-0" colspan="6">Officer's Name: {{ employee ? employee.name : '' }}</th>
        <th class="border-0" colspan="6">Designation: {{ employee and employee.designation ? employee.designation.name : '' }}</th>
        <th class="border-0" colspan="6">Region: {{ employee and employee.regional ? employee.regional.name : '' }}</th>
    </tr>
    </thead>
    <thead class="thead-dark">
    <tr>
        <th data-a-h="center" scope="col" colspan="3" class="text-center">Farmer</th>
        <th data-a-v="middle" scope="col" rowspan="2">Visiting Date</th>
        <th data-a-v="middle" scope="col" rowspan="2">Age of Cattle(Month)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Previous Body Weight(Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Present Body Weight(Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Body Weight Difference (Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Duration of Bwt Difference (days)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Av. Weight Gain Per Day (Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Av. Weight Gain Per Kg Con. Feed (Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Av. Weight Gain Per Kg DM (Kg)</th>
        <th data-a-h="center" scope="col" colspan="3" style="text-align: center">Con. Feed Intake (Kg)</th>
        <th data-a-h="center" scope="col" colspan="2" style="text-align: center">Fodder (Kg)</th>
        <th data-a-h="center" scope="col" colspan="2" style="text-align: center">DM of Fodder (Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Total DM (Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">DM Requirement by Bwt (Kg)</th>
        <th data-a-v="middle" scope="col" rowspan="2">Name of Ready Feed</th>
        <th data-a-v="middle" scope="col" rowspan="2">Remarks</th>
    </tr>

    <tr>
        <th scope="col">Name</th>
        <th scope="col">Mobile</th>
        <th scope="col">Address</th>
        <th scope="col">Ready Feed</th>
        <th scope="col">Conventional</th>
        <th scope="col">Total</th>
        <th scope="col">Gr. Grass</th>
        <th scope="col">Straw</th>
        <th scope="col">Gr. Grass</th>
        <th scope="col">Straw</th>
    </tr>
    </thead>

    <tbody>
    {% for entity in entities %}
        {% for details in entity.details %}
            {% set bodyWeightDiff = details.presentBodyWeight > details.previousBodyWeight ? (details.presentBodyWeight - details.previousBodyWeight) : 0 %}
            {% set avgWeightGainPerDay = details.durationOfBwtDifference != 0 ? (bodyWeightDiff / details.durationOfBwtDifference) : 0 %}
            {% set avgWeightGainPerKg = details.consumptionFeedIntakeTotal != 0 ? (avgWeightGainPerDay / details.consumptionFeedIntakeTotal) : 0 %}
            {% set avgWeightGainPerKgDm = details.totalDmKg != 0 ? (avgWeightGainPerDay / details.totalDmKg) : 0 %}
            <tr>
                {% if loop.first %}
                    <td data-a-v="middle" valign="middle"
                        rowspan="{{ entity.details|length }}">{{ entity.parent.customerName }}</td>
                {% endif %}
                {% if loop.first %}
                    <td data-a-v="middle" valign="middle"
                        rowspan="{{ entity.details|length }}">{{ entity.parent.customerMobile }}</td>
                {% endif %}
                {% if loop.first %}
                    <td data-a-v="middle" valign="middle"
                        rowspan="{{ entity.details|length }}">{{ entity.parent.customerAddress }}</td>
                {% endif %}

                <td data-t="s">{{ details.visitingDate ? details.visitingDate|date('d-m-Y') : '' }}</td>
                <td data-t="n">{{ details.ageOfCattleMonth }}</td>
                <td data-t="n">{{ details.previousBodyWeight|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.presentBodyWeight|number_format(2,'.','') }}</td>
                <td data-t="n">{{ bodyWeightDiff|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.durationOfBwtDifference|number_format(2,'.','') }}</td>
                <td data-t="n">{{ avgWeightGainPerDay|number_format(2,'.','') }}</td>
                <td data-t="n">{{ avgWeightGainPerKg|number_format(2,'.','') }}</td>
                <td data-t="n">{{ avgWeightGainPerKgDm|number_format(2,'.','') }}</td>


                <td data-t="n">{{ details.consumptionFeedIntakeReadyFeed|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.consumptionFeedIntakeConventional|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.consumptionFeedIntakeTotal|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.fodderGreenGrassKg|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.fodderStrawKg|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.dmOfFodderGreenGrassKg|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.dmOfFodderStrawKg|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.totalDmKg|number_format(2,'.','') }}</td>
                <td data-t="n">{{ details.dmRequirementByBwtKg|number_format(2,'.','') }}</td>
                <td>{{ details.feedName }}</td>
                <td>{{ details.remarks }}</td>
            </tr>
        {% endfor %}
    {% endfor %}
    </tbody>
</table>
