{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="javascript:void(0)">  {{ 'Farmers'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Farmers'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
{#                            <a href="{{ path('crm_customer_new') }}" class="btn btn-sm  green-bg white-font"><i class="feather icon-user-plus"></i>{{ 'Add New'|trans }}</a>#}
                            {#<a href="{{ path('kpi_setup') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'KPI Setup'|trans }}</a>#}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-block">
                    <div id="presidents">Loading...</div>
                    {#<table class="table table-striped table-bordered table-hover" id="datatable">
                        <thead class="thead-dark">
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Mobile</th>
                            <th scope="col">Address</th>
                            <th scope="col">Agent</th>
                            <th scope="col">Location</th>
                            <th scope="col">Farmer Type</th>

                            <th scope="col" class="text-center" width="150"><i class="feather icon-settings"></i></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entity in entities %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ entity.name }}</td>
                                <td>{{ entity.mobile }}</td>
                                <td>{{ entity.address }}</td>
                                <td>{{ entity.agentName }}</td>
                                <td>{{ entity.locationName }}</td>
                                <td>{{ entity.farmerTypeName|default('') }}</td>
                                <td>
                                    {% if 'ADMIN' in app.user.roles|join('_') %}
                                        <div class="btn-group">
                                            <a class="btn btn-mini yellow-bg white-font" href="{{ path('crm_customer_edit',{'id':entity.id}) }}"><i class="feather icon-edit"></i> Edit</a>
                                            <a class="btn btn-transparent btn-mini red-font removeWithMessage" href="javascript:" data-action="{{ path('customer_delete',{'id':entity.id}) }}"><i class="fa fa-remove"></i></a>
                                        </div>
                                    {% endif %}
                                </td>

                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>#}
                </div>

            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
{% block cssBlock %}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
    <style>
        div.dataTables_wrapper div.dataTables_info {
            float: left;
            width: auto;
        }
        div.dataTables_wrapper div.dataTables_paginate {
            float: right;
            width: auto;
        }
        div.dataTables_wrapper div.dataTables_filter {
            float: right;
            display: inline-block;
        }
        div.dataTables_wrapper div.dataTables_length {
            float: left;
            display: inline-block;
        }
    </style>
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script src="{{ asset('bundles/datatables/js/datatables.js') }}"></script>
    <script>
        $(function() {
            $('#presidents').initDataTables({{ datatable_settings(datatable) }});
        });
    </script>
{% endblock  %}
{% block documentready %}
    {{ parent() }}
    $('#datatable').DataTable( {
    "pageLength": 25,
    'columnDefs': [ {
    'targets': [0,4],
    'orderable': false
    }]
    });
{% endblock %}
