{% extends 'admin/layout.html.twig' %}

{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('crm_expense') }}">  {{ 'Expense'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Expense'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a style="margin-right: 5px" class="btn btn-primary btn-sm" href='{{ path('crm_expense_new') }}' id='' >{{ 'Add Expense' }}</a>
                            <a href="{{ path('crm_expense') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Expense'|trans }}</a>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="card-block">
                    <table class="table table-striped table-bordered table-hover" id="datatable">
                        <thead class="thead-dark">
                        <tr>
                            <th scope="col">S/N</th>
                            <th scope="col">Employee Name</th>
                            <th scope="col">Expense Date</th>
{#                            <th scope="col">Purpose</th>#}
                            <th scope="col">Conveyance</th>
                            <th scope="col">Daily Allowance</th>
                            <th scope="col">Hotel Rent</th>
                            <th scope="col">Photostate</th>
                            <th scope="col">Mobile</th>
                            <th scope="col">Maintenace</th>
                            <th scope="col">Toll Bill</th>
                            <th scope="col">Service Charge</th>
                            <th scope="col">Others</th>

                            <th scope="col text-center"><i class="feather icon-settings"></i></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for entity in entities %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ entity.employeeName }}</td>
                            <td>{{ entity.expenseMonthYear|date('M Y')}}</td>
                            <td>{{ entity.totalConveyance }}</td>
                            <td>{{ entity.totalDailyAllowance }}</td>
                            <td>{{ entity.totalHotelRent }}</td>
                            <td>{{ entity.totalPhotostate }}</td>
                            <td>{{ entity.totalMobile }}</td>
                            <td>{{ entity.totalMaintenace }}</td>
                            <td>{{ entity.totalTollBill }}</td>
                            <td>{{ entity.totalServiceCharge }}</td>
                            <td>{{ entity.totalOthers }}</td>
                            <td>
                                <a class="btn btn-mini yellow-bg white-font" href="{{ path('crm_expense_details',{'employee':entity.employeeAutoId, 'monthYear':entity.expenseMonthYear}) }}"><i class="feather icon-edit"></i> Edit</a>
                            </td>

                        </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
{% block cssBlock %}
    <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
{% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}

