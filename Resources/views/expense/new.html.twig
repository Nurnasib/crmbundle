{% extends 'admin/layout.html.twig' %}
{#{% block body_id 'kpi_domain_new' %}#}
{% block body %}

    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('crm_expense') }}">  {{ 'Expense'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Add New'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Daily Expense'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('crm_expense_new') }}" class="btn btn-sm  green-bg white-font"><i class="fas fa-plus"></i>{{ 'Add New'|trans }}</a>
                            <a href="{{ path('crm_expense') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Expense'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Daily Expense'|trans }} </div>
                    </div>

                    <div class="portlet-body form expense_form_section" id="expense_form_section">
                        {{ form_start(form, {'attr': {'action': path('crm_expense_edit',{'id':entity.id}), 'id':'expense_form','method':'post','class': 'form-horizontal right','enctype':'multipart/form-data'}}) }}
                        <div class="row form-body expense_form_body">
                            <div class="form-inner-no-space">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            {{ form_label(form.schedule_visit, 'Schedule Visit'|trans, {'label_attr': {'class': 'col-md-2'}}) }}
                                            <div class="col-md-10">
                                                <span class="not-blank"> *</span>

                                                {{ form_widget(form.schedule_visit) }}
                                                {{ form_errors(form.schedule_visit) }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            {{ form_label(form.expenseDate, 'Date'|trans, {'label_attr': {'class': 'col-md-2'}}) }}
                                            <div class="col-md-10">
                                                <span class="not-blank"> *</span>
                                                <div class="date_section">
                                                    {{ form_widget(form.expenseDate) }}
                                                    {{ form_errors(form.expenseDate) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            {{ form_label(form.visitLocation, 'Location'|trans, {'label_attr': {'class': 'col-md-2'}}) }}
                                            <div class="col-md-10">
                                                {{ form_widget(form.visitLocation) }}
                                                {{ form_errors(form.visitLocation) }}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            {{ form_label(form.riding, 'Bike Riding'|trans, {'label_attr': {'class': 'col-md-2'}}) }}
                                            <div class="col-md-10">
                                                {{ form_widget(form.riding) }}
                                                {{ form_errors(form.riding) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            {{ form_label(form.purpose, 'Purpose'|trans, {'label_attr': {'class': 'col-md-1'}}) }}
                                            <div class="col-md-11">
                                                <span class="not-blank"> *</span>

                                                {{ form_widget(form.purpose) }}
                                                {{ form_errors(form.purpose) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            {{ form_label(form.vehicle, 'Vehicle: '|trans, {'label_attr': {'class': 'col-md-1','style': 'margin-top: -10px; text-align:left'}}) }}
                                            <div class="col-md-11">
                                                {{ form_widget(form.vehicle) }}
                                                {{ form_errors(form.vehicle) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Conveyance</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                <div class="card-body card-body-inner">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.conveyance, 'Conveyance '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {#<span class="not-blank"> *</span>#}
                                                    {{ form_widget(form.conveyance) }}
                                                    {{ form_errors(form.conveyance) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.daily_allowance, 'Daily Allowance '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.daily_allowance) }}
                                                    {{ form_errors(form.daily_allowance) }}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.hotel_rent, 'Hotel Rent '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.hotel_rent) }}
                                                    {{ form_errors(form.hotel_rent) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.photostate, 'Photostate '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.photostate) }}
                                                    {{ form_errors(form.photostate) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.courier, 'Courier '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {#<span class="not-blank"> *</span>#}

                                                    {{ form_widget(form.courier) }}
                                                    {{ form_errors(form.courier) }}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.food, 'Food '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.food) }}
                                                    {{ form_errors(form.food) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.mobile, 'Mobile '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.mobile) }}
                                                    {{ form_errors(form.mobile) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.maintenace, 'Maintenace '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.maintenace) }}
                                                    {{ form_errors(form.maintenace) }}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.toll_bill, 'Toll bill '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.toll_bill) }}
                                                    {{ form_errors(form.toll_bill) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.service_charge, 'Service charge '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.service_charge) }}
                                                    {{ form_errors(form.service_charge) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.others, 'Others '|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.others) }}
                                                    {{ form_errors(form.others) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-header grey-bg inner-header">
                                    <h5>Attachments</h5>
                                    <div class="card-header-right">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                                            <button type="button" id="" class="btn btn-sm  blue-bg white-font addFile"><i class="feather icon-plus"></i>Add More</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body card-body-inner">
                                    <div class="col-md-12 clone-block" id="clone-block">
                                        <div class="clone">
                                            <div class="row">
                                                <label class="col-md-2 control-label" for="job_requisition_form_attachFile">File Label</label>
                                                <div class="col-md-4">
                                                    <input type="text" name="labelName[]" id="labelName" class="form-control form-control-sm" placeholder="Enter file description" value="">
                                                    <input type="hidden" name="metaId[]" id="metaId" value="">
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="input-group">
                                                        <div class="custom-file">
                                                            <input type="file" name="files[]" class="custom-file-input" style="z-index: 0;" id="file" aria-describedby="file">
                                                            <label class="custom-file-label" for="file">Choose file</label>
                                                        </div>
                                                        <div class="input-group-append">
                                                            <div class="btn btn-sm btn-transparent red-font row-remove hidden">
                                                                <i class="fa fa-remove"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        {% if attchments is defined and attchments is not empty %}

                                            {% for attchment in attchments %}
                                                <div class="row addedAttachmentItem">
                                                    <label class="col-md-2 control-label" for="job_requisition_form_attachFile_{{ attchment.id }}">File Label</label>
                                                    <div class="col-md-4">
                                                        <p class="form-control">{{ attchment.name }}</p>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="input-group">
                                                            <div class="custom-file">
                                                                {% if attchment.fileName is defined and attchment.filePath is not empty %}
                                                                    <a href="{{ asset(attchment.filePath~attchment.fileName) }}" download>Download</a>
                                                                {% endif %}

                                                            </div>
                                                            <div class="input-group-append">
                                                                <button data-entity-id="{{ attchment.id }}" type="button" class="btn btn-sm btn-transparent red-font existing-row-remove">
                                                                    <i class="fa fa-remove"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% endif %}

                                    </div>
                                    <div class="clearfix"></div>
                                </div>

                                <div class="form-actions">
                                    <div class="col-md-6 ">

                                    </div>
                                    <div class="col-md-6 text-right">
                                        <div class="btn-group" role="group" aria-label="Button group with nested dropdown"><button type="reset" class="btn btn-sm yellow-bg white-font"><i class="fa fa-refresh"></i>Restore</button>
                                            {{ form_widget(form.SaveAndCreate, {type: 'submit',label: 'label.save.continue',value:'label.save.continue', attr: { class: 'btn btn-info form-submit expense_form_button'}}) }}
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div>
                        {{ form_widget(form._token) }}
                        {{ form_end(form) }}
                    </div>
                </div>

                <style>
                    #expense_form_vehicle .checkbox{
                        width: unset;
                        padding-right: 30px;
                    }
                </style>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
     <style type="text/css">
         .hidden{
             display: none!important;
         }
     </style>
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>

    <script type="text/javascript">
        jQuery(document).ready(function () {

            $('.expense_date').datepicker({
                changeMonth: true,
                changeYear: true,
                dateFormat: "dd-mm-yy",
                yearRange: "2020:" + new Date().getFullYear(),
                showOn: "both",
                showButtonPanel: true,
                buttonImage: "/assets/images/icon-calendar-green.png",
                buttonImageOnly: true,
                maxDate: 0,
                autoclose: true,
                orientation: "bottom",
            });

            var count = 0;
            var countId = 1;
            var countIdx = 1;
            $('.addFile').click(function(e){
                var $el = $(this);
                var $cloneBlock = $('#clone-block');
                var $clone = $cloneBlock.find('.clone:eq(0)').clone();
                $clone.find('.custom-file-input').attr('id', "file-"+(countId++));
                $clone.find('.custom-file-label').attr('for', "file-"+(countIdx++));
                $clone.find(':text,textarea,file' ).val("");
                $clone.find('.custom-file-label' ).html("Choose file");
                $clone.attr('id', "added"+(++count));
                $clone.find('.row-remove').removeClass('hidden');
                $cloneBlock.append($clone);
            });

            $('#clone-block').on('click', '.row-remove', function(){
                $(this).closest('.clone').remove();
            });

            $(document).on('click', '.existing-row-remove', function () {
                var element=$(this);
                var entityId=$(element).attr('data-entity-id');
                if(entityId==''){
                    return false;
                }

                $.get(Routing.generate('crm_expense_attachment_delete',{'id':entityId}),{'status':status})
                    .done(function(response){
                        console.log(response)
                        if(response.status==200){
                            $(element).closest('.addedAttachmentItem').remove();
                        }

                    });
            })

        });
    </script>
{% endblock  %}