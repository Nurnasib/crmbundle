{% extends 'admin/layout.html.twig' %}
{% block body %}

    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header hidden-print">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('crm_expense') }}">  {{ 'Expense'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Details'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row hidden-print">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Monthly Expense'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('crm_expense_new') }}" class="btn btn-sm  green-bg white-font"><i class="fas fa-plus"></i>{{ 'Add New'|trans }}</a>
                            <a href="{{ path('crm_expense') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Expense'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Monthly Expense'|trans }} </div>
                        {% if expenseBatch%}
                        <div style="float: right; padding-right: 15px" class="caption hidden-print">
                            <div class="pull-right">
                                <button class="btn btn-info btn-sm" id="windowPrint"><i class="fa fa-print"></i> </button>
                            </div>
                        </div>
                        {% endif %}
                    </div>

                    <div class="portlet-body form expense_form_section expense_body" id="expense_form_section">

                        <div style="text-align: center">
                            <h4>Nourish Poultry & Hatchery Ltd.</h4>
                            <h6>Uttara, Dhaka</h6>
                            <h6>Monthly TA DA Bill</h6>
                            <h6>Month: {{ yearMonth|date('F Y') }}</h6>
                        </div>
                        <div class="">
                            <div class="col-md-6">
                                <h6>Name: {{ employee.name|default('')}}</h6>
                                <h6>Designation: {{employee.designation.name|default('')}}</h6>

                            </div>
                            <div class="col-md-6 text-center">
                                <h6>Employee Id: {{ employee.userId|default('') }}</h6>
                            </div>
                        </div>
                        {% if expenseBatch is null %}
                        <form class="form-horizontal right" method="post" enctype="multipart/form-data" action="{{ path('crm_expense_process',{'employee':employee.id}) }}">
                            <input type="hidden" name="monthYear" value="{{ yearMonth }}">
                            {% endif %}
                        <table class="table table-bordered">
                            <thead>
                            <tr>
                                <th class="hidden-print">SL</th>
                                <th>Date</th>
                                <th class="hidden-print">Schedule</th>
                                <th>Visiting Area</th>
                                <th>Area</th>
                                <th class="hidden-print">Purpose</th>
                                <th class="hidden-print">Vehicle</th>
                                <th class="hidden-print" title="Riding">Bike Meter Reading (KM)</th>
                                {% if expenseParticularAttributes is defined and expenseParticularAttributes is iterable %}
                                    {% for expenseParticularAttribute in expenseParticularAttributes %}
                                        <th scope="col">{{ expenseParticularAttribute.name }}</th>
                                    {% endfor %}
                                {% endif %}
                                <th title="Total">Total (TK.)</th>
                                <th class="hidden-print" scope="col text-center"><i class="feather icon-settings"></i></th>
                            </tr>
                            </thead>
                            {% if entities is defined %}
                            <tbody>
                                {% set totalLineTotal=0 %}
                                {% if entities is defined and entities is not empty %}
                                    {% for entity in entities %}
                                    {% set lineTotal= expensePaticularAmount['inLine'] is defined? expensePaticularAmount['inLine'][entity.employee.id][entity.id]|arraySumColWise('amount'):'0.00' %}
                                    {% set totalLineTotal=totalLineTotal+lineTotal %}
                                        <tr class="expense_id_{{ entity.id }}">
                                            <td class="hidden-print">
                                                {{ loop.index }}

                                            </td>
                                            <td>{{ entity.expenseDate|date('d-m-Y') }}</td>
                                            <td class="hidden-print">{{ entity.scheduleVisit }}</td>
                                            <td>{{ entity.visitLocation|default('') }}</td>
                                            <td>{{ entity.workingArea.name|default('') }}</td>
                                            <td class="hidden-print">
                                                {% if entity.purpose is defined and entity.purpose is not empty %}
                                                    {% for purpose in entity.purpose %}
                                                    {{ purpose.name }}
                                                        {% if loop.last == false  %}{{ '; ' }} {% endif%}
                                                    {% endfor %}
                                                {% endif%}
                                            </td>
                                            <td class="hidden-print">
                                                {% if entity.vehicle is defined and entity.vehicle is not empty %}
                                                    {% for vehicle in entity.vehicle %}
                                                    {{ vehicle.name }}
                                                        {% if loop.last == false  %}{{ '; ' }} {% endif%}
                                                    {% endfor %}
                                                {% endif%}
                                            </td>
                                            <td class="hidden-print">{{ entity.riding|default('') }}</td>
                                            {% if expenseParticularAttributes is defined and expenseParticularAttributes is iterable %}
                                                {% for expenseParticularAttribute in expenseParticularAttributes %}
                                                    <td>
                                                        {% if expensePaticularAmount['inLine'] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][expenseParticularAttribute.id] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][expenseParticularAttribute.id]['path'] is not empty%}
                                                            <a title="Attachment Available" href="{{ asset('uploads/expense/'~expensePaticularAmount['inLine'][entity.employee.id][entity.id][expenseParticularAttribute.id]['path']) }}" download>
                                                                {{ expensePaticularAmount['inLine'] is defined? expensePaticularAmount['inLine'][entity.employee.id][entity.id][expenseParticularAttribute.id]['amount']|number_format(2,'.',','):'0.00' }}
                                                            </a>
                                                        {% else %}
                                                            {{ expensePaticularAmount['inLine'] is defined and expensePaticularAmount['inLine'][entity.employee.id][entity.id][expenseParticularAttribute.id] is defined ? expensePaticularAmount['inLine'][entity.employee.id][entity.id][expenseParticularAttribute.id]['amount']|number_format(2,'.',','):'' }}
                                                        {% endif %}
                                                    </td>
                                                {% endfor %}
                                            {% endif %}
                                            <td class="text-right">{{ lineTotal|number_format(2,'.',',') }}</td>
                                            <td class="hidden-print">
                                                {% if entity.status==1 %}
                                                    <input type="hidden" name="expense[{{ entity.id }}]" value="{{ entity.id }}">
                                                <div class="btn-group">
                                                <a style="margin-right: 2px" class="btn btn-primary btn-mini white-font" href="{{ path('crm_expense_edit',{'id':entity.id}) }}"><i class="fa fa-edit"></i></a>
                                                <a class="btn btn-danger btn-mini white-font removeReload" href="javascript:" data-action="{{ path('crm_expense_delete',{'id':entity.id}) }}"><i class="fa fa-remove"></i></a>
                                                </div>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            </tbody>
                                <tfoot>
                                <tr class="text-right">
                                    <th class="text-right hidden show-print" colspan="3">Total</th>
                                    <th class="text-right hidden-print" colspan="8">Total</th>
                                    {% if expenseParticularAttributes is defined and expenseParticularAttributes is iterable %}
                                        {% for expenseParticularAttribute in expenseParticularAttributes %}
                                            <td class="text-right">{{ expensePaticularAmount['grandTolalPerColumn'] is defined?expensePaticularAmount['grandTolalPerColumn'][expenseParticularAttribute.id]|arraySumColWise('amount')|number_format(2,'.',','):'0.00' }}</td>
                                        {% endfor %}
                                    {% endif %}
                                    <th class="text-right">{{ totalLineTotal|number_format(2,'.',',') }}</th>
                                    <th class="hidden-print"></th>

                                </tr>

                                {% if monthlyExpenseParticularAttributes is defined and monthlyExpenseParticularAttributes is not empty %}
                                    {% for monthlyExpenseParticularAttribute in monthlyExpenseParticularAttributes %}
                                        <tr>
                                            <th class="text-right hidden show-print" colspan="{{ expenseParticularAttributes|length +3 }}">{{ monthlyExpenseParticularAttribute.name }}</th>
                                            <th colspan="{{ expenseParticularAttributes|length + 8 }}" class="text-right hidden-print">{{ monthlyExpenseParticularAttribute.name }}</th>
                                            <td class="text-right">
                                                {% if monthlyExpensePaticularAmount['inLine'] is defined and monthlyExpensePaticularAmount['inLine'][employee.id][monthlyExpenseParticularAttribute.id]['path'] is not empty%}
                                                    <a title="Attachment Available" href="{{ asset('uploads/expense/'~monthlyExpensePaticularAmount['inLine'][employee.id][monthlyExpenseParticularAttribute.id]['path']) }}" download>
                                                        {{ monthlyExpensePaticularAmount['inLine'] is defined and  monthlyExpensePaticularAmount['inLine'][employee.id][monthlyExpenseParticularAttribute.id] is defined? monthlyExpensePaticularAmount['inLine'][employee.id][monthlyExpenseParticularAttribute.id]['amount']|number_format(2,'.',','):'0.00' }}
                                                    </a>
                                                {% else %}
                                                    {{ monthlyExpensePaticularAmount['inLine'] is defined and  monthlyExpensePaticularAmount['inLine'][employee.id][monthlyExpenseParticularAttribute.id] is defined? monthlyExpensePaticularAmount['inLine'][employee.id][monthlyExpenseParticularAttribute.id]['amount']|number_format(2,'.',','):'0.00' }}
                                                {% endif %}

                                            </td>
                                            <td class="hidden-print"></td>
                                        </tr>
                                    {% endfor %}

                                {% endif %}

                                {% set milesAmount=0 %}
                                {% if expenseBatch %}
                                    {% set milesAmount=milesAmount+expenseBatch.totalMilesAmount %}
                                <tr>
                                    <th class="text-right hidden show-print" colspan="{{ expenseParticularAttributes|length +3 }}">Bike Miles Amount (Total reading {{ expenseBatch.totalRiding }} KM, Per KM = {{ expenseBatch.perMilesAmount }} Tk.) </th>
                                    <th colspan="{{ expenseParticularAttributes|length + 8 }}" class="text-right hidden-print">Bike Miles Amount (Total reading {{ expenseBatch.totalRiding }} KM, Per KM = {{ expenseBatch.perMilesAmount }} Tk.) </th>
                                    <th class="text-right">{{ expenseBatch.totalMilesAmount|number_format(2,'.',',') }}</th>
                                    <td class="hidden-print"></td>
                                </tr>
                                {% endif %}

                                {% set monthlyExpensePaticularTotalAmount= monthlyExpensePaticularAmount['grandTolalPerColumn'] is defined and  monthlyExpensePaticularAmount['grandTolalPerColumn'] is not empty? monthlyExpensePaticularAmount['grandTolalPerColumn']|arraySumColWise('amount')|number_format(2,'.',''):'0.00'  %}
                                <tr>
                                    <th class="text-right hidden show-print" colspan="{{ expenseParticularAttributes|length +3 }}">Grand Total</th>
                                    <th colspan="{{ expenseParticularAttributes|length + 8 }}" class="text-right hidden-print">Grand Total</th>
                                    <th class="text-right">{{ (totalLineTotal+monthlyExpensePaticularTotalAmount+milesAmount)|number_format(2,'.',',') }}</th>
                                    <td class="hidden-print"></td>
                                </tr>

                                </tfoot>
                            {% endif %}

                        </table>
                            {% if expenseBatch is null %}
                            <div class="card-body card-body-inner hidden-print">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label class="col-md-3 control-label" for="meterReading">Meter Reading</label>
                                            <div class="col-md-3">
                                                <span style="text-align: left"> {{ 'From'|trans }}</span>
                                                <p class="form-control">
                                                    {% set startRiding=0 %}
                                                    {% set endRiding=0 %}
                                                    {% if entities is defined and entities|length>0 %}
                                                        {% set startRiding=entities[0].riding %}
                                                        {{ entities[0].riding }}
                                                    {% endif %}
                                                </p>
                                            </div>
                                            <div class="col-md-3">
                                                <span style="text-align: left;"> {{ 'To'|trans }}</span>
                                                <p class="form-control">
                                                    {% if entities is defined and entities|length>1 %}
                                                        {% set endRiding=entities[entities|length-1].riding %}
                                                        {{entities[entities|length-1].riding}}
                                                    {% endif%}
                                                </p>
                                            </div>
                                            <div class="col-md-3">
                                                <span style="text-align: left;"> {{ 'Total'|trans }}</span>
                                                <p class="form-control">
                                                    {% set reading = endRiding-startRiding %}
                                                    {{ reading>0?reading:0 }}
                                                    <input type="hidden" name="totalRiding" value="{{ reading>0?reading:0 }}">
                                                </p>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    {% if monthlyExpenseParticularAttributes is defined and monthlyExpenseParticularAttributes is not empty %}
                                        {% set arrayLength= monthlyExpenseParticularAttributes|length %}
                                        {% set arrayLengthHalf= arrayLength/2 %}
                                        {% set arraySplits = monthlyExpenseParticularAttributes|batch(arrayLengthHalf|number_format(0), '') %}

                                        {% if arraySplits|length>0 %}

                                            {% for arraySplit in arraySplits %}
                                                <div class="col-md-6">
                                                    <table class="table table-bordered">
                                                        <thead>
                                                        <tr>
                                                            <th width="20%">Particular Name</th>
                                                            <th width="20%">Amount (TK)</th>
                                                            <th>Attachment (pdf/image)</th>
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        {% for monthlyExpenseParticular in arraySplit %}
                                                            {% if monthlyExpenseParticular is iterable %}
                                                                <tr>
                                                                    <td>
                                                                        {{ monthlyExpenseParticular.name }}
                                                                        <input type="hidden" name="particular_id[{{ monthlyExpenseParticular.id }}]" value="{{ monthlyExpenseParticular.id }}">
                                                                    </td>
                                                                    <td>
                                                                        <input class="form-control" type="number" min="0" step=".01" name="amount[{{ monthlyExpenseParticular.id }}]">
                                                                    </td>
                                                                    <td style="vertical-align: middle">
                                                                        <div style="height: 30px" class="custom-file">
                                                                            <input type="file" name="files[{{ monthlyExpenseParticular.id }}]" class="custom-file-input" style="z-index: 0; height: 30px" id="file_{{ monthlyExpenseParticular.id }}" aria-describedby="file">
                                                                            <label style="margin-bottom: 0px; height: 30px" class="custom-file-label" for="file_{{ monthlyExpenseParticular.id }}">Choose file</label>
                                                                        </div>
                                                                    </td>

                                                                </tr>
                                                            {% endif %}
                                                        {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            {% endfor %}

                                        {% endif %}

                                    {% endif %}

                                </div>

                            </div>

                            <div class="hidden-print" style="padding-bottom: 20px">

                                <div class="col-md-12 text-right">
                                    <div class="btn-group" role="group" aria-label="Button group with nested dropdown">

                                        <button type="submit" value="process" class="btn btn-sm btn-primary">Process</button>
                                    </div>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        </form>
                        {% endif %}
                    </div>

                    {% if expenseBatch is not null and expenseBatch.status>1 %}
                        <table width="100%" class="no-bordered" style="margin-bottom: 20px">
                            <tr>
                                <th style="text-align: center; color: #000">{{ expenseBatch.employee.name|default('') }}</th>
                                <th style="text-align: center; color: #000">{{ expenseBatch.approvedBy.name|default('') }}</th>
                                <th style="text-align: center; color: #000"></th>
                                <th style="text-align: center; color: #000"></th>
                                <th style="text-align: center; color: #000"></th>
                                <th style="text-align: center; color: #000"></th>
                            </tr>
                            <tr>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Submited by</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Supervisor/ Authorized Official</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Sr. Manager</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">DGM (S&S)</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">Sr. DGM (S&M)</span></th>
                                <th style="text-align: center; color: #000"><span style="border-top: 1px solid #000">GM (S&M)</span></th>
                            </tr>
                        </table>
                    {% endif %}
                </div>

                <style>
                    #expense_form_vehicle .checkbox{
                        width: unset;
                        padding-right: 30px;
                    }
                </style>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
     <style>
         @media print {
             .hidden-print {
                 display: none!important;
             }
             .show-print {
                 display: table-cell!important;
             }

             .expense_body{
                 min-height: 1250px!important;
             }
         }
     </style>
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
    <script>
        $('#windowPrint').on('click', function () {
            window.print();
        })
    </script>
{% endblock  %}