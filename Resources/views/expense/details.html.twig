{% extends 'admin/layout.html.twig' %}
{% block body %}

    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"> <a href="{{ path('crm_expense') }}">  {{ 'Expense'|trans }}</a></li>
                        <li class="breadcrumb-item"> <a href="javascript:">{{ 'Details'|trans }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Expense'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('crm_expense_new') }}" class="btn btn-sm  green-bg white-font"><i class="fas fa-plus"></i>{{ 'Add New'|trans }}</a>
                            <a href="{{ path('crm_expense') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Expense'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Expense'|trans }} </div>
                    </div>

                    <div class="portlet-body form expense_form_section" id="expense_form_section">
                        <table class="table">
                            <thead>
                            <tr>
                                <th>SL</th>
                                <th>Date</th>
                                <th>Schedule</th>
                                <th>Purpose</th>
                                <th>Vehicle</th>
                                <th title="Conveyance">Conv.</th>
                                <th title="Daily Allowance">Daily Allow.</th>
                                <th title=Mobile">Mobile</th>
                                <th title="Hotel Rent">Hotel Rent</th>
                                <th title="Photo Copy">Photo Copy</th>
                                <th title="Courier">Courier</th>
                                <th title="Food">Food</th>
                                <th title="Maintenace">maintenace</th>
                                <th title="Toll Bill">Toll Bill</th>
                                <th title="Service Charge">Service Charge</th>
                                <th title="Others">Others</th>
                                <th scope="col text-center"><i class="feather icon-settings"></i></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% if entities is defined %}
                                {% for entity in entities %}
                                <tr>
                                    <td>{{ loop.index }}</td>
                                    <td>{{ entity.expenseDate|date('d-m-Y') }}</td>
                                    <td>{{ entity.scheduleVisit }}</td>
                                    <td>
                                        {% if entity.purpose is defined and entity.purpose is not empty %}
                                            {% for purpose in entity.purpose %}
                                            {{ purpose.name }}
                                                {% if loop.last == false  %}{{ '; ' }} {% endif%}
                                            {% endfor %}
                                        {% endif%}
                                    </td>
                                    <td>
                                        {% if entity.vehicle is defined and entity.vehicle is not empty %}
                                            {% for vehicle in entity.vehicle %}
                                            {{ vehicle.name }}
                                                {% if loop.last == false  %}{{ '; ' }} {% endif%}
                                            {% endfor %}
                                        {% endif%}
                                    </td>
                                    <td>{{ entity.conveyance|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.dailyAllowance|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.mobile|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.hotelRent|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.photostate|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.courier|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.food|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.maintenace|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.tollBill|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.serviceCharge|number_format(2,'.',',') }}</td>
                                    <td>{{ entity.others|number_format(2,'.',',') }}</td>
                                    <td>
                                        <a class="btn  btn-transparent btn-mini red-font remove" href="javascript:" data-action="{{ path('crm_expense_delete',{'id':entity.id}) }}"><i class="fa fa-remove"></i></a>
                                    </td>
                                </tr>
                                {% endfor %}
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <style>
                    #expense_form_vehicle .checkbox{
                        width: unset;
                        padding-right: 30px;
                    }
                </style>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}