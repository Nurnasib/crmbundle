{% macro dayColumns(filterBy, fixedColumns) %}
    {% set total = fixedColumns %}

    {% if filterBy.startDate is defined and filterBy.endDate is defined %}
        {% set total = total + ((filterBy.endDate|date('j')) - (filterBy.startDate|date('j')) + 1) %}
    {% endif %}

    {{ total }}
{% endmacro %}

{% macro monthColumns(filterBy, fixedColumns) %}
    {% set total = fixedColumns %}

    {% if filterBy.start_month is defined and filterBy.end_month is defined %}
        {% set total = total + (filterBy.end_month - filterBy.start_month + 1) %}
    {% endif %}

    {{ total }}
{% endmacro %}