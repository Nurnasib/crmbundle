{% extends 'admin/layout.html.twig' %}
{#{% block body_id 'kpi_domain_new' %}#}
{% block body %}
    <div class="pcoded-inner-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/"><i class="feather icon-home"></i></a></li>
                        <li class="breadcrumb-item"><a href="{{ path('layer_performance') }}">  {{ 'Layer Performance'|trans }}</a></li>
                        {#<li class="breadcrumb-item"> <a href="javascript:">{{ 'Add New'|trans }}</a></li>#}
                    </ul>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="card">
                <div class="card-header">
                    <h5>{{ 'Layer Performance'|trans }}</h5>
                    <div class="card-header-right">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Button group with nested dropdown">
                            <a href="{{ path('layer_performance_new') }}" class="btn btn-sm  green-bg white-font"><i class="fas fa-plus"></i>{{ 'Add New'|trans }}</a>
                            <a href="{{ path('layer_performance') }}" class="btn btn-sm gray-bg white-font"><i class="fa fa-th-list"></i>{{ 'Layer Performance'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card">
                <div class="portlet box green ">
                    <div class="portlet-title">
                        <div class="caption">{{ 'Agent & Farmer'|trans }} </div>
                    </div>
                    <div class="portlet-body form">
                        {{ form_start(form, {'attr': {'class': 'form-horizontal right'}}) }}
                        <div class="row form-body">
                            <div class="form-inner-no-space">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            {{ form_label(form.customer, 'Customer Mobile'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                            <div class="col-md-8">
                                                <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                {{ form_widget(form.customer) }}
                                                {{ form_errors(form.customer) }}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            {{ form_label(form.agent, 'Agent'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                            <div class="col-md-8">
                                                <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                {{ form_widget(form.agent) }}
                                                {{ form_errors(form.agent) }}
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Bird & Age(week)</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                <div class="card-body card-body-inner">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.total_birds, 'Total Birds'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                    {{ form_widget(form.total_birds) }}
                                                    {{ form_errors(form.total_birds) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.age_wk, 'Age(Week)'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>

                                                    {{ form_widget(form.age_wk) }}
                                                    {{ form_errors(form.age_wk) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>



                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Bird Weight (gm)</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                <div class="card-body card-body-inner">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.bird_weight_target, 'Bird Weight Target'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                    {{ form_widget(form.bird_weight_target) }}
                                                    {{ form_errors(form.bird_weight_target) }}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.bird_weight_achieved, 'Bird Weight Achieved'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                    {{ form_widget(form.bird_weight_achieved) }}
                                                    {{ form_errors(form.bird_weight_achieved) }}
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>


                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Feed Intake(gm)</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                <div class="card-body card-body-inner">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.feed_intake_per_bird, 'Feed Intake Per Bird'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                    {{ form_widget(form.feed_intake_per_bird) }}
                                                    {{ form_errors(form.feed_intake_per_bird) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.feed_Target, 'Feed Target'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                    {{ form_widget(form.feed_Target) }}
                                                    {{ form_errors(form.feed_Target) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>



                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Egg Production(%)</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                 <div class="card-body card-body-inner">
                                     <div class="row">
                                         <div class="col-md-6">
                                             <div class="form-group">
                                                 {{ form_label(form.egg_production_target, 'Egg Production Target'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                 <div class="col-md-8">
                                                     <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                     {{ form_widget(form.egg_production_target) }}
                                                     {{ form_errors(form.egg_production_target) }}
                                                 </div>
                                             </div>
                                         </div>
                                         <div class="col-md-6">
                                             <div class="form-group">
                                                 {{ form_label(form.egg_production_achieved, 'Egg Production Achieved'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                 <div class="col-md-8">
                                                     <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                     {{ form_widget(form.egg_production_achieved) }}
                                                     {{ form_errors(form.egg_production_achieved) }}
                                                 </div>
                                             </div>
                                         </div>
                                     </div>
                                 </div>



                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Egg Weight(gm)</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                <div class="card-body card-body-inner">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.egg_weight_stand, 'Egg Weight Standard'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                    {{ form_widget(form.egg_weight_stand) }}
                                                    {{ form_errors(form.egg_weight_stand) }}
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-md-6">
                                            <div class="form-group">
                                                {{ form_label(form.egg_weight_achieved, 'Egg Weight Achieved'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    <span class="not-blank"> {{ 'Required'|trans }}</span>
                                                    {{ form_widget(form.egg_weight_achieved) }}
                                                    {{ form_errors(form.egg_weight_achieved) }}
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </div>



                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Feed Information</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                <div class="card-body card-body-inner">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.feed_type, 'Feed Type'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.feed_type) }}
                                                    {{ form_errors(form.feed_type) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.production_date, 'Production Date'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.production_date) }}
                                                    {{ form_errors(form.production_date) }}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.batch_no, 'Batch No'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.batch_no) }}
                                                    {{ form_errors(form.batch_no) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                {{ form_label(form.feed_mill, 'Feed Mill'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                <div class="col-md-8">
                                                    {{ form_widget(form.feed_mill) }}
                                                    {{ form_errors(form.feed_mill) }}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>


                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Others Information</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                 <div class="card-body card-body-inner">
                                     <div class="row">
                                         <div class="col-md-4">
                                             <div class="form-group">
                                                 {{ form_label(form.hatchery, 'Hatchery'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                 <div class="col-md-8">
                                                     {{ form_widget(form.hatchery) }}
                                                     {{ form_errors(form.hatchery) }}
                                                 </div>
                                             </div>
                                         </div>
                                         <div class="col-md-4">
                                             <div class="form-group">
                                                 {{ form_label(form.breed, 'Breed'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                 <div class="col-md-8">
                                                     {{ form_widget(form.breed) }}
                                                     {{ form_errors(form.breed) }}
                                                 </div>
                                             </div>
                                         </div>
                                         <div class="col-md-4">
                                             <div class="form-group">
                                                 {{ form_label(form.color, 'Color'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                 <div class="col-md-8">
                                                     {{ form_widget(form.color) }}
                                                     {{ form_errors(form.color) }}
                                                 </div>
                                             </div>
                                         </div>
                                     </div>
                                 </div>




                                <div class="clearfix"></div>
                                <div class="card-header grey-bg inner-header">
                                    <h5>Disease & Remarks</h5>
                                    <div class="card-header-right">
                                    </div>
                                </div>
                                 <div class="card-body card-body-inner">
                                     <div class="row">
                                         <div class="col-md-4">
                                             <div class="form-group">
                                                 {{ form_label(form.disease, 'Disease'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                 <div class="col-md-8">
                                                     {{ form_widget(form.disease) }}
                                                     {{ form_errors(form.disease) }}
                                                 </div>
                                             </div>
                                         </div>
                                         <div class="col-md-8">
                                             <div class="form-group">
                                                 {{ form_label(form.remarks, 'Remarks'|trans, {'label_attr': {'class': 'col-md-4'}}) }}
                                                 <div class="col-md-8">
                                                     {{ form_widget(form.remarks) }}
                                                     {{ form_errors(form.remarks) }}
                                                 </div>
                                             </div>
                                         </div>
                                     </div>
                                 </div>



                                <div class="form-actions">
                                    <div class="col-md-6 ">

                                    </div>
                                    <div class="col-md-6 text-right">
                                        <div class="btn-group" role="group" aria-label="Button group with nested dropdown"><button type="reset" class="btn btn-sm yellow-bg white-font"><i class="fa fa-refresh"></i>Restore</button>
                                            {{ form_widget(form.SaveAndCreate, {label: 'label.save.continue',value:'label.save.continue', attr: { class: 'btn btn-info form-submit'}}) }}
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </div>
                        {{ form_widget(form._token) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
{% endblock %}
 {% block cssBlock %}
     <link rel="stylesheet" href="{{ asset('assets/module/css/app.css') }}">
 {% endblock  %}
{% block javascripts %}
    {{ parent() }}
    <script type="application/javascript" src="{{ asset('assets/module/js/app.js') }}"></script>
{% endblock  %}